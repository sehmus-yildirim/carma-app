rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasBlockedAccountDeletion(userId) {
      let deletionPath = /databases/(default)/documents/account_deletions/$(userId);
      return firestore.exists(deletionPath)
        && firestore.get(deletionPath).data.status in [
          'requested',
          'processing',
          'completed'
        ];
    }

    function isSignedIn() {
      return request.auth != null
        && !hasBlockedAccountDeletion(request.auth.uid);
    }

    function hasValidUploadReservation(userId, storagePath) {
      let reservationId = request.resource.metadata
        .get('uploadReservationId', '');
      let reservationPath = /databases/(default)/documents/_media_upload_reservations/$(reservationId);
      return reservationId is string
        && reservationId.matches('^[0-9a-f-]{36}$')
        && firestore.exists(reservationPath)
        && firestore.get(reservationPath).data.userId == userId
        && firestore.get(reservationPath).data.storagePath == storagePath
        && firestore.get(reservationPath).data.contentType
          == request.resource.contentType
        && firestore.get(reservationPath).data.maxBytes == request.resource.size
        && firestore.get(reservationPath).data.status == 'reserved'
        && firestore.get(reservationPath).data.expiresAt > request.time;
    }

    function canDeleteReservedUpload() {
      let reservationId = resource.metadata.get('uploadReservationId', '');
      let reservationPath = /databases/(default)/documents/_media_upload_reservations/$(reservationId);
      return !(reservationId is string)
        || !reservationId.matches('^[0-9a-f-]{36}$')
        || !firestore.exists(reservationPath)
        || firestore.get(reservationPath).data.status == 'consumed';
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/chats/$(chatId)
        )
        && firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants is list
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    function isUndeletedChatParticipant(chatId) {
      return isChatParticipant(chatId)
        && firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.get('deletedBy', {})[request.auth.uid] != true;
    }

    function isOpenChat(chatId) {
      return isUndeletedChatParticipant(chatId)
        && firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.status in ['active', 'archived'];
    }

    function canSendChatAttachment(chatId) {
      let chat = firestore.get(
        /databases/(default)/documents/chats/$(chatId)
      ).data;
      let requestId = chat.get('requestId', '');

      return !(
          requestId is string
          && requestId.size() > 0
        )
        || (
          firestore.exists(
            /databases/(default)/documents/contact_requests/$(requestId)
          )
          && firestore.get(
            /databases/(default)/documents/contact_requests/$(requestId)
          ).data.status == 'accepted'
        );
    }

    function storyDocument(userId) {
      return firestore.get(
        /databases/(default)/documents/chat_stories/$(userId)
      ).data;
    }

    function storyExists(userId) {
      return firestore.exists(
        /databases/(default)/documents/chat_stories/$(userId)
      );
    }

    function storyMediaPath(userId, fileName) {
      return 'chat_stories/' + userId + '/' + fileName;
    }

    function isCurrentStoryMedia(userId, fileName) {
      return storyDocument(userId).imagePath == storyMediaPath(userId, fileName)
        || storyDocument(userId).videoPath == storyMediaPath(userId, fileName);
    }

    function canReadStoryMedia(userId, fileName) {
      return isSignedIn()
        && storyExists(userId)
        && isCurrentStoryMedia(userId, fileName)
        && (
          request.auth.uid == userId
          || (
            request.auth.uid in storyDocument(userId).viewerUserIds
            && storyDocument(userId).isActive == true
            && storyDocument(userId).expiresAt > request.time
          )
        );
    }

    function storyDocumentById(storyId) {
      return firestore.get(
        /databases/(default)/documents/chat_stories/$(storyId)
      ).data;
    }

    function storyExistsById(storyId) {
      return firestore.exists(
        /databases/(default)/documents/chat_stories/$(storyId)
      );
    }

    function storyMediaPathById(userId, storyId, fileName) {
      return 'chat_stories/' + userId + '/' + storyId + '/' + fileName;
    }

    function canReadStoryMediaById(userId, storyId, fileName) {
      return isSignedIn()
        && storyExistsById(storyId)
        && storyDocumentById(storyId).ownerUserId == userId
        && (
          storyDocumentById(storyId).imagePath
            == storyMediaPathById(userId, storyId, fileName)
          || storyDocumentById(storyId).videoPath
            == storyMediaPathById(userId, storyId, fileName)
        )
        && (
          request.auth.uid == userId
          || (
            request.auth.uid in storyDocumentById(storyId).viewerUserIds
            && storyDocumentById(storyId).isActive == true
            && storyDocumentById(storyId).expiresAt > request.time
          )
        );
    }

    function canReadPublicProfilePost(userId, postId, fileName) {
      let postPath = /databases/(default)/documents/users/$(userId)/social_posts/$(postId);
      return isSignedIn()
        && hasActiveProfileConnection(userId)
        && firestore.exists(
          /databases/(default)/documents/public_profiles/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/public_profiles/$(userId)
        ).data.profileAccessEnabled == true
        && firestore.exists(postPath)
        && firestore.get(postPath).data.visibility in ['public', 'contacts']
        && firestore.get(postPath).data.isDeleted == false
        && firestore.get(postPath).data.get('isArchived', false) == false
        && (
          firestore.get(postPath).data.imagePath
            == 'profile_posts/' + userId + '/' + postId + '/' + fileName
          || 'profile_posts/' + userId + '/' + postId + '/' + fileName
            in firestore.get(postPath).data.get('mediaPaths', [])
        );
    }

    function hasActiveProfileConnectionById(connectionId, targetUserId) {
      let connectionPath = /databases/(default)/documents/profile_connections/$(connectionId);
      return firestore.exists(connectionPath)
        && firestore.get(connectionPath).data.status == 'active'
        && firestore.get(connectionPath).data.participants.size() == 2
        && firestore.get(connectionPath).data.participants.hasAll([
          request.auth.uid,
          targetUserId,
        ])
        && firestore.exists(
          /databases/(default)/documents/chats/$(firestore.get(connectionPath).data.chatId)
        )
        && firestore.get(
          /databases/(default)/documents/chats/$(firestore.get(connectionPath).data.chatId)
        ).data.status in ['active', 'archived']
        && firestore.get(
          /databases/(default)/documents/chats/$(firestore.get(connectionPath).data.chatId)
        ).data.get('deletedBy', {}).get(request.auth.uid, false) != true
        && firestore.get(
          /databases/(default)/documents/chats/$(firestore.get(connectionPath).data.chatId)
        ).data.get('deletedBy', {}).get(targetUserId, false) != true;
    }

    function hasActiveProfileConnection(targetUserId) {
      return isSignedIn()
        && (
          request.auth.uid == targetUserId
          || hasActiveProfileConnectionById(
            request.auth.uid + '_' + targetUserId,
            targetUserId
          )
          || hasActiveProfileConnectionById(
            targetUserId + '_' + request.auth.uid,
            targetUserId
          )
        );
    }

    function canReadVehicleGalleryImage(userId, vehicleId, fileName) {
      let mediaPath = /databases/(default)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)/gallery/$(fileName);
      return isSignedIn()
        && hasActiveProfileConnection(userId)
        && firestore.exists(
          /databases/(default)/documents/public_profiles/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/public_profiles/$(userId)
        ).data.profileAccessEnabled == true
        && firestore.exists(mediaPath)
        && firestore.get(mediaPath).data.visibility == 'contacts'
        && firestore.get(mediaPath).data.isDeleted == false
        && firestore.get(mediaPath).data.mediaPath
          == 'vehicle_gallery/' + userId + '/' + vehicleId + '/' + fileName;
    }

    function canReadVehicleHeroImage(userId, vehicleId, fileName) {
      let vehiclePath = /databases/(default)/documents/public_profiles/$(userId)/vehicles/$(vehicleId);
      return isSignedIn()
        && hasActiveProfileConnection(userId)
        && firestore.exists(
          /databases/(default)/documents/public_profiles/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/public_profiles/$(userId)
        ).data.profileAccessEnabled == true
        && firestore.exists(vehiclePath)
        && firestore.get(vehiclePath).data.heroImageStatus == 'ready'
        && firestore.get(vehiclePath).data.heroImagePath
          == 'vehicle_heroes/' + userId + '/' + vehicleId + '/' + fileName;
    }

    function isValidChatImageUpload(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{1,120}\\.jpg$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    function isValidChatVoiceMemoUpload(fileName) {
      return fileName.matches(
        '^[A-Za-z0-9_-]{1,120}_[^/]{1,140}\\.m4a$'
      )
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'audio/mp4';
    }

    function isValidChatVideoUpload(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{1,120}\\.mp4$')
        && request.resource.size > 0
        && request.resource.size <= 80 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function isValidChatDocumentUpload(fileName) {
      return fileName.matches(
        '^[A-Za-z0-9_-]{1,120}_[^/]{1,159}$'
      )
        && fileName.size() <= 180
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'application/rtf'
        );
    }

    function isValidStoryImageUpload(fileName) {
      return fileName.matches('^[0-9]{12,24}\\.jpg$')
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidStoryVideoUpload(fileName) {
      return fileName.matches('^[0-9]{12,24}\\.mp4$')
        && request.resource.size > 0
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function isValidStoryItemImageUpload(fileName) {
      return fileName == 'media.jpg'
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidStoryItemVideoUpload(fileName) {
      return fileName == 'media.mp4'
        && request.resource.size > 0
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function isValidReportImageUpload(fileName) {
      return fileName == 'evidence.jpg'
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    function isValidProfilePhotoUpload(fileName) {
      return (
          (
            fileName == 'profile.png'
            && request.resource.contentType == 'image/png'
          )
          || (
            fileName == 'profile.jpg'
            && request.resource.contentType == 'image/jpeg'
          )
        )
        && request.resource.size > 0
        && request.resource.size < 8 * 1024 * 1024;
    }

    function isValidProfilePostMediaUpload(fileName) {
      return request.resource.size > 0
        && (
          (
            (
              fileName == 'image.jpg'
              || fileName.matches('^media_[0-9]{1,2}\\.jpg$')
            )
            && request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType == 'image/jpeg'
          )
          || (
            fileName.matches('^media_[0-9]{1,2}\\.mp4$')
            && request.resource.size < 80 * 1024 * 1024
            && request.resource.contentType == 'video/mp4'
          )
        );
    }

    function isValidVehicleGalleryMediaUpload(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{1,160}$')
        && request.resource.size > 0
        && (
          (
            request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType == 'image/jpeg'
          )
          || (
            request.resource.size < 80 * 1024 * 1024
            && request.resource.contentType == 'video/mp4'
          )
        );
    }

    function isValidProfileDocumentUpload(documentType, fileName) {
      return documentType in [
          'identityFront',
          'identityBack',
          'vehicleFront',
          'vehicleBack'
        ]
        && (
          (
            fileName == documentType + '.png'
            && request.resource.contentType == 'image/png'
          )
          || (
            fileName == documentType + '.jpg'
            && request.resource.contentType == 'image/jpeg'
          )
        )
        && request.resource.size > 0
        && request.resource.size < 12 * 1024 * 1024;
    }

    function canMutateProfileVerificationDocument(userId, documentType) {
      let requestPath =
        /databases/(default)/documents/verification_requests/$(userId);
      return !firestore.exists(requestPath)
        || (
          !(firestore.get(requestPath).data.status in ['pending', 'verified'])
          && !(firestore.get(requestPath).data
            .get('documentStatuses', {})
            .get(documentType, 'missing') in ['inReview', 'verified'])
        );
    }

    function reportImagePath(reportId, userId, fileName) {
      return 'report_images/' + reportId + '/' + userId + '/' + fileName;
    }

    function reportNotificationAllowsImageRead(reportId, userId, fileName) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)/report_notifications/$(reportId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)/report_notifications/$(reportId)
        ).data.imagePath == reportImagePath(reportId, userId, fileName);
    }

    function sentReportNotificationAllowsImageRead(reportId, userId, fileName) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)/sent_report_notifications/$(reportId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)/sent_report_notifications/$(reportId)
        ).data.imagePath == reportImagePath(reportId, userId, fileName);
    }

    match /chat_images/{chatId}/{userId}/{fileName} {
      allow read: if isUndeletedChatParticipant(chatId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isOpenChat(chatId)
        && canSendChatAttachment(chatId)
        && hasValidUploadReservation(
          userId,
          'chat_images/' + chatId + '/' + userId + '/' + fileName
        )
        && isValidChatImageUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && isChatParticipant(chatId)
        && canDeleteReservedUpload();
    }

    match /chat_documents/{chatId}/{userId}/{fileName} {
      allow read: if isUndeletedChatParticipant(chatId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isOpenChat(chatId)
        && canSendChatAttachment(chatId)
        && hasValidUploadReservation(
          userId,
          'chat_documents/' + chatId + '/' + userId + '/' + fileName
        )
        && isValidChatDocumentUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && isChatParticipant(chatId)
        && canDeleteReservedUpload();
    }

    match /chat_voice_memos/{chatId}/{userId}/{fileName} {
      allow read: if isUndeletedChatParticipant(chatId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isOpenChat(chatId)
        && canSendChatAttachment(chatId)
        && hasValidUploadReservation(
          userId,
          'chat_voice_memos/' + chatId + '/' + userId + '/' + fileName
        )
        && isValidChatVoiceMemoUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && isChatParticipant(chatId)
        && canDeleteReservedUpload();
    }

    match /chat_videos/{chatId}/{userId}/{fileName} {
      allow read: if isUndeletedChatParticipant(chatId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isOpenChat(chatId)
        && canSendChatAttachment(chatId)
        && hasValidUploadReservation(
          userId,
          'chat_videos/' + chatId + '/' + userId + '/' + fileName
        )
        && isValidChatVideoUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && isChatParticipant(chatId)
        && canDeleteReservedUpload();
    }

    match /chat_stories/{userId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canReadStoryMedia(userId, fileName)
        );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUploadReservation(
          userId,
          'chat_stories/' + userId + '/' + fileName
        )
        && (
          isValidStoryImageUpload(fileName)
          || isValidStoryVideoUpload(fileName)
        );
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canDeleteReservedUpload();
    }

    match /chat_stories/{userId}/{storyId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canReadStoryMediaById(userId, storyId, fileName)
        );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && storyId.matches('^[0-9]{12,24}$')
        && hasValidUploadReservation(
          userId,
          'chat_stories/' + userId + '/' + storyId + '/' + fileName
        )
        && (
          isValidStoryItemImageUpload(fileName)
          || isValidStoryItemVideoUpload(fileName)
        );
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canDeleteReservedUpload();
    }

    match /report_images/{reportId}/{userId}/{fileName} {
      allow read: if reportNotificationAllowsImageRead(reportId, userId, fileName)
        || sentReportNotificationAllowsImageRead(reportId, userId, fileName);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUploadReservation(
          userId,
          'report_images/' + reportId + '/' + userId + '/' + fileName
        )
        && isValidReportImageUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canDeleteReservedUpload();
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || (
            hasActiveProfileConnection(userId)
            && firestore.exists(
              /databases/(default)/documents/public_profiles/$(userId)
            )
            && firestore.get(
              /databases/(default)/documents/public_profiles/$(userId)
            ).data.profileAccessEnabled == true
          )
        );
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isValidProfilePhotoUpload(fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /profile_posts/{userId}/{postId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canReadPublicProfilePost(userId, postId, fileName)
        );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUploadReservation(
          userId,
          'profile_posts/' + userId + '/' + postId + '/' + fileName
        )
        && isValidProfilePostMediaUpload(fileName);
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canDeleteReservedUpload();
    }

    match /vehicle_gallery/{userId}/{vehicleId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canReadVehicleGalleryImage(userId, vehicleId, fileName)
        );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUploadReservation(
          userId,
          'vehicle_gallery/' + userId + '/' + vehicleId + '/' + fileName
        )
        && isValidVehicleGalleryMediaUpload(fileName);
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canDeleteReservedUpload();
    }

    match /vehicle_heroes/{userId}/{vehicleId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || canReadVehicleHeroImage(userId, vehicleId, fileName)
        );
      allow write: if false;
    }

    match /profile_documents/{userId}/{documentType}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || request.auth.token.get('admin', false) == true
        );
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && canMutateProfileVerificationDocument(userId, documentType)
        && isValidProfileDocumentUpload(documentType, fileName);
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && canMutateProfileVerificationDocument(userId, documentType);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
