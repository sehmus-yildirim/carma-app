            && request.resource.data.reactionBy[request.auth.uid].size() > 0
            && isAllowedMessageReaction(
              request.resource.data.reactionBy[request.auth.uid]
            )
          )
        )
        && request.resource.data.reactionUpdatedAtBy is map
        && request.resource.data.reactionUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('reactionBy', request.auth.uid)
        && changedOnlyNestedMapKey('reactionUpdatedAtBy', request.auth.uid);
    }

    function isValidChatReportCreate() {
      let chat = get(/databases/$(database)/documents/chats/$(request.resource.data.chatId));

      return isSignedIn()
        && request.resource.data.type == 'chat'
        && request.resource.data.chatId is string
        && request.resource.data.reporterUserId == request.auth.uid
        && isUndeletedChatParticipant(chat.data)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
