        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 160
        && request.resource.data.fileContentType == 'video/mp4'
        && request.resource.data.fileSizeBytes is int
        && request.resource.data.fileSizeBytes > 0
        && request.resource.data.fileSizeBytes <= 80 * 1024 * 1024
        && request.resource.data.fileDurationMs is int
        && request.resource.data.fileDurationMs > 0
        && request.resource.data.fileDurationMs <= 5 * 60 * 1000
        && request.resource.data.isViewOnce is bool
        && request.resource.data.viewOnceOpenedAtBy is map
        && request.resource.data.viewOnceOpenedAtBy.size() == 0
        && request.resource.data.createdAt is timestamp
