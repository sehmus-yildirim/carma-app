        && isOpenUndeletedChatParticipant(chat.data)
        && (
          canSendRegularChatMessages(chat.data)
          || isPendingInitialContactRequestMessage(chat.data, messageId)
        )
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && hasValidOptionalReplyFields()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.isDeleted == false
        && chatAfter.data.lastMessage == request.resource.data.text
        && chatAfter.data.lastMessageAt == request.resource.data.createdAt
        && chatAfter.data.updatedAt == request.resource.data.updatedAt
