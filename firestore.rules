    function isValidTextMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      let chatAfter = getAfter(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'createdAt',
          'updatedAt',
          'isDeleted',
          'replyToMessageId',
          'replyToText',
        ])
        && isOpenUndeletedChatParticipant(chat.data)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && hasValidOptionalReplyFields()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.isDeleted == false
        && chatAfter.data.lastMessage == request.resource.data.text
        && chatAfter.data.lastMessageAt == request.resource.data.createdAt
        && chatAfter.data.updatedAt == request.resource.data.updatedAt
        && chatAfter.data.lastReadAtBy[request.auth.uid]
          == request.resource.data.createdAt
        && chatAfter.data.manualUnreadBy[request.auth.uid] == false;
    }

    function isValidLocationMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
