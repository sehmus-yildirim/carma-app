rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function changedOnlyNestedMapKey(field, key) {
      return request.resource.data
        .get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys()
        .hasOnly([key]);
    }

    function isOpenChatStatus(status) {
      return status == 'active' || status == 'archived';
    }

    function isValidInitialSearchCredit(userId, creditId) {
      return isOwner(userId)
        && creditId == 'main'
        && request.resource.data.userId == userId
        && request.resource.data.used == 0
        && request.resource.data.limit == 2
        && request.resource.data.remaining == 2
        && request.resource.data.paidCredits == 0
        && request.resource.data.totalAvailableRequests == 2
        && request.resource.data.resetPeriod == 'monthly'
        && request.resource.data.periodKey is string;
    }

    function isValidContactRequestCreate() {
      return isSignedIn()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.receiverUserId is string
        && request.resource.data.receiverUserId != request.auth.uid
        && request.resource.data.targetUserId == request.resource.data.receiverUserId
        && request.resource.data.plateKey is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidContactRequestAccept(requestId) {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.receiverUserId
        && request.resource.data.status == 'accepted'
        && request.resource.data.chatId == 'request_' + requestId
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt', 'chatId']);
    }

    function isValidContactRequestDecline() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.receiverUserId
        && request.resource.data.status == 'declined'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestWithdraw() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.senderUserId
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestUpdate(requestId) {
      return isSignedIn()
        && (
          isValidContactRequestAccept(requestId) ||
          isValidContactRequestDecline() ||
          isValidContactRequestWithdraw()
        );
    }

    function isValidChatCreateForRequest(chatId, requestId) {
      let contactRequest = get(/databases/$(database)/documents/contact_requests/$(requestId));

      return isSignedIn()
        && chatId == 'request_' + requestId
        && contactRequest.data.status == 'pending'
        && request.auth.uid == contactRequest.data.receiverUserId
        && request.resource.data.requestId == requestId
        && request.resource.data.status == 'active'
        && request.resource.data.isDeleted == false
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && contactRequest.data.senderUserId in request.resource.data.participants
        && contactRequest.data.receiverUserId in request.resource.data.participants
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.lastMessage == null ||
          request.resource.data.lastMessage is string
        )
        && (
          request.resource.data.lastMessageAt == null ||
          request.resource.data.lastMessageAt is timestamp
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function hasValidLastMessageFields() {
      return (
          request.resource.data.lastMessage == null ||
          (
            request.resource.data.lastMessage is string &&
            request.resource.data.lastMessage.size() <= 1000
          )
        )
        && (
          request.resource.data.lastMessageAt == null ||
          request.resource.data.lastMessageAt is timestamp
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidCurrentUserReadAt() {
      return request.resource.data.lastReadAtBy is map
        && request.resource.data.lastReadAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('lastReadAtBy', request.auth.uid);
    }

    function hasValidCurrentUserManualUnread(isUnread) {
      return request.resource.data.manualUnreadBy is map
        && request.resource.data.manualUnreadBy[request.auth.uid] == isUnread
        && request.resource.data.manualUnreadUpdatedAtBy is map
        && request.resource.data.manualUnreadUpdatedAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('manualUnreadBy', request.auth.uid)
        && changedOnlyNestedMapKey('manualUnreadUpdatedAtBy', request.auth.uid);
    }

    function isValidChatLastMessageUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && (
          (
            changedOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
            && hasValidLastMessageFields()
          ) ||
          (
            changedOnly([
              'lastMessage',
              'lastMessageAt',
              'lastReadAtBy',
              'manualUnreadBy',
              'manualUnreadUpdatedAtBy',
              'updatedAt',
            ])
            && hasValidLastMessageFields()
            && hasValidCurrentUserReadAt()
            && hasValidCurrentUserManualUnread(false)
          )
        );
    }

    function isValidChatReadUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && (
          (
            changedOnly(['lastReadAtBy'])
            && hasValidCurrentUserReadAt()
          ) ||
          (
            changedOnly([
              'lastReadAtBy',
              'manualUnreadBy',
              'manualUnreadUpdatedAtBy',
            ])
            && hasValidCurrentUserReadAt()
            && hasValidCurrentUserManualUnread(false)
          ) ||
          (
            changedOnly(['manualUnreadBy', 'manualUnreadUpdatedAtBy'])
            && hasValidCurrentUserManualUnread(true)
          )
        );
    }

    function isValidChatTypingUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['typingBy', 'typingUpdatedAtBy'])
        && request.resource.data.typingBy is map
        && request.resource.data.typingBy[request.auth.uid] is bool
        && request.resource.data.typingUpdatedAtBy is map
        && request.resource.data.typingUpdatedAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('typingBy', request.auth.uid)
        && changedOnlyNestedMapKey('typingUpdatedAtBy', request.auth.uid);
    }

    function isValidChatPresenceUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['onlineAtBy'])
        && request.resource.data.onlineAtBy is map
        && request.resource.data.onlineAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('onlineAtBy', request.auth.uid);
    }

    function isValidChatFavoriteUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['favoriteBy', 'favoriteUpdatedAtBy', 'updatedAt'])
        && request.resource.data.favoriteBy is map
        && request.resource.data.favoriteBy[request.auth.uid] is bool
        && request.resource.data.favoriteUpdatedAtBy is map
        && request.resource.data.favoriteUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('favoriteBy', request.auth.uid)
        && changedOnlyNestedMapKey('favoriteUpdatedAtBy', request.auth.uid);
    }

    function isValidChatPinnedUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['pinnedBy', 'pinnedUpdatedAtBy'])
        && request.resource.data.pinnedBy is map
        && request.resource.data.pinnedBy[request.auth.uid] is bool
        && request.resource.data.pinnedUpdatedAtBy is map
        && request.resource.data.pinnedUpdatedAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('pinnedBy', request.auth.uid)
        && changedOnlyNestedMapKey('pinnedUpdatedAtBy', request.auth.uid);
    }

    function isValidChatMutedUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['mutedBy', 'mutedUpdatedAtBy', 'updatedAt'])
        && request.resource.data.mutedBy is map
        && request.resource.data.mutedBy[request.auth.uid] is bool
        && request.resource.data.mutedUpdatedAtBy is map
        && request.resource.data.mutedUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('mutedBy', request.auth.uid)
        && changedOnlyNestedMapKey('mutedUpdatedAtBy', request.auth.uid);
    }

    function isValidChatArchiveUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly([
          'status',
          'archivedBy',
          'archivedUpdatedAtBy',
          'updatedAt',
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.archivedBy is map
        && request.resource.data.archivedBy[request.auth.uid] is bool
        && request.resource.data.archivedUpdatedAtBy is map
        && request.resource.data.archivedUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('archivedBy', request.auth.uid)
        && changedOnlyNestedMapKey('archivedUpdatedAtBy', request.auth.uid);
    }

    function isValidChatDeleteUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly([
          'status',
          'isDeleted',
          'deletedBy',
          'deletedUpdatedAtBy',
          'updatedAt',
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.isDeleted == false
        && request.resource.data.deletedBy is map
        && request.resource.data.deletedBy[request.auth.uid] == true
        && request.resource.data.deletedUpdatedAtBy is map
        && request.resource.data.deletedUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('deletedBy', request.auth.uid)
        && changedOnlyNestedMapKey('deletedUpdatedAtBy', request.auth.uid);
    }

    function isValidChatBlockUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && isOpenChatStatus(resource.data.status)
        && changedOnly(['status', 'blockedBy', 'blockedAt', 'updatedAt'])
        && request.resource.data.status == 'blocked'
        && request.resource.data.blockedBy == request.auth.uid
        && request.resource.data.blockedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidChatUnblockUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && resource.data.status == 'blocked'
        && resource.data.blockedBy == request.auth.uid
        && changedOnly([
          'status',
          'blockedBy',
          'blockedAt',
          'unblockedBy',
          'unblockedAt',
          'updatedAt',
        ])
        && request.resource.data.status == 'active'
        && !('blockedBy' in request.resource.data)
        && !('blockedAt' in request.resource.data)
        && request.resource.data.unblockedBy == request.auth.uid
        && request.resource.data.unblockedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasOnlyMessageCreateFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasValidOptionalReplyFields() {
      return (
          request.resource.data.replyToMessageId == null ||
          (
            request.resource.data.replyToMessageId is string
            && request.resource.data.replyToMessageId.size() <= 120
          )
        )
        && (
          request.resource.data.replyToText == null ||
          (
            request.resource.data.replyToText is string
            && request.resource.data.replyToText.size() <= 280
          )
        );
    }

    function isValidTextMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'createdAt',
          'updatedAt',
          'isDeleted',
          'replyToMessageId',
          'replyToText',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && hasValidOptionalReplyFields()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidLocationMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'createdAt',
          'updatedAt',
          'isDeleted',
          'replyToMessageId',
          'replyToText',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'location'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 80
        && request.resource.data.text.matches(
          '^Standort\\n-?[0-9]+\\.[0-9]{1,6},-?[0-9]+\\.[0-9]{1,6}$'
        )
        && hasValidOptionalReplyFields()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidContactMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'createdAt',
          'updatedAt',
          'isDeleted',
          'replyToMessageId',
          'replyToText',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'contact'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.text.matches(
          '^Kontakt\\nName: .{1,80}\\nTelefon: .{1,40}$'
        )
        && hasValidOptionalReplyFields()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidImageMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'imageUrl',
          'imagePath',
          'createdAt',
          'updatedAt',
          'isDeleted',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'image'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.size() > 0
        && isOwnChatImagePath(chatId, request.resource.data.imagePath)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidDocumentMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'fileUrl',
          'filePath',
          'fileName',
          'fileContentType',
          'fileSizeBytes',
          'createdAt',
          'updatedAt',
          'isDeleted',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'document'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.size() > 0
        && request.resource.data.filePath is string
        && request.resource.data.filePath.size() > 0
        && isOwnChatDocumentPath(chatId, request.resource.data.filePath)
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 160
        && request.resource.data.fileContentType is string
        && request.resource.data.fileContentType.size() > 0
        && request.resource.data.fileContentType.size() <= 120
        && isAllowedChatDocumentContentType(
          request.resource.data.fileContentType
        )
        && request.resource.data.fileSizeBytes is int
        && request.resource.data.fileSizeBytes > 0
        && request.resource.data.fileSizeBytes <= 25 * 1024 * 1024
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isAllowedChatDocumentContentType(contentType) {
      return contentType.matches('text/.*')
        || contentType == 'application/pdf'
        || contentType == 'application/msword'
        || contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || contentType == 'application/vnd.ms-excel'
        || contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || contentType == 'application/vnd.ms-powerpoint'
        || contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || contentType == 'application/rtf';
    }

    function isValidAudioMessageCreate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && hasOnlyMessageCreateFields([
          'chatId',
          'senderUserId',
          'type',
          'text',
          'fileUrl',
          'filePath',
          'fileName',
          'fileContentType',
          'fileSizeBytes',
          'fileDurationMs',
          'createdAt',
          'updatedAt',
          'isDeleted',
        ])
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && request.resource.data.chatId == chatId
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.type == 'audio'
        && request.resource.data.text == 'Sprachnachricht'
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.size() > 0
        && request.resource.data.filePath is string
        && request.resource.data.filePath.size() > 0
        && isOwnChatVoiceMemoPath(chatId, request.resource.data.filePath)
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 160
        && request.resource.data.fileContentType is string
        && request.resource.data.fileContentType == 'audio/mp4'
        && request.resource.data.fileSizeBytes is int
        && request.resource.data.fileSizeBytes > 0
        && request.resource.data.fileSizeBytes <= 15 * 1024 * 1024
        && request.resource.data.fileDurationMs is int
        && request.resource.data.fileDurationMs >= 0
        && request.resource.data.fileDurationMs <= 10 * 60 * 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidMessageStarUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && changedOnly(['isStarred', 'updatedAt'])
        && request.resource.data.isStarred is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMessageDeleteUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && resource.data.isDeleted == false
        && changedOnly(['isDeleted', 'updatedAt'])
        && request.resource.data.isDeleted == true
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMessageReactionUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && request.auth.uid in chat.data.participants
        && isOpenChatStatus(chat.data.status)
        && changedOnly(['reactionBy', 'reactionUpdatedAtBy', 'updatedAt'])
        && request.resource.data.reactionBy is map
        && request.resource.data.reactionBy[request.auth.uid] is string
        && request.resource.data.reactionBy[request.auth.uid].size() <= 16
        && request.resource.data.reactionUpdatedAtBy is map
        && request.resource.data.reactionUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('reactionBy', request.auth.uid)
        && changedOnlyNestedMapKey('reactionUpdatedAtBy', request.auth.uid);
    }

    function isValidChatReportCreate() {
      let chat = get(/databases/$(database)/documents/chats/$(request.resource.data.chatId));

      return isSignedIn()
        && request.resource.data.type == 'chat'
        && request.resource.data.chatId is string
        && request.resource.data.reporterUserId == request.auth.uid
        && request.auth.uid in chat.data.participants
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnChatImagePath(chatId, path) {
      return path.matches(
        '^chat_images/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnChatDocumentPath(chatId, path) {
      return path.matches(
        '^chat_documents/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnChatVoiceMemoPath(chatId, path) {
      return path.matches(
        '^chat_voice_memos/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnStoryImagePath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[^/]+\\.jpg$'
      );
    }

    function isOwnStoryVideoPath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[^/]+\\.mp4$'
      );
    }

    function isValidStoryTextFontFamily(value) {
      return value in [
        'standard',
        'rounded',
        'serif',
        'mono',
        'condensed',
        'light',
        'medium',
        'black',
        'casual',
        'cursive',
      ];
    }

    function isValidStoryFilterType(value) {
      return value in ['normal', 'warm', 'cool', 'mono', 'soft'];
    }

    function isValidStoryTextColorValue(value) {
      return value in [
        4294967295,
        4284732927,
        4294956367,
        4294925450,
        4284805787,
        4294933053,
        4290807036,
        4281193663,
        4294916912,
        4278221567,
        4290182971,
        4294937304,
        4278190080,
      ];
    }

    function isValidStoryStickerType(value) {
      return value in [
        '',
        'location',
        'link',
        'hashtag',
        'vehicle',
        'status',
        'poll',
      ];
    }

    function isValidStoryStickerData(type, label, payload) {
      return (
          type == ''
          && label.size() == 0
          && payload.size() == 0
        )
        || (
          type == 'location'
          && label.size() > 0
          && label.size() <= 80
          && payload.matches(
            '^-?[0-9]+\\.[0-9]{1,6},-?[0-9]+\\.[0-9]{1,6}$'
          )
        )
        || (
          type == 'link'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 300
          && payload.matches('^https?://.+$')
        )
        || (
          type == 'hashtag'
          && label.size() > 1
          && label.size() <= 80
          && label.matches('^#.+$')
          && payload.size() > 0
          && payload.size() <= 79
        )
        || (
          type == 'vehicle'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 24
        )
        || (
          type == 'status'
          && label.size() > 0
          && label.size() <= 32
          && payload.size() > 0
          && payload.size() <= 32
        )
        || (
          type == 'poll'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 57
        );
    }

    function hasOnlyStoryOwnerWriteFields() {
      return request.resource.data.keys().hasOnly([
        'ownerUserId',
        'ownerDisplayName',
        'ownerPhotoUrl',
        'viewerUserIds',
        'viewerNameBy',
        'viewerPhotoUrlBy',
        'viewedAtBy',
        'imageUrl',
        'imagePath',
        'mediaType',
        'videoUrl',
        'videoPath',
        'videoIsMuted',
        'text',
        'textColorValue',
        'textFontFamily',
        'textIsBold',
        'textIsItalic',
        'textIsUnderline',
        'textAlignmentX',
        'textAlignmentY',
        'filterType',
        'stickerType',
        'stickerLabel',
        'stickerPayload',
        'stickerAlignmentX',
        'stickerAlignmentY',
        'createdAt',
        'updatedAt',
        'expiresAt',
      ]);
    }

    function isValidStoryOwnerWrite(storyId) {
      return isSignedIn()
        && hasOnlyStoryOwnerWriteFields()
        && storyId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerDisplayName is string
        && request.resource.data.ownerDisplayName.size() > 0
        && request.resource.data.ownerDisplayName.size() <= 80
        && (
          request.resource.data.ownerPhotoUrl == null ||
          (
            request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 500
          )
        )
        && request.resource.data.viewerUserIds is list
        && request.resource.data.viewerUserIds.size() > 0
        && request.resource.data.viewerUserIds.size() <= 200
        && request.auth.uid in request.resource.data.viewerUserIds
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && request.resource.data.viewerPhotoUrlBy.keys().hasOnly([request.auth.uid])
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.mediaType is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string
        && request.resource.data.videoIsMuted is bool
        && (
          (request.resource.data.mediaType == 'image'
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imagePath.size() > 0
            && isOwnStoryImagePath(request.resource.data.imagePath)
            && request.resource.data.videoUrl.size() == 0
            && request.resource.data.videoPath.size() == 0)
          || (request.resource.data.mediaType == 'video'
            && request.resource.data.videoUrl.size() > 0
            && request.resource.data.videoPath.size() > 0
            && isOwnStoryVideoPath(request.resource.data.videoPath)
            && request.resource.data.imageUrl.size() == 0
            && request.resource.data.imagePath.size() == 0)
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.textColorValue is int
        && isValidStoryTextColorValue(request.resource.data.textColorValue)
        && request.resource.data.textFontFamily is string
        && isValidStoryTextFontFamily(request.resource.data.textFontFamily)
        && request.resource.data.textIsBold is bool
        && request.resource.data.textIsItalic is bool
        && request.resource.data.textIsUnderline is bool
        && request.resource.data.textAlignmentX is number
        && request.resource.data.textAlignmentX >= 0
        && request.resource.data.textAlignmentX <= 1
        && request.resource.data.textAlignmentY is number
        && request.resource.data.textAlignmentY >= 0
        && request.resource.data.textAlignmentY <= 1
        && request.resource.data.filterType is string
        && isValidStoryFilterType(request.resource.data.filterType)
        && request.resource.data.stickerType is string
        && isValidStoryStickerType(request.resource.data.stickerType)
        && request.resource.data.stickerLabel is string
        && request.resource.data.stickerPayload is string
        && isValidStoryStickerData(
          request.resource.data.stickerType,
          request.resource.data.stickerLabel,
          request.resource.data.stickerPayload
        )
        && request.resource.data.stickerAlignmentX is number
        && request.resource.data.stickerAlignmentX >= 0
        && request.resource.data.stickerAlignmentX <= 1
        && request.resource.data.stickerAlignmentY is number
        && request.resource.data.stickerAlignmentY >= 0
        && request.resource.data.stickerAlignmentY <= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h');
    }

    function isValidStoryViewUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.expiresAt > request.time
        && changedOnly(['viewedAtBy', 'viewerNameBy', 'viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewedAtBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerNameBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /search_credits/{creditId} {
        allow read: if isOwner(userId);
        allow create: if isValidInitialSearchCredit(userId, creditId);
        allow update, delete: if false;
      }

      match /legal_consents/{consentId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /moderation_actions/{actionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    match /plates/{plateId} {
      allow read, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.isDeleted == false;

      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid;

      allow delete: if false;
    }

    match /contact_requests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.senderUserId == request.auth.uid ||
          resource.data.receiverUserId == request.auth.uid
        );

      allow create: if isValidContactRequestCreate();

      allow update: if isValidContactRequestUpdate(requestId);

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if request.resource.data.requestId is string
        && isValidChatCreateForRequest(chatId, request.resource.data.requestId);

      allow update: if isValidChatLastMessageUpdate()
        || isValidChatReadUpdate()
        || isValidChatTypingUpdate()
        || isValidChatPresenceUpdate()
        || isValidChatFavoriteUpdate()
        || isValidChatPinnedUpdate()
        || isValidChatMutedUpdate()
        || isValidChatArchiveUpdate()
        || isValidChatDeleteUpdate()
        || isValidChatBlockUpdate()
        || isValidChatUnblockUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isValidTextMessageCreate(chatId)
          || isValidLocationMessageCreate(chatId)
          || isValidContactMessageCreate(chatId)
          || isValidImageMessageCreate(chatId)
          || isValidDocumentMessageCreate(chatId)
          || isValidAudioMessageCreate(chatId);

        allow update: if isValidMessageStarUpdate(chatId)
          || isValidMessageDeleteUpdate(chatId)
          || isValidMessageReactionUpdate(chatId);

        allow delete: if false;
      }
    }

    match /chat_stories/{storyId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && (
          request.auth.uid == resource.data.ownerUserId ||
          resource.data.expiresAt > request.time
        );

      allow create: if isValidStoryOwnerWrite(storyId);
      allow update: if isValidStoryOwnerWrite(storyId)
        || isValidStoryViewUpdate();

      allow delete: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if isValidChatReportCreate();
    }

    match /verification_requests/{requestId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
