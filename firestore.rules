rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function changedOnlyNestedMapKey(field, key) {
      return request.resource.data
        .get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys()
        .hasOnly([key]);
    }

    function changedOnlyNestedMapKeys(field, keys) {
      return request.resource.data
        .get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys()
        .hasOnly(keys);
    }

    function isOpenChatStatus(status) {
      return status == 'active' || status == 'archived';
    }

    function isValidInitialSearchCredit(userId, creditId) {
      return isOwner(userId)
        && creditId == 'main'
        && request.resource.data.userId == userId
        && request.resource.data.used == 0
        && request.resource.data.limit == 2
        && request.resource.data.remaining == 2
        && request.resource.data.paidCredits == 0
        && request.resource.data.totalAvailableRequests == 2
        && request.resource.data.resetPeriod == 'monthly'
        && request.resource.data.periodKey is string;
    }

    function isValidSearchCreditUpdate(userId, creditId) {
      return isOwner(userId)
        && creditId == 'main'
        && request.resource.data.userId == userId
        && request.resource.data.used is int
        && request.resource.data.limit is int
        && request.resource.data.remaining is int
        && request.resource.data.paidCredits is int
        && request.resource.data.totalAvailableRequests is int
        && request.resource.data.resetPeriod is string
        && request.resource.data.periodKey is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.remaining >= 0
        && request.resource.data.paidCredits >= 0
        && request.resource.data.totalAvailableRequests
          == request.resource.data.remaining + request.resource.data.paidCredits
        && changedOnly([
          'used',
          'limit',
          'remaining',
          'paidCredits',
          'periodKey',
          'totalAvailableRequests',
          'resetPeriod',
          'updatedAt',
          'resetAt',
        ]);
    }

    function isValidNotificationSettingsWrite(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'notifications'
        && request.resource.data.userId == userId
        && request.resource.data.contactRequests is bool
        && request.resource.data.chats is bool
        && request.resource.data.reports is bool
        && request.resource.data.verification is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'contactRequests',
          'chats',
          'reports',
          'verification',
          'updatedAt',
        ]);
    }

    function isNullableStringWithMax(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidPublicProfileWrite(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoUrl',
          'publicBio',
          'publicRegion',
          'showVehicleOnPublicProfile',
          'showPlateOnPublicProfile',
          'isPrivateProfile',
          'profileAccessEnabled',
          'followersVisibility',
          'followingVisibility',
          'primaryVehicleId',
          'vehicleBrand',
          'vehicleModel',
          'countryCode',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'updatedAt',
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && isNullableStringWithMax(request.resource.data.photoUrl, 1000)
        && isNullableStringWithMax(request.resource.data.publicBio, 220)
        && isNullableStringWithMax(request.resource.data.publicRegion, 120)
        && request.resource.data.showVehicleOnPublicProfile is bool
        && request.resource.data.showPlateOnPublicProfile is bool
        && request.resource.data.isPrivateProfile is bool
        && request.resource.data.profileAccessEnabled is bool
        && request.resource.data.followersVisibility in [
          'contacts',
          'followers',
          'onlyMe',
        ]
        && request.resource.data.followingVisibility in [
          'contacts',
          'followers',
          'onlyMe',
        ]
        && isNullableStringWithMax(request.resource.data.primaryVehicleId, 160)
        && isNullableStringWithMax(request.resource.data.vehicleBrand, 120)
        && isNullableStringWithMax(request.resource.data.vehicleModel, 120)
        && isNullableStringWithMax(request.resource.data.countryCode, 10)
        && isNullableStringWithMax(request.resource.data.plateRegion, 10)
        && isNullableStringWithMax(request.resource.data.plateLetters, 10)
        && isNullableStringWithMax(request.resource.data.plateNumbers, 10)
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleStatus(status) {
      return status in [
        'active',
        'modification',
        'repair',
        'seasonal',
        'deregistered',
        'sold',
        'noLongerOwned',
        'archived',
      ];
    }

    function isValidVehicleDocument(userId, vehicleId, allowPrivate) {
      return request.resource.data.keys().hasOnly([
          'vehicleId',
          'ownerUserId',
          'brand',
          'model',
          'series',
          'color',
          'countryCode',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'isPrimary',
          'isVerified',
          'status',
          'visibility',
          'showPlate',
          'year',
          'firstRegistration',
          'bodyStyle',
          'engineDescription',
          'displacementCcm',
          'horsepower',
          'kilowatts',
          'fuelType',
          'transmission',
          'drivetrain',
          'equipment',
          'hsn',
          'tsn',
          'vin',
          'ownedSince',
          'mileage',
          'heroImageUrl',
          'heroImagePath',
          'heroImageStatus',
          'heroSourceHash',
          'heroPromptVersion',
          'heroProvider',
          'heroError',
          'heroRequestedAt',
          'heroGeneratedAt',
          'heroRequestWindowStartedAt',
          'heroRequestCount',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() <= 120
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 120
        && isNullableStringWithMax(request.resource.data.series, 120)
        && isNullableStringWithMax(request.resource.data.color, 80)
        && request.resource.data.countryCode in ['DE', 'AT', 'CH']
        && request.resource.data.showPlate is bool
        && (
          (
            allowPrivate
            && request.resource.data.plateRegion is string
            && request.resource.data.plateRegion.size() > 0
            && request.resource.data.plateRegion.size() <= 3
            && request.resource.data.plateLetters is string
            && (
              (
                request.resource.data.countryCode == 'CH'
                && request.resource.data.plateLetters.size() == 0
              )
              || (
                request.resource.data.countryCode != 'CH'
                && request.resource.data.plateLetters.size() > 0
                && request.resource.data.plateLetters.size() <= 2
              )
            )
            && request.resource.data.plateNumbers is string
            && request.resource.data.plateNumbers.size() > 0
            && request.resource.data.plateNumbers.size() <= 6
          )
          || (
            !allowPrivate
            && (
              (
                request.resource.data.showPlate == false
                && request.resource.data.plateRegion == null
                && request.resource.data.plateLetters == null
                && request.resource.data.plateNumbers == null
              )
              || (
                request.resource.data.showPlate == true
                && request.resource.data.plateRegion is string
                && request.resource.data.plateRegion.size() > 0
                && request.resource.data.plateRegion.size() <= 3
                && request.resource.data.plateLetters is string
                && (
                  (
                    request.resource.data.countryCode == 'CH'
                    && request.resource.data.plateLetters.size() == 0
                  )
                  || (
                    request.resource.data.countryCode != 'CH'
                    && request.resource.data.plateLetters.size() > 0
                    && request.resource.data.plateLetters.size() <= 2
                  )
                )
                && request.resource.data.plateNumbers is string
                && request.resource.data.plateNumbers.size() > 0
                && request.resource.data.plateNumbers.size() <= 6
              )
            )
          )
        )
        && request.resource.data.isPrimary is bool
        && request.resource.data.isVerified is bool
        && isValidVehicleStatus(request.resource.data.status)
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && (allowPrivate || request.resource.data.status != 'archived')
        && (
          request.resource.data.year == null
          || (
            request.resource.data.year is int
            && request.resource.data.year >= 1886
            && request.resource.data.year <= 2100
          )
        )
        && (
          request.resource.data.firstRegistration == null
          || request.resource.data.firstRegistration is timestamp
        )
        && isNullableStringWithMax(request.resource.data.bodyStyle, 80)
        && isNullableStringWithMax(request.resource.data.engineDescription, 160)
        && (
          request.resource.data.displacementCcm == null
          || (
            request.resource.data.displacementCcm is int
            && request.resource.data.displacementCcm >= 0
            && request.resource.data.displacementCcm <= 20000
          )
        )
        && (
          request.resource.data.horsepower == null
          || (
            request.resource.data.horsepower is int
            && request.resource.data.horsepower >= 0
            && request.resource.data.horsepower <= 5000
          )
        )
        && (
          request.resource.data.kilowatts == null
          || (
            request.resource.data.kilowatts is int
            && request.resource.data.kilowatts >= 0
            && request.resource.data.kilowatts <= 4000
          )
        )
        && isNullableStringWithMax(request.resource.data.fuelType, 80)
        && isNullableStringWithMax(request.resource.data.transmission, 80)
        && isNullableStringWithMax(request.resource.data.drivetrain, 80)
        && request.resource.data.equipment is list
        && request.resource.data.equipment.size() <= 40
        && (
          allowPrivate
          || (
            request.resource.data.get('hsn', null) == null
            && request.resource.data.get('tsn', null) == null
            && request.resource.data.get('vin', null) == null
          )
        )
        && isNullableStringWithMax(request.resource.data.get('hsn', null), 8)
        && isNullableStringWithMax(request.resource.data.get('tsn', null), 8)
        && isNullableStringWithMax(request.resource.data.get('vin', null), 40)
        && (
          request.resource.data.ownedSince == null
          || request.resource.data.ownedSince is timestamp
        )
        && (
          request.resource.data.mileage == null
          || (
            request.resource.data.mileage is int
            && request.resource.data.mileage >= 0
          )
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroImageUrl', null),
          1000
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroImagePath', null),
          500
        )
        && (
          request.resource.data.get('heroImageStatus', null) == null
          || request.resource.data.get('heroImageStatus', null) in [
            'notGenerated',
            'queued',
            'generating',
            'ready',
            'failed',
            'regenerationRequired',
          ]
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroSourceHash', null),
          160
        )
        && (
          request.resource.data.get('heroPromptVersion', null) == null
          || request.resource.data.get('heroPromptVersion', null) is int
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroProvider', null),
          80
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroError', null),
          500
        )
        && (
          request.resource.data.get('heroRequestedAt', null) == null
          || request.resource.data.heroRequestedAt is timestamp
        )
        && (
          request.resource.data.get('heroGeneratedAt', null) == null
          || request.resource.data.heroGeneratedAt is timestamp
        )
        && (
          request.resource.data.get('heroRequestWindowStartedAt', null) == null
          || request.resource.data.heroRequestWindowStartedAt is timestamp
        )
        && (
          request.resource.data.get('heroRequestCount', null) == null
          || (
            request.resource.data.heroRequestCount is int
            && request.resource.data.heroRequestCount >= 0
            && request.resource.data.heroRequestCount <= 100
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function vehicleClientFieldsOnly() {
      return changedOnly([
        'brand',
        'model',
        'series',
        'color',
        'countryCode',
        'plateRegion',
        'plateLetters',
        'plateNumbers',
        'isPrimary',
        'isVerified',
        'status',
        'visibility',
        'showPlate',
        'year',
        'firstRegistration',
        'bodyStyle',
        'engineDescription',
        'displacementCcm',
        'horsepower',
        'kilowatts',
        'fuelType',
        'transmission',
        'drivetrain',
        'equipment',
        'hsn',
        'tsn',
        'vin',
        'ownedSince',
        'mileage',
        'updatedAt',
      ]);
    }

    function isValidVehicleModification(
      userId,
      vehicleId,
      modificationId,
      allowPrivate
    ) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'modificationId',
          'ownerUserId',
          'vehicleId',
          'title',
          'category',
          'manufacturer',
          'product',
          'description',
          'modifiedAt',
          'workshop',
          'costCents',
          'powerChangeHp',
          'isRegistered',
          'documentPaths',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.modificationId == modificationId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.category in [
          'wheels',
          'tires',
          'suspension',
          'brakes',
          'engine',
          'software',
          'exhaust',
          'lighting',
          'body',
          'wrap',
          'interior',
          'soundSystem',
          'other',
        ]
        && isNullableStringWithMax(request.resource.data.manufacturer, 120)
        && isNullableStringWithMax(request.resource.data.product, 120)
        && isNullableStringWithMax(request.resource.data.description, 600)
        && (
          request.resource.data.modifiedAt == null
          || request.resource.data.modifiedAt is timestamp
        )
        && (
          request.resource.data.powerChangeHp == null
          || (
            request.resource.data.powerChangeHp is int
            && request.resource.data.powerChangeHp >= -5000
            && request.resource.data.powerChangeHp <= 5000
          )
        )
        && request.resource.data.isRegistered is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && (
          allowPrivate
          || (
            request.resource.data.get('workshop', null) == null
            && request.resource.data.get('costCents', null) == null
            && request.resource.data.get('documentPaths', null) == null
          )
        )
        && isNullableStringWithMax(
          request.resource.data.get('workshop', null),
          160
        )
        && (
          request.resource.data.get('costCents', null) == null
          || (
            request.resource.data.get('costCents', null) is int
            && request.resource.data.get('costCents', null) >= 0
          )
        )
        && (
          request.resource.data.get('documentPaths', null) == null
          || (
            request.resource.data.get('documentPaths', null) is list
            && request.resource.data.get('documentPaths', null).size() <= 10
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleGalleryMedia(
      userId,
      vehicleId,
      mediaId,
      allowPrivate
    ) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'mediaId',
          'ownerUserId',
          'vehicleId',
          'mediaUrl',
          'mediaPath',
          'mediaType',
          'category',
          'caption',
          'isMain',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.mediaId == mediaId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.mediaUrl.size() <= 1200
        && request.resource.data.mediaPath
          == 'vehicle_gallery/' + userId + '/' + vehicleId + '/' + mediaId
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.category in [
          'exterior',
          'interior',
          'engineBay',
          'details',
          'modifications',
          'beforeAfter',
          'documentation',
        ]
        && isNullableStringWithMax(request.resource.data.caption, 300)
        && request.resource.data.isMain is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleTimelineEntry(
      userId,
      vehicleId,
      entryId,
      allowPrivate
    ) {
      return existsAfter(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'entryId',
          'ownerUserId',
          'vehicleId',
          'type',
          'title',
          'description',
          'eventDate',
          'mediaUrls',
          'linkedPostId',
          'linkedModificationId',
          'isAutomaticallyCreated',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.entryId == entryId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.type in [
          'vehicleCreated',
          'vehicleAcquired',
          'registered',
          'modificationAdded',
          'maintenance',
          'repair',
          'wheelsInstalled',
          'mileageMilestone',
          'trip',
          'meet',
          'seasonStart',
          'seasonEnd',
          'sold',
          'archived',
          'statusChanged',
          'custom',
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && isNullableStringWithMax(request.resource.data.description, 600)
        && request.resource.data.eventDate is timestamp
        && request.resource.data.mediaUrls is list
        && request.resource.data.mediaUrls.size() <= 10
        && isNullableStringWithMax(request.resource.data.linkedPostId, 160)
        && isNullableStringWithMax(
          request.resource.data.linkedModificationId,
          160
        )
        && request.resource.data.isAutomaticallyCreated is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleEncounterCreate(encounterId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'encounterId',
          'initiatorUserId',
          'recipientUserId',
          'initiatorVehicleId',
          'recipientVehicleId',
          'initiatorVehicleLabel',
          'recipientVehicleLabel',
          'participantUserIds',
          'initiatorPhotoUrl',
          'recipientPhotoUrl',
          'type',
          'status',
          'locationLabel',
          'encounterDate',
          'linkedPostId',
          'confirmedAt',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.encounterId == encounterId
        && request.resource.data.initiatorUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.recipientUserId != request.auth.uid
        && request.resource.data.initiatorVehicleId is string
        && request.resource.data.initiatorVehicleId.size() > 0
        && request.resource.data.initiatorVehicleId.size() <= 160
        && request.resource.data.recipientVehicleId is string
        && request.resource.data.recipientVehicleId.size() > 0
        && request.resource.data.recipientVehicleId.size() <= 160
        && encounterId in [
          request.resource.data.initiatorUserId + '_' + request.resource.data.initiatorVehicleId + '__' + request.resource.data.recipientUserId + '_' + request.resource.data.recipientVehicleId,
          request.resource.data.recipientUserId + '_' + request.resource.data.recipientVehicleId + '__' + request.resource.data.initiatorUserId + '_' + request.resource.data.initiatorVehicleId,
        ]
        && request.resource.data.participantUserIds is list
        && request.resource.data.participantUserIds.size() == 2
        && request.resource.data.participantUserIds.hasAll([
          request.resource.data.initiatorUserId,
          request.resource.data.recipientUserId,
        ])
        && request.resource.data.initiatorVehicleLabel is string
        && request.resource.data.initiatorVehicleLabel.size() > 0
        && request.resource.data.initiatorVehicleLabel.size() <= 240
        && request.resource.data.recipientVehicleLabel is string
        && request.resource.data.recipientVehicleLabel.size() > 0
        && request.resource.data.recipientVehicleLabel.size() <= 240
        && isNullableStringWithMax(request.resource.data.initiatorPhotoUrl, 1000)
        && isNullableStringWithMax(request.resource.data.recipientPhotoUrl, 1000)
        && request.resource.data.type in [
          'spotted',
          'meet',
          'trip',
          'event',
          'other',
        ]
        && request.resource.data.status == 'requested'
        && isNullableStringWithMax(request.resource.data.locationLabel, 120)
        && request.resource.data.encounterDate is timestamp
        && isNullableStringWithMax(request.resource.data.linkedPostId, 160)
        && request.resource.data.confirmedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && hasActiveProfileConnection(request.resource.data.recipientUserId)
        && exists(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)/vehicles/$(request.resource.data.initiatorVehicleId)
        )
        && exists(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.recipientUserId)/vehicles/$(request.resource.data.recipientVehicleId)
        );
    }

    function isValidVehicleEncounterUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participantUserIds
        && (
          (
            request.auth.uid == resource.data.recipientUserId
            && resource.data.status == 'requested'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.confirmedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'confirmedAt', 'updatedAt'])
          )
          || (
            request.auth.uid == resource.data.recipientUserId
            && resource.data.status == 'requested'
            && request.resource.data.status == 'declined'
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.status == 'confirmed'
            && request.resource.data.status == 'removed'
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'updatedAt'])
          )
        );
    }

    function isValidPublicVehicleEncounter(
      userId,
      vehicleId,
      encounterId
    ) {
      let encounter = getAfter(
        /databases/$(database)/documents/vehicle_encounters/$(encounterId)
      );
      return request.resource.data.keys().hasOnly([
          'encounterId',
          'initiatorUserId',
          'recipientUserId',
          'initiatorVehicleId',
          'recipientVehicleId',
          'initiatorVehicleLabel',
          'recipientVehicleLabel',
          'participantUserIds',
          'initiatorPhotoUrl',
          'recipientPhotoUrl',
          'type',
          'status',
          'locationLabel',
          'encounterDate',
          'linkedPostId',
          'confirmedAt',
          'createdAt',
          'updatedAt',
        ])
        && encounter.data.status == 'confirmed'
        && request.auth.uid in encounter.data.participantUserIds
        && (
          (
            userId == encounter.data.initiatorUserId
            && vehicleId == encounter.data.initiatorVehicleId
          )
          || (
            userId == encounter.data.recipientUserId
            && vehicleId == encounter.data.recipientVehicleId
          )
        )
        && request.resource.data.encounterId == encounterId
        && request.resource.data.initiatorUserId
          == encounter.data.initiatorUserId
        && request.resource.data.recipientUserId
          == encounter.data.recipientUserId
        && request.resource.data.initiatorVehicleId
          == encounter.data.initiatorVehicleId
        && request.resource.data.recipientVehicleId
          == encounter.data.recipientVehicleId
        && request.resource.data.participantUserIds
          == encounter.data.participantUserIds
        && request.resource.data.initiatorVehicleLabel
          == encounter.data.initiatorVehicleLabel
        && request.resource.data.recipientVehicleLabel
          == encounter.data.recipientVehicleLabel
        && request.resource.data.initiatorPhotoUrl
          == encounter.data.initiatorPhotoUrl
        && request.resource.data.recipientPhotoUrl
          == encounter.data.recipientPhotoUrl
        && request.resource.data.type == encounter.data.type
        && request.resource.data.status == 'confirmed'
        && request.resource.data.locationLabel == encounter.data.locationLabel
        && request.resource.data.encounterDate == encounter.data.encounterDate
        && request.resource.data.linkedPostId == encounter.data.linkedPostId
        && request.resource.data.confirmedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function canDeletePublicVehicleEncounter(encounterId) {
      let encounter = getAfter(
        /databases/$(database)/documents/vehicle_encounters/$(encounterId)
      );
      return isSignedIn()
        && request.auth.uid in encounter.data.participantUserIds
        && encounter.data.status == 'removed';
    }

    function profileAllowsAccess(userId) {
      return exists(
          /databases/$(database)/documents/public_profiles/$(userId)
        )
        && get(
          /databases/$(database)/documents/public_profiles/$(userId)
        ).data.profileAccessEnabled == true;
    }

    function isActiveProfileConnectionData(connectionData, targetUserId) {
      return isSignedIn()
        && targetUserId != request.auth.uid
        && connectionData.status == 'active'
        && connectionData.participants is list
        && connectionData.participants.size() == 2
        && connectionData.participants.hasAll([
          request.auth.uid,
          targetUserId,
        ])
        && connectionData.requestId is string
        && connectionData.chatId is string
        && exists(
          /databases/$(database)/documents/contact_requests/$(connectionData.requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(connectionData.requestId)
        ).data.status == 'accepted'
        && exists(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        )
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.requestId == connectionData.requestId
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.participants.hasAll([request.auth.uid, targetUserId])
        && isOpenChatStatus(
          get(
            /databases/$(database)/documents/chats/$(connectionData.chatId)
          ).data.status
        )
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.get('deletedBy', {})[request.auth.uid] != true
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.get('deletedBy', {})[targetUserId] != true;
    }

    function hasActiveProfileConnectionById(connectionId, targetUserId) {
      return exists(
          /databases/$(database)/documents/profile_connections/$(connectionId)
        )
        && isActiveProfileConnectionData(
          get(
            /databases/$(database)/documents/profile_connections/$(connectionId)
          ).data,
          targetUserId
        );
    }

    function hasActiveProfileConnection(targetUserId) {
      return isOwner(targetUserId)
        || (
          isSignedIn()
          && (
            hasActiveProfileConnectionById(
              request.auth.uid + '_' + targetUserId,
              targetUserId
            )
            || hasActiveProfileConnectionById(
              targetUserId + '_' + request.auth.uid,
              targetUserId
            )
          )
        );
    }

    function isValidProfileConnectionWrite(connectionId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'connectionId',
          'userAId',
          'userBId',
          'participants',
          'requestId',
          'chatId',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.connectionId == connectionId
        && request.resource.data.userAId is string
        && request.resource.data.userBId is string
        && request.resource.data.userAId != request.resource.data.userBId
        && connectionId in [
          request.resource.data.userAId + '_' + request.resource.data.userBId,
          request.resource.data.userBId + '_' + request.resource.data.userAId,
        ]
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.userAId,
          request.resource.data.userBId,
        ])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status == 'active'
        && request.resource.data.requestId is string
        && request.resource.data.chatId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.status == 'accepted'
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.senderUserId in request.resource.data.participants
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.receiverUserId in request.resource.data.participants
        && exists(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        )
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.requestId == request.resource.data.requestId
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.participants.hasAll(request.resource.data.participants)
        && isOpenChatStatus(
          get(
            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
          ).data.status
        );
    }

    function followRelationshipId(followerUserId, followedUserId) {
      return followerUserId + '_' + followedUserId;
    }

    function isFollowing(followerUserId, followedUserId) {
      let relationshipId = followRelationshipId(
        followerUserId,
        followedUserId
      );
      return exists(
          /databases/$(database)/documents/follow_relationships/$(relationshipId)
        )
        && get(
          /databases/$(database)/documents/follow_relationships/$(relationshipId)
        ).data.status == 'following';
    }

    function canSeeProfileList(profileUserId, visibility) {
      return request.auth.uid == profileUserId
        || (
          visibility == 'contacts'
          && hasActiveProfileConnection(profileUserId)
        )
        || (
          visibility == 'followers'
          && hasActiveProfileConnection(profileUserId)
          && isFollowing(request.auth.uid, profileUserId)
        );
    }

    function canReadFollowRelationship(relationshipData) {
      return isSignedIn()
        && (
          request.auth.uid == relationshipData.followerUserId
          || request.auth.uid == relationshipData.followedUserId
          || (
            profileAllowsAccess(relationshipData.followedUserId)
            && canSeeProfileList(
              relationshipData.followedUserId,
              get(
                /databases/$(database)/documents/public_profiles/$(relationshipData.followedUserId)
              ).data.followersVisibility
            )
          )
          || (
            profileAllowsAccess(relationshipData.followerUserId)
            && canSeeProfileList(
              relationshipData.followerUserId,
              get(
                /databases/$(database)/documents/public_profiles/$(relationshipData.followerUserId)
              ).data.followingVisibility
            )
          )
        );
    }

    function isValidFollowRelationshipCreate(relationshipId) {
      let followerProfile = get(
        /databases/$(database)/documents/public_profiles/$(request.resource.data.followerUserId)
      );
      let targetProfile = get(
        /databases/$(database)/documents/public_profiles/$(request.resource.data.followedUserId)
      );
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'relationshipId',
          'followerUserId',
          'followedUserId',
          'followerDisplayName',
          'followedDisplayName',
          'followerPhotoUrl',
          'followedPhotoUrl',
          'status',
          'createdAt',
          'updatedAt',
          'acceptedAt',
        ])
        && request.resource.data.relationshipId == relationshipId
        && request.resource.data.followerUserId == request.auth.uid
        && request.resource.data.followedUserId is string
        && request.resource.data.followedUserId != request.auth.uid
        && request.resource.data.followerDisplayName
          == followerProfile.data.displayName
        && request.resource.data.followedDisplayName
          == targetProfile.data.displayName
        && request.resource.data.followerDisplayName is string
        && request.resource.data.followerDisplayName.size() > 0
        && request.resource.data.followerDisplayName.size() <= 80
        && request.resource.data.followedDisplayName is string
        && request.resource.data.followedDisplayName.size() > 0
        && request.resource.data.followedDisplayName.size() <= 80
        && request.resource.data.followerPhotoUrl
          == followerProfile.data.get('photoUrl', null)
        && request.resource.data.followedPhotoUrl
          == targetProfile.data.get('photoUrl', null)
        && isNullableStringWithMax(
          request.resource.data.followerPhotoUrl,
          1000
        )
        && isNullableStringWithMax(
          request.resource.data.followedPhotoUrl,
          1000
        )
        && relationshipId == followRelationshipId(
          request.resource.data.followerUserId,
          request.resource.data.followedUserId
        )
        && profileAllowsAccess(request.resource.data.followedUserId)
        && hasActiveProfileConnection(request.resource.data.followedUserId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            targetProfile.data.isPrivateProfile == true
            && request.resource.data.status == 'requested'
            && request.resource.data.acceptedAt == null
          )
          || (
            targetProfile.data.isPrivateProfile == false
            && request.resource.data.status == 'following'
            && request.resource.data.acceptedAt is timestamp
          )
        );
    }

    function isValidFollowRequestAccept() {
      return isSignedIn()
        && request.auth.uid == resource.data.followedUserId
        && resource.data.status == 'requested'
        && request.resource.data.status == 'following'
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'acceptedAt', 'updatedAt'])
        && hasActiveProfileConnection(resource.data.followerUserId);
    }

    function isValidFollowRelationshipDelete() {
      return isSignedIn()
        && (
          request.auth.uid == resource.data.followerUserId
          || request.auth.uid == resource.data.followedUserId
        );
    }

    function contactRequestDocumentId() {
      return request.auth.uid + '_' + request.resource.data.plateKey;
    }

    function isValidContactRequestCreate(requestId) {
      return isSignedIn()
        && requestId == contactRequestDocumentId()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.receiverUserId is string
        && request.resource.data.receiverUserId != request.auth.uid
        && request.resource.data.targetUserId == request.resource.data.receiverUserId
        && request.resource.data.plateKey is string
        && request.resource.data.plateKey.matches('^[A-ZÄÖÜ0-9]{2,20}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isDeleted == false;
    }

    function isValidContactRequestAccept(requestId) {
      return request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.auth.uid == resource.data.receiverUserId
            && resource.data.status == 'pending'
            && changedOnly(['status', 'updatedAt'])
          ) ||
          (
            request.auth.uid == resource.data.receiverUserId
            && resource.data.status == 'pending'
            && request.resource.data.chatId == 'request_' + requestId
            && changedOnly(['status', 'updatedAt', 'chatId'])
          ) ||
          (
            (
              request.auth.uid == resource.data.receiverUserId ||
              request.auth.uid == resource.data.senderUserId
            )
            && resource.data.status == 'accepted'
            && request.resource.data.chatId == 'request_' + requestId
            && changedOnly(['updatedAt', 'chatId'])
          )
        );
    }

    function isValidContactRequestDecline() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.receiverUserId
        && request.resource.data.status == 'declined'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestWithdraw() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.senderUserId
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestResend(requestId) {
      return resource.data.expiresAt is timestamp
        && resource.data.expiresAt <= request.time
        && request.auth.uid == resource.data.senderUserId
        && request.resource.data.senderUserId == resource.data.senderUserId
        && request.resource.data.receiverUserId == resource.data.receiverUserId
        && request.resource.data.targetUserId == resource.data.targetUserId
        && request.resource.data.plateKey == resource.data.plateKey
        && isValidContactRequestCreate(requestId);
    }

    function isValidContactRequestUpdate(requestId) {
      return isSignedIn()
        && (
          isValidContactRequestAccept(requestId) ||
          isValidContactRequestDecline() ||
          isValidContactRequestWithdraw() ||
          isValidContactRequestResend(requestId)
        );
    }

    function isValidChatCreateForRequestData(chatId, requestId, contactRequestData) {
      return isSignedIn()
        && chatId == 'request_' + requestId
        && request.resource.data.requestId == requestId
        && contactRequestData.status in ['pending', 'accepted']
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          contactRequestData.senderUserId,
          contactRequestData.receiverUserId,
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.isDeleted == false
        && (
          contactRequestData.receiverUserId == request.auth.uid ||
          contactRequestData.senderUserId == request.auth.uid
        );
    }

    function isValidChatCreateForExistingRequest(chatId, requestId) {
      return exists(/databases/$(database)/documents/contact_requests/$(requestId))
        && isValidChatCreateForRequestData(
        chatId,
        requestId,
        get(/databases/$(database)/documents/contact_requests/$(requestId)).data
      );
    }

    function isValidChatCreateForPendingRequestWrite(chatId, requestId) {
      let contactRequest = getAfter(/databases/$(database)/documents/contact_requests/$(requestId));

      return isValidChatCreateForRequestData(
        chatId,
        requestId,
        contactRequest.data
      );
    }

    function isValidChatCreateForRequest(chatId, requestId) {
      return isValidChatCreateForExistingRequest(chatId, requestId)
        || isValidChatCreateForPendingRequestWrite(chatId, requestId);
    }

    function isValidVerificationRequestCreate(requestId) {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestId == requestId
        && request.resource.data.status == 'pending'
        && request.resource.data.profilePath == 'users/' + request.auth.uid + '/profiles/main'
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.documentRemoteUrls is map
        && request.resource.data.keys().hasOnly([
          'requestId',
          'userId',
          'profilePath',
          'status',
          'displayName',
          'email',
          'countryCode',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'vehicleBrand',
          'vehicleModel',
          'vehicleColor',
          'photoUrl',
          'documentRemoteUrls',
          'submittedAt',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isOwnerEditableVerificationStatus() {
      return request.resource.data.verificationStatus in [
        'unverified',
        'draft',
        'pending',
      ];
    }

    function isUnchangedAdminVerificationStatus() {
      return resource.data.verificationStatus in ['verified', 'rejected']
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.verificationSubmittedAt == resource.data.verificationSubmittedAt
        && request.resource.data.verificationReviewedAt == resource.data.verificationReviewedAt
        && request.resource.data.verificationRejectionReason == resource.data.verificationRejectionReason;
    }

    function hasOwnerProfileVerificationFields() {
      return (
          request.resource.data.verificationStatus == 'pending'
          && request.resource.data.verificationSubmittedAt is timestamp
          && request.resource.data.verificationReviewedAt == null
          && request.resource.data.verificationRejectionReason == null
        ) ||
        (
          request.resource.data.verificationStatus in ['unverified', 'draft']
          && request.resource.data.verificationSubmittedAt == null
          && request.resource.data.verificationReviewedAt == null
          && request.resource.data.verificationRejectionReason == null
        ) ||
        isUnchangedAdminVerificationStatus();
    }

    function isValidOwnerProfileWrite(userId, profileId) {
      return isOwner(userId)
        && profileId == 'main'
        && request.resource.data.uid == userId
        && hasOwnerProfileVerificationFields()
        && (
          isOwnerEditableVerificationStatus() ||
          isUnchangedAdminVerificationStatus()
        );
    }

    function isValidAdminProfileReviewUpdate() {
      return isAdmin()
        && changedOnly([
          'verificationStatus',
          'verificationReviewedAt',
          'verificationRejectionReason',
          'updatedAt',
        ])
        && request.resource.data.verificationStatus in ['verified', 'rejected']
        && request.resource.data.verificationReviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.verificationStatus == 'verified'
            && request.resource.data.verificationRejectionReason == null
          ) ||
          (
            request.resource.data.verificationStatus == 'rejected'
            && request.resource.data.verificationRejectionReason is string
            && request.resource.data.verificationRejectionReason.size() <= 600
          )
        );
    }

    function isValidAdminVerificationRequestUpdate() {
      return isAdmin()
        && changedOnly([
          'status',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason',
          'updatedAt',
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.rejectionReason == null
          ) ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() <= 600
          )
        );
    }

    function isUndeletedChatParticipant(chatData) {
      return isSignedIn()
        && request.auth.uid in chatData.participants
        && chatData.get('deletedBy', {})[request.auth.uid] != true;
    }

    function isOpenUndeletedChatParticipant(chatData) {
      return isUndeletedChatParticipant(chatData)
        && isOpenChatStatus(chatData.status);
    }

    function hasValidLastMessageFields() {
      return (
          request.resource.data.lastMessage == null ||
          (
            request.resource.data.lastMessage is string &&
            request.resource.data.lastMessage.size() <= 1000
          )
        )
        && (
          request.resource.data.lastMessageAt == null ||
          request.resource.data.lastMessageAt is timestamp
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidCurrentUserReadAt() {
      return request.resource.data.lastReadAtBy is map
        && request.resource.data.lastReadAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('lastReadAtBy', request.auth.uid);
    }

    function hasValidCurrentUserManualUnread(isUnread) {
      return request.resource.data.manualUnreadBy is map
        && request.resource.data.manualUnreadBy[request.auth.uid] == isUnread
        && request.resource.data.manualUnreadUpdatedAtBy is map
        && request.resource.data.manualUnreadUpdatedAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('manualUnreadBy', request.auth.uid)
        && changedOnlyNestedMapKey('manualUnreadUpdatedAtBy', request.auth.uid);
    }

    function hasValidParticipantArchiveClear() {
      return resource.data.participants is list
        && resource.data.participants.size() == 2
        && request.resource.data.archivedBy is map
        && request.resource.data.archivedUpdatedAtBy is map
        && request.resource.data.archivedBy[resource.data.participants[0]] == false
        && request.resource.data.archivedBy[resource.data.participants[1]] == false
        && request.resource.data.archivedUpdatedAtBy[resource.data.participants[0]] is timestamp
        && request.resource.data.archivedUpdatedAtBy[resource.data.participants[1]] is timestamp
        && changedOnlyNestedMapKeys('archivedBy', resource.data.participants)
        && changedOnlyNestedMapKeys('archivedUpdatedAtBy', resource.data.participants);
    }

    function isValidChatLastMessageUpdate() {
      return isSignedIn()
        && isOpenUndeletedChatParticipant(resource.data)
        && (
          (
            changedOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
            && hasValidLastMessageFields()
          ) ||
          (
            changedOnly([
              'lastMessage',
              'lastMessageAt',
              'lastReadAtBy',
              'manualUnreadBy',
              'manualUnreadUpdatedAtBy',
              'updatedAt',
            ])
            && hasValidLastMessageFields()
            && hasValidCurrentUserReadAt()
            && hasValidCurrentUserManualUnread(false)
          ) ||
          (
            changedOnly([
              'lastMessage',
              'lastMessageAt',
              'lastReadAtBy',
              'manualUnreadBy',
              'manualUnreadUpdatedAtBy',
              'archivedBy',
              'archivedUpdatedAtBy',
              'updatedAt',
            ])
            && hasValidLastMessageFields()
            && hasValidCurrentUserReadAt()
            && hasValidCurrentUserManualUnread(false)
            && hasValidParticipantArchiveClear()
          )
        );
    }

    function isValidChatReadUpdate() {
      return isSignedIn()
        && isOpenUndeletedChatParticipant(resource.data)
        && (
          (
            changedOnly(['lastReadAtBy'])
            && hasValidCurrentUserReadAt()
          ) ||
          (
            changedOnly([
              'lastReadAtBy',
              'manualUnreadBy',
              'manualUnreadUpdatedAtBy',
            ])
            && hasValidCurrentUserReadAt()
            && hasValidCurrentUserManualUnread(false)
          ) ||
          (
            changedOnly(['manualUnreadBy', 'manualUnreadUpdatedAtBy'])
            && hasValidCurrentUserManualUnread(true)
          )
        );
    }

    function isValidChatTypingUpdate() {
      return isSignedIn()
        && isOpenUndeletedChatParticipant(resource.data)
        && changedOnly(['typingBy', 'typingUpdatedAtBy'])
        && request.resource.data.typingBy is map
        && request.resource.data.typingBy[request.auth.uid] is bool
        && request.resource.data.typingUpdatedAtBy is map
        && request.resource.data.typingUpdatedAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('typingBy', request.auth.uid)
        && changedOnlyNestedMapKey('typingUpdatedAtBy', request.auth.uid);
    }

    function isValidChatPresenceUpdate() {
      return isSignedIn()
        && isOpenUndeletedChatParticipant(resource.data)
        && changedOnly(['onlineAtBy'])
        && request.resource.data.onlineAtBy is map
        && request.resource.data.onlineAtBy[request.auth.uid] is timestamp
        && changedOnlyNestedMapKey('onlineAtBy', request.auth.uid);
    }

    function isValidChatFavoriteUpdate() {
      return isSignedIn()
        && isOpenUndeletedChatParticipant(resource.data)
