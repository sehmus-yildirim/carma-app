rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasBlockedAccountDeletion(userId) {
      let deletionPath = /databases/$(database)/documents/account_deletions/$(userId);
      return exists(deletionPath)
        && get(deletionPath).data.status in [
          'requested',
          'processing',
          'completed'
        ];
    }

    function isSignedIn() {
      return isAuthenticated()
        && !hasBlockedAccountDeletion(request.auth.uid);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userSettingPath(userId, settingsId) {
      return /databases/$(database)/documents/users/$(userId)/settings/$(settingsId);
    }

    function readReceiptsEnabledFor(userId) {
      let settingsPath = userSettingPath(userId, 'chat_privacy');
      return !exists(settingsPath)
        || get(settingsPath).data.readReceiptsEnabled == true;
    }

    function onlineStatusEnabledFor(userId) {
      let settingsPath = userSettingPath(userId, 'chat_privacy');
      return exists(settingsPath)
        && get(settingsPath).data.onlineStatusEnabled == true;
    }

    function storyRepliesEnabledFor(userId) {
      let settingsPath = userSettingPath(userId, 'story_privacy');
      return !exists(settingsPath)
        || get(settingsPath).data.storyRepliesEnabled == true;
    }

    function storyAudienceMatchesPrivacy(userId) {
      let settingsPath = userSettingPath(userId, 'story_privacy');
      let viewerUserIds = request.resource.data.viewerUserIds;
      return !exists(settingsPath)
        || (
          get(settingsPath).data.storyVisibility == 'onlyMe'
          && viewerUserIds.size() == 1
          && userId in viewerUserIds
        )
        || (
          get(settingsPath).data.storyVisibility == 'contacts'
          && !viewerUserIds.hasAny(
            get(settingsPath).data.excludedStoryUserIds
          )
        );
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function changedOnlyNestedMapKey(field, key) {
      return request.resource.data
        .get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys()
        .hasOnly([key]);
    }

    function changedOnlyNestedMapKeys(field, keys) {
      return request.resource.data
        .get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys()
        .hasOnly(keys);
    }

    function isOpenChatStatus(status) {
      return status == 'active' || status == 'archived';
    }

    function isValidInitialSearchCredit(userId, creditId) {
      return isOwner(userId)
        && creditId == 'main'
        && request.resource.data.userId == userId
        && request.resource.data.used == 0
        && request.resource.data.limit == 2
        && request.resource.data.remaining == 2
        && request.resource.data.paidCredits == 0
        && request.resource.data.totalAvailableRequests == 2
        && request.resource.data.resetPeriod == 'monthly'
        && request.resource.data.periodKey is string;
    }

    function isValidSearchCreditUpdate(userId, creditId) {
      return isOwner(userId)
        && creditId == 'main'
        && request.resource.data.userId == userId
        && request.resource.data.used is int
        && request.resource.data.limit is int
        && request.resource.data.remaining is int
        && request.resource.data.paidCredits is int
        && request.resource.data.totalAvailableRequests is int
        && request.resource.data.resetPeriod is string
        && request.resource.data.periodKey is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.remaining >= 0
        && request.resource.data.paidCredits >= 0
        && request.resource.data.totalAvailableRequests
          == request.resource.data.remaining + request.resource.data.paidCredits
        && changedOnly([
          'used',
          'limit',
          'remaining',
          'paidCredits',
          'periodKey',
          'totalAvailableRequests',
          'resetPeriod',
          'updatedAt',
          'resetAt',
        ]);
    }

    function isValidNotificationSettingsWrite(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'notifications'
        && request.resource.data.userId == userId
        && request.resource.data.contactRequests is bool
        && request.resource.data.chats is bool
        && request.resource.data.reports is bool
        && request.resource.data.verification is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'contactRequests',
          'chats',
          'reports',
          'verification',
          'updatedAt',
        ]);
    }

    function isValidUserSettingVisibility(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'visibility'
        && request.resource.data.userId == userId
        && request.resource.data.profileVisibility in ['contacts', 'onlyMe']
        && request.resource.data.plateSearchVisibility in ['contacts', 'onlyMe']
        && request.resource.data.showVehicle is bool
        && request.resource.data.showRegion is bool
        && request.resource.data.showPlate is bool
        && request.resource.data.allowContactRequests is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'profileVisibility',
          'plateSearchVisibility',
          'showVehicle',
          'showRegion',
          'showPlate',
          'allowContactRequests',
          'updatedAt',
        ]);
    }

    function isValidUserSettingContactFilters(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'contact_filters'
        && request.resource.data.userId == userId
        && request.resource.data.requireVerifiedRequester is bool
        && request.resource.data.get('requesterVerificationLevel', 'all') in [
          'all',
          'vehicleVerified',
          'identityVerified'
        ]
        && request.resource.data.allowedContactReasons is list
        && request.resource.data.allowedContactReasons.size() <= 8
        && request.resource.data.autoRejectUnverified is bool
        && (
          request.resource.data.contactRequestQuietModeUntil == null ||
          request.resource.data.contactRequestQuietModeUntil is timestamp
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'requireVerifiedRequester',
          'requesterVerificationLevel',
          'allowedContactReasons',
          'autoRejectUnverified',
          'contactRequestQuietModeUntil',
          'updatedAt',
        ]);
    }

    function isValidUserSettingChatPrivacy(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'chat_privacy'
        && request.resource.data.userId == userId
        && request.resource.data.readReceiptsEnabled is bool
        && request.resource.data.onlineStatusEnabled is bool
        && request.resource.data.autoSaveMedia is bool
        && request.resource.data.defaultViewOnceMedia is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'readReceiptsEnabled',
          'onlineStatusEnabled',
          'autoSaveMedia',
          'defaultViewOnceMedia',
          'updatedAt',
        ]);
    }

    function isValidUserSettingStoryPrivacy(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'story_privacy'
        && request.resource.data.userId == userId
        && request.resource.data.storyVisibility in ['contacts', 'onlyMe']
        && request.resource.data.excludedStoryUserIds is list
        && request.resource.data.excludedStoryUserIds.size() <= 100
        && request.resource.data.storyRepliesEnabled is bool
        && request.resource.data.defaultStoryVehicleData is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'storyVisibility',
          'excludedStoryUserIds',
          'storyRepliesEnabled',
          'defaultStoryVehicleData',
          'updatedAt',
        ]);
    }

    function isValidUserSettingAppPreferences(userId, settingsId) {
      return isOwner(userId)
        && settingsId == 'app_preferences'
        && request.resource.data.userId == userId
        && request.resource.data.languageCode in ['de', 'en', 'tr']
        && request.resource.data.themeMode in ['dark', 'light', 'system']
        && request.resource.data.hapticsEnabled is bool
        && request.resource.data.messageSoundsEnabled is bool
        && request.resource.data.distanceUnit == 'km'
        && request.resource.data.defaultPlateCountry in ['DE', 'AT', 'CH']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'languageCode',
          'themeMode',
          'hapticsEnabled',
          'messageSoundsEnabled',
          'distanceUnit',
          'defaultPlateCountry',
          'updatedAt',
        ]);
    }

    function isValidUserSettingsWrite(userId, settingsId) {
      return isValidNotificationSettingsWrite(userId, settingsId)
        || isValidUserSettingVisibility(userId, settingsId)
        || isValidUserSettingContactFilters(userId, settingsId)
        || isValidUserSettingChatPrivacy(userId, settingsId)
        || isValidUserSettingStoryPrivacy(userId, settingsId)
        || isValidUserSettingAppPreferences(userId, settingsId);
    }

    function isValidPushTokenWrite(userId, tokenId) {
      return isOwner(userId)
        && tokenId.matches('^[a-f0-9]{64}$')
        && request.resource.data.userId == userId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId',
          'token',
          'platform',
          'updatedAt',
        ]);
    }

    function isNullableStringWithMax(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function keepsLockedPersonalData() {
      let wasLocked = resource.data.get('personalDataLocked', false) == true
        || (
          resource.data.firstName is string
          && resource.data.firstName.size() > 0
          && resource.data.lastName is string
          && resource.data.lastName.size() > 0
          && resource.data.birthDate is timestamp
        );
      let staysLocked =
        request.resource.data.get('personalDataLocked', false) == true;
      return !wasLocked
        || (
          staysLocked
          && request.resource.data.firstName == resource.data.firstName
          && request.resource.data.lastName == resource.data.lastName
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.birthDate == resource.data.birthDate
        );
    }

    function isAtLeast16YearsOld(birthDate) {
      let today = request.time.date();
      return birthDate is timestamp
        && birthDate >= timestamp.date(1900, 1, 1)
        && birthDate.date() <= today
        && (
          birthDate.year() < today.year() - 16
          || (
            birthDate.year() == today.year() - 16
            && (
              birthDate.month() < today.month()
              || (
                birthDate.month() == today.month()
                && birthDate.day() <= today.day()
              )
            )
          )
        );
    }

    function hasValidPersonalDataState() {
      let birthDate = request.resource.data.get('birthDate', null);
      let isLocked =
        request.resource.data.get('personalDataLocked', false) == true;
      return birthDate == null
        ? !isLocked
        : (
          request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.firstName.size() <= 80
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
          && request.resource.data.lastName.size() <= 80
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && isAtLeast16YearsOld(birthDate)
        );
    }

    function publicNameMatchesLockedPersonalData(userId) {
      let privatePath =
        /databases/$(database)/documents/users/$(userId)/profiles/main;
      return !existsAfter(privatePath)
        || getAfter(privatePath).data.get('personalDataLocked', false) != true
        || request.resource.data.displayName
          == getAfter(privatePath).data.displayName;
    }

    function publicVerificationMatchesPrivateProfile(userId) {
      let privatePath =
        /databases/$(database)/documents/users/$(userId)/profiles/main;
      return existsAfter(privatePath)
        && request.resource.data.verificationStatus
          == getAfter(privatePath).data.verificationStatus;
    }

    function isValidPublicProfileWrite(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoUrl',
          'publicBio',
          'publicRegion',
          'showVehicleOnPublicProfile',
          'showPlateOnPublicProfile',
          'isPrivateProfile',
          'profileAccessEnabled',
          'followersVisibility',
          'followingVisibility',
          'verificationStatus',
          'primaryVehicleId',
          'vehicleBrand',
          'vehicleModel',
          'vehicleColor',
          'countryCode',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'updatedAt',
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && isNullableStringWithMax(request.resource.data.photoUrl, 1000)
        && isNullableStringWithMax(request.resource.data.publicBio, 220)
        && isNullableStringWithMax(request.resource.data.publicRegion, 120)
        && request.resource.data.showVehicleOnPublicProfile is bool
        && request.resource.data.showPlateOnPublicProfile is bool
        && request.resource.data.isPrivateProfile is bool
        && request.resource.data.profileAccessEnabled is bool
        && request.resource.data.followersVisibility in [
          'contacts',
          'followers',
          'onlyMe',
        ]
        && request.resource.data.followingVisibility in [
          'contacts',
          'followers',
          'onlyMe',
        ]
        && request.resource.data.verificationStatus in [
          'unverified',
          'draft',
          'pending',
          'verified',
          'rejected',
          'expired',
        ]
        && isNullableStringWithMax(request.resource.data.primaryVehicleId, 160)
        && isNullableStringWithMax(request.resource.data.vehicleBrand, 120)
        && isNullableStringWithMax(request.resource.data.vehicleModel, 120)
        && isNullableStringWithMax(request.resource.data.vehicleColor, 80)
        && isNullableStringWithMax(request.resource.data.countryCode, 10)
        && isNullableStringWithMax(request.resource.data.plateRegion, 10)
        && isNullableStringWithMax(request.resource.data.plateLetters, 10)
        && isNullableStringWithMax(request.resource.data.plateNumbers, 10)
        && request.resource.data.updatedAt is timestamp
        && publicNameMatchesLockedPersonalData(userId)
        && publicVerificationMatchesPrivateProfile(userId);
    }

    function isValidVehicleStatus(status) {
      return status in [
        'active',
        'modification',
        'repair',
        'seasonal',
        'deregistered',
        'sold',
        'noLongerOwned',
        'archived',
      ];
    }

    function isValidVehicleDocument(userId, vehicleId, allowPrivate) {
      return request.resource.data.keys().hasOnly([
          'vehicleId',
          'ownerUserId',
          'brand',
          'model',
          'series',
          'color',
          'countryCode',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'isPrimary',
          'isVerified',
          'verificationStatus',
          'verificationLocked',
          'verificationRejectionReason',
          'status',
          'visibility',
          'showPlate',
          'year',
          'firstRegistration',
          'bodyStyle',
          'engineDescription',
          'displacementCcm',
          'horsepower',
          'kilowatts',
          'fuelType',
          'transmission',
          'drivetrain',
          'equipment',
          'hsn',
          'tsn',
          'vin',
          'ownedSince',
          'mileage',
          'profileHighlights',
          'heroImageUrl',
          'heroImagePath',
          'heroImageStatus',
          'heroSourceHash',
          'heroPromptVersion',
          'heroProvider',
          'heroError',
          'heroRequestedAt',
          'heroGeneratedAt',
          'heroRequestWindowStartedAt',
          'heroRequestCount',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() <= 120
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 120
        && isNullableStringWithMax(request.resource.data.series, 120)
        && isNullableStringWithMax(request.resource.data.color, 80)
        && request.resource.data.countryCode in ['DE', 'AT', 'CH']
        && request.resource.data.showPlate is bool
        && (
          (
            allowPrivate
            && request.resource.data.plateRegion is string
            && request.resource.data.plateRegion.size() > 0
            && request.resource.data.plateRegion.size() <= 3
            && request.resource.data.plateLetters is string
            && (
              (
                request.resource.data.countryCode == 'CH'
                && request.resource.data.plateLetters.size() == 0
              )
              || (
                request.resource.data.countryCode != 'CH'
                && request.resource.data.plateLetters.size() > 0
                && request.resource.data.plateLetters.size() <= 2
              )
            )
            && request.resource.data.plateNumbers is string
            && request.resource.data.plateNumbers.size() > 0
            && request.resource.data.plateNumbers.size() <= 6
          )
          || (
            !allowPrivate
            && (
              (
                request.resource.data.showPlate == false
                && request.resource.data.plateRegion == null
                && request.resource.data.plateLetters == null
                && request.resource.data.plateNumbers == null
              )
              || (
                request.resource.data.showPlate == true
                && request.resource.data.plateRegion is string
                && request.resource.data.plateRegion.size() > 0
                && request.resource.data.plateRegion.size() <= 3
                && request.resource.data.plateLetters is string
                && (
                  (
                    request.resource.data.countryCode == 'CH'
                    && request.resource.data.plateLetters.size() == 0
                  )
                  || (
                    request.resource.data.countryCode != 'CH'
                    && request.resource.data.plateLetters.size() > 0
                    && request.resource.data.plateLetters.size() <= 2
                  )
                )
                && request.resource.data.plateNumbers is string
                && request.resource.data.plateNumbers.size() > 0
                && request.resource.data.plateNumbers.size() <= 6
              )
            )
          )
        )
        && request.resource.data.isPrimary is bool
        && request.resource.data.isVerified is bool
        && request.resource.data.get('verificationStatus', 'unverified') in [
          'unverified',
          'draft',
          'inReview',
          'verified',
          'rejected',
          'expired',
        ]
        && request.resource.data.get('verificationLocked', false) is bool
        && isNullableStringWithMax(
          request.resource.data.get('verificationRejectionReason', null),
          600
        )
        && isValidVehicleStatus(request.resource.data.status)
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && (allowPrivate || request.resource.data.status != 'archived')
        && (
          request.resource.data.year == null
          || (
            request.resource.data.year is int
            && request.resource.data.year >= 1886
            && request.resource.data.year <= 2100
          )
        )
        && (
          request.resource.data.firstRegistration == null
          || request.resource.data.firstRegistration is timestamp
        )
        && isNullableStringWithMax(request.resource.data.bodyStyle, 80)
        && isNullableStringWithMax(request.resource.data.engineDescription, 160)
        && (
          request.resource.data.displacementCcm == null
          || (
            request.resource.data.displacementCcm is int
            && request.resource.data.displacementCcm >= 0
            && request.resource.data.displacementCcm <= 20000
          )
        )
        && (
          request.resource.data.horsepower == null
          || (
            request.resource.data.horsepower is int
            && request.resource.data.horsepower >= 0
            && request.resource.data.horsepower <= 5000
          )
        )
        && (
          request.resource.data.kilowatts == null
          || (
            request.resource.data.kilowatts is int
            && request.resource.data.kilowatts >= 0
            && request.resource.data.kilowatts <= 4000
          )
        )
        && isNullableStringWithMax(request.resource.data.fuelType, 80)
        && isNullableStringWithMax(request.resource.data.transmission, 80)
        && isNullableStringWithMax(request.resource.data.drivetrain, 80)
        && request.resource.data.equipment is list
        && request.resource.data.equipment.size() <= 40
        && (
          allowPrivate
          || (
            request.resource.data.get('hsn', null) == null
            && request.resource.data.get('tsn', null) == null
            && request.resource.data.get('vin', null) == null
          )
        )
        && isNullableStringWithMax(request.resource.data.get('hsn', null), 8)
        && isNullableStringWithMax(request.resource.data.get('tsn', null), 8)
        && isNullableStringWithMax(request.resource.data.get('vin', null), 40)
        && (
          request.resource.data.ownedSince == null
          || request.resource.data.ownedSince is timestamp
        )
        && (
          request.resource.data.mileage == null
          || (
            request.resource.data.mileage is int
            && request.resource.data.mileage >= 0
          )
        )
        && request.resource.data.get('profileHighlights', ['plate']) is list
        && request.resource.data.get('profileHighlights', ['plate']).size() <= 5
        && request.resource.data.get('profileHighlights', ['plate']).hasOnly([
          'plate',
          'color',
          'mileage',
          'status',
          'ownedSince',
        ])
        && isNullableStringWithMax(
          request.resource.data.get('heroImageUrl', null),
          1000
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroImagePath', null),
          500
        )
        && (
          request.resource.data.get('heroImageStatus', null) == null
          || request.resource.data.get('heroImageStatus', null) in [
            'notGenerated',
            'queued',
            'generating',
            'ready',
            'failed',
            'regenerationRequired',
          ]
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroSourceHash', null),
          160
        )
        && (
          request.resource.data.get('heroPromptVersion', null) == null
          || request.resource.data.get('heroPromptVersion', null) is int
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroProvider', null),
          80
        )
        && isNullableStringWithMax(
          request.resource.data.get('heroError', null),
          500
        )
        && (
          request.resource.data.get('heroRequestedAt', null) == null
          || request.resource.data.heroRequestedAt is timestamp
        )
        && (
          request.resource.data.get('heroGeneratedAt', null) == null
          || request.resource.data.heroGeneratedAt is timestamp
        )
        && (
          request.resource.data.get('heroRequestWindowStartedAt', null) == null
          || request.resource.data.heroRequestWindowStartedAt is timestamp
        )
        && (
          request.resource.data.get('heroRequestCount', null) == null
          || (
            request.resource.data.heroRequestCount is int
            && request.resource.data.heroRequestCount >= 0
            && request.resource.data.heroRequestCount <= 100
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function vehicleClientFieldsOnly() {
      return changedOnly([
        'brand',
        'model',
        'series',
        'color',
        'countryCode',
        'plateRegion',
        'plateLetters',
        'plateNumbers',
        'isPrimary',
        'status',
        'visibility',
        'showPlate',
        'year',
        'firstRegistration',
        'bodyStyle',
        'engineDescription',
        'displacementCcm',
        'horsepower',
        'kilowatts',
        'fuelType',
        'transmission',
        'drivetrain',
        'equipment',
        'hsn',
        'tsn',
        'vin',
        'ownedSince',
        'mileage',
        'profileHighlights',
        'updatedAt',
      ]);
    }

    function keepsVehicleVerificationState() {
      return request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.get('verificationStatus', 'unverified')
          == resource.data.get('verificationStatus', 'unverified')
        && request.resource.data.get('verificationLocked', false)
          == resource.data.get('verificationLocked', false)
        && request.resource.data.get('verificationRejectionReason', null)
          == resource.data.get('verificationRejectionReason', null);
    }

    function canOwnerEditVehicle() {
      return resource.data.get('verificationLocked', false) != true
        && keepsVehicleVerificationState();
    }

    function isValidVehicleModification(
      userId,
      vehicleId,
      modificationId,
      allowPrivate
    ) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'modificationId',
          'ownerUserId',
          'vehicleId',
          'title',
          'category',
          'manufacturer',
          'product',
          'description',
          'modifiedAt',
          'workshop',
          'costCents',
          'powerChangeHp',
          'isRegistered',
          'documentPaths',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.modificationId == modificationId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.category in [
          'wheels',
          'tires',
          'suspension',
          'brakes',
          'engine',
          'software',
          'exhaust',
          'lighting',
          'body',
          'wrap',
          'interior',
          'soundSystem',
          'other',
        ]
        && isNullableStringWithMax(request.resource.data.manufacturer, 120)
        && isNullableStringWithMax(request.resource.data.product, 120)
        && isNullableStringWithMax(request.resource.data.description, 600)
        && (
          request.resource.data.modifiedAt == null
          || (
            request.resource.data.modifiedAt is timestamp
            && request.resource.data.modifiedAt <= request.time
          )
        )
        && (
          request.resource.data.powerChangeHp == null
          || (
            request.resource.data.powerChangeHp is int
            && request.resource.data.powerChangeHp >= -5000
            && request.resource.data.powerChangeHp <= 5000
          )
        )
        && request.resource.data.isRegistered is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && (
          allowPrivate
          || (
            request.resource.data.get('workshop', null) == null
            && request.resource.data.get('costCents', null) == null
            && request.resource.data.get('documentPaths', null) == null
          )
        )
        && isNullableStringWithMax(
          request.resource.data.get('workshop', null),
          160
        )
        && (
          request.resource.data.get('costCents', null) == null
          || (
            request.resource.data.get('costCents', null) is int
            && request.resource.data.get('costCents', null) >= 0
          )
        )
        && (
          request.resource.data.get('documentPaths', null) == null
          || (
            request.resource.data.get('documentPaths', null) is list
            && request.resource.data.get('documentPaths', null).size() <= 10
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleGalleryMedia(
      userId,
      vehicleId,
      mediaId,
      allowPrivate
    ) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'mediaId',
          'ownerUserId',
          'vehicleId',
          'mediaUrl',
          'mediaPath',
          'mediaType',
          'category',
          'caption',
          'isMain',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.mediaId == mediaId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.mediaUrl.size() <= 1200
        && request.resource.data.mediaPath
          == 'vehicle_gallery/' + userId + '/' + vehicleId + '/' + mediaId
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.category in [
          'exterior',
          'interior',
          'engineBay',
          'details',
          'modifications',
          'beforeAfter',
          'documentation',
        ]
        && isNullableStringWithMax(request.resource.data.caption, 300)
        && request.resource.data.isMain is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleTimelineEntry(
      userId,
      vehicleId,
      entryId,
      allowPrivate
    ) {
      return existsAfter(
          /databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)
        )
        && request.resource.data.keys().hasOnly([
          'entryId',
          'ownerUserId',
          'vehicleId',
          'type',
          'title',
          'description',
          'eventDate',
          'mediaUrls',
          'linkedPostId',
          'linkedModificationId',
          'isAutomaticallyCreated',
          'visibility',
          'isDeleted',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.entryId == entryId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.type in [
          'vehicleCreated',
          'vehicleAcquired',
          'registered',
          'modificationAdded',
          'maintenance',
          'repair',
          'wheelsInstalled',
          'mileageMilestone',
          'trip',
          'meet',
          'seasonStart',
          'seasonEnd',
          'sold',
          'archived',
          'statusChanged',
          'custom',
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && isNullableStringWithMax(request.resource.data.description, 600)
        && request.resource.data.eventDate is timestamp
        && request.resource.data.eventDate <= request.time
        && request.resource.data.mediaUrls is list
        && request.resource.data.mediaUrls.size() <= 10
        && isNullableStringWithMax(request.resource.data.linkedPostId, 160)
        && isNullableStringWithMax(
          request.resource.data.linkedModificationId,
          160
        )
        && request.resource.data.isAutomaticallyCreated is bool
        && request.resource.data.visibility in ['contacts', 'onlyMe']
        && (allowPrivate || request.resource.data.visibility == 'contacts')
        && request.resource.data.isDeleted is bool
        && (allowPrivate || request.resource.data.isDeleted == false)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidVehicleEncounterCreate(encounterId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'encounterId',
          'initiatorUserId',
          'recipientUserId',
          'initiatorVehicleId',
          'recipientVehicleId',
          'initiatorVehicleLabel',
          'recipientVehicleLabel',
          'participantUserIds',
          'initiatorPhotoUrl',
          'recipientPhotoUrl',
          'type',
          'status',
          'locationLabel',
          'encounterDate',
          'linkedPostId',
          'confirmedAt',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.encounterId == encounterId
        && request.resource.data.initiatorUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.recipientUserId != request.auth.uid
        && request.resource.data.initiatorVehicleId is string
        && request.resource.data.initiatorVehicleId.size() > 0
        && request.resource.data.initiatorVehicleId.size() <= 160
        && request.resource.data.recipientVehicleId is string
        && request.resource.data.recipientVehicleId.size() > 0
        && request.resource.data.recipientVehicleId.size() <= 160
        && encounterId in [
          request.resource.data.initiatorUserId + '_' + request.resource.data.initiatorVehicleId + '__' + request.resource.data.recipientUserId + '_' + request.resource.data.recipientVehicleId,
          request.resource.data.recipientUserId + '_' + request.resource.data.recipientVehicleId + '__' + request.resource.data.initiatorUserId + '_' + request.resource.data.initiatorVehicleId,
        ]
        && request.resource.data.participantUserIds is list
        && request.resource.data.participantUserIds.size() == 2
        && request.resource.data.participantUserIds.hasAll([
          request.resource.data.initiatorUserId,
          request.resource.data.recipientUserId,
        ])
        && request.resource.data.initiatorVehicleLabel is string
        && request.resource.data.initiatorVehicleLabel.size() > 0
        && request.resource.data.initiatorVehicleLabel.size() <= 240
        && request.resource.data.recipientVehicleLabel is string
        && request.resource.data.recipientVehicleLabel.size() > 0
        && request.resource.data.recipientVehicleLabel.size() <= 240
        && isNullableStringWithMax(request.resource.data.initiatorPhotoUrl, 1000)
        && isNullableStringWithMax(request.resource.data.recipientPhotoUrl, 1000)
        && request.resource.data.type in [
          'spotted',
          'meet',
          'trip',
          'event',
          'other',
        ]
        && request.resource.data.status == 'requested'
        && isNullableStringWithMax(request.resource.data.locationLabel, 120)
        && request.resource.data.encounterDate is timestamp
        && isNullableStringWithMax(request.resource.data.linkedPostId, 160)
        && request.resource.data.confirmedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && hasActiveProfileConnection(request.resource.data.recipientUserId)
        && exists(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)/vehicles/$(request.resource.data.initiatorVehicleId)
        )
        && exists(
          /databases/$(database)/documents/public_profiles/$(request.resource.data.recipientUserId)/vehicles/$(request.resource.data.recipientVehicleId)
        );
    }

    function isValidVehicleEncounterUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participantUserIds
        && (
          (
            request.auth.uid == resource.data.recipientUserId
            && resource.data.status == 'requested'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.confirmedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'confirmedAt', 'updatedAt'])
          )
          || (
            request.auth.uid == resource.data.recipientUserId
            && resource.data.status == 'requested'
            && request.resource.data.status == 'declined'
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.status == 'confirmed'
            && request.resource.data.status == 'removed'
            && request.resource.data.updatedAt is timestamp
            && changedOnly(['status', 'updatedAt'])
          )
        );
    }

    function isValidPublicVehicleEncounter(
      userId,
      vehicleId,
      encounterId
    ) {
      let encounter = getAfter(
        /databases/$(database)/documents/vehicle_encounters/$(encounterId)
      );
      return request.resource.data.keys().hasOnly([
          'encounterId',
          'initiatorUserId',
          'recipientUserId',
          'initiatorVehicleId',
          'recipientVehicleId',
          'initiatorVehicleLabel',
          'recipientVehicleLabel',
          'participantUserIds',
          'initiatorPhotoUrl',
          'recipientPhotoUrl',
          'type',
          'status',
          'locationLabel',
          'encounterDate',
          'linkedPostId',
          'confirmedAt',
          'createdAt',
          'updatedAt',
        ])
        && encounter.data.status == 'confirmed'
        && request.auth.uid in encounter.data.participantUserIds
        && (
          (
            userId == encounter.data.initiatorUserId
            && vehicleId == encounter.data.initiatorVehicleId
          )
          || (
            userId == encounter.data.recipientUserId
            && vehicleId == encounter.data.recipientVehicleId
          )
        )
        && request.resource.data.encounterId == encounterId
        && request.resource.data.initiatorUserId
          == encounter.data.initiatorUserId
        && request.resource.data.recipientUserId
          == encounter.data.recipientUserId
        && request.resource.data.initiatorVehicleId
          == encounter.data.initiatorVehicleId
        && request.resource.data.recipientVehicleId
          == encounter.data.recipientVehicleId
        && request.resource.data.participantUserIds
          == encounter.data.participantUserIds
        && request.resource.data.initiatorVehicleLabel
          == encounter.data.initiatorVehicleLabel
        && request.resource.data.recipientVehicleLabel
          == encounter.data.recipientVehicleLabel
        && request.resource.data.initiatorPhotoUrl
          == encounter.data.initiatorPhotoUrl
        && request.resource.data.recipientPhotoUrl
          == encounter.data.recipientPhotoUrl
        && request.resource.data.type == encounter.data.type
        && request.resource.data.status == 'confirmed'
        && request.resource.data.locationLabel == encounter.data.locationLabel
        && request.resource.data.encounterDate == encounter.data.encounterDate
        && request.resource.data.linkedPostId == encounter.data.linkedPostId
        && request.resource.data.confirmedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function canDeletePublicVehicleEncounter(encounterId) {
      let encounter = getAfter(
        /databases/$(database)/documents/vehicle_encounters/$(encounterId)
      );
      return isSignedIn()
        && request.auth.uid in encounter.data.participantUserIds
        && encounter.data.status == 'removed';
    }

    function profileAllowsAccess(userId) {
      return exists(
          /databases/$(database)/documents/public_profiles/$(userId)
        )
        && get(
          /databases/$(database)/documents/public_profiles/$(userId)
        ).data.profileAccessEnabled == true;
    }

    function profileAllowsVehicleAccess(userId) {
      return profileAllowsAccess(userId)
        && get(
          /databases/$(database)/documents/public_profiles/$(userId)
        ).data.showVehicleOnPublicProfile == true;
    }

    function isActiveProfileConnectionData(connectionData, targetUserId) {
      return isSignedIn()
        && targetUserId != request.auth.uid
        && connectionData.status == 'active'
        && connectionData.participants is list
        && connectionData.participants.size() == 2
        && connectionData.participants.hasAll([
          request.auth.uid,
          targetUserId,
        ])
        && connectionData.requestId is string
        && connectionData.chatId is string
        && exists(
          /databases/$(database)/documents/contact_requests/$(connectionData.requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(connectionData.requestId)
        ).data.status == 'accepted'
        && exists(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        )
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.requestId == connectionData.requestId
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.participants.hasAll([request.auth.uid, targetUserId])
        && isOpenChatStatus(
          get(
            /databases/$(database)/documents/chats/$(connectionData.chatId)
          ).data.status
        )
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.get('deletedBy', {}).get(request.auth.uid, false) != true
        && get(
          /databases/$(database)/documents/chats/$(connectionData.chatId)
        ).data.get('deletedBy', {}).get(targetUserId, false) != true;
    }

    function hasActiveProfileConnectionById(connectionId, targetUserId) {
      return exists(
          /databases/$(database)/documents/profile_connections/$(connectionId)
        )
        && isActiveProfileConnectionData(
          get(
            /databases/$(database)/documents/profile_connections/$(connectionId)
          ).data,
          targetUserId
        );
    }

    function hasActiveProfileConnection(targetUserId) {
      return isOwner(targetUserId)
        || (
          isSignedIn()
          && (
            hasActiveProfileConnectionById(
              request.auth.uid + '_' + targetUserId,
              targetUserId
            )
            || hasActiveProfileConnectionById(
              targetUserId + '_' + request.auth.uid,
              targetUserId
            )
          )
        );
    }

    function isValidProfileConnectionWrite(connectionId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'connectionId',
          'userAId',
          'userBId',
          'participants',
          'requestId',
          'chatId',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.connectionId == connectionId
        && request.resource.data.userAId is string
        && request.resource.data.userBId is string
        && request.resource.data.userAId != request.resource.data.userBId
        && connectionId in [
          request.resource.data.userAId + '_' + request.resource.data.userBId,
          request.resource.data.userBId + '_' + request.resource.data.userAId,
        ]
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.userAId,
          request.resource.data.userBId,
        ])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status == 'active'
        && request.resource.data.requestId is string
        && request.resource.data.chatId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.status == 'accepted'
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.senderUserId in request.resource.data.participants
        && get(
          /databases/$(database)/documents/contact_requests/$(request.resource.data.requestId)
        ).data.receiverUserId in request.resource.data.participants
        && exists(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        )
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.requestId == request.resource.data.requestId
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.participants.hasAll(request.resource.data.participants)
        && isOpenChatStatus(
          get(
            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
          ).data.status
        );
    }

    function followRelationshipId(followerUserId, followedUserId) {
      return followerUserId + '_' + followedUserId;
    }

    function isFollowing(followerUserId, followedUserId) {
      let relationshipId = followRelationshipId(
        followerUserId,
        followedUserId
      );
      return exists(
          /databases/$(database)/documents/follow_relationships/$(relationshipId)
        )
        && get(
          /databases/$(database)/documents/follow_relationships/$(relationshipId)
        ).data.status == 'following';
    }

    function canSeeProfileList(profileUserId, visibility) {
      return request.auth.uid == profileUserId
        || (
          visibility == 'contacts'
          && hasActiveProfileConnection(profileUserId)
        )
        || (
          visibility == 'followers'
          && hasActiveProfileConnection(profileUserId)
          && isFollowing(request.auth.uid, profileUserId)
        );
    }

    function canReadFollowRelationship(relationshipData) {
      return isSignedIn()
        && (
          request.auth.uid == relationshipData.followerUserId
          || request.auth.uid == relationshipData.followedUserId
          || (
            profileAllowsAccess(relationshipData.followedUserId)
            && canSeeProfileList(
              relationshipData.followedUserId,
              get(
                /databases/$(database)/documents/public_profiles/$(relationshipData.followedUserId)
              ).data.followersVisibility
            )
          )
          || (
            profileAllowsAccess(relationshipData.followerUserId)
            && canSeeProfileList(
              relationshipData.followerUserId,
              get(
                /databases/$(database)/documents/public_profiles/$(relationshipData.followerUserId)
              ).data.followingVisibility
            )
          )
        );
    }

    function isValidFollowRelationshipCreate(relationshipId) {
      let followerProfile = get(
        /databases/$(database)/documents/public_profiles/$(request.resource.data.followerUserId)
      );
      let targetProfile = get(
        /databases/$(database)/documents/public_profiles/$(request.resource.data.followedUserId)
      );
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'relationshipId',
          'followerUserId',
          'followedUserId',
          'followerDisplayName',
          'followedDisplayName',
          'followerPhotoUrl',
          'followedPhotoUrl',
          'status',
          'createdAt',
          'updatedAt',
          'acceptedAt',
        ])
        && request.resource.data.relationshipId == relationshipId
        && request.resource.data.followerUserId == request.auth.uid
        && request.resource.data.followedUserId is string
        && request.resource.data.followedUserId != request.auth.uid
        && request.resource.data.followerDisplayName
          == followerProfile.data.displayName
        && request.resource.data.followedDisplayName
          == targetProfile.data.displayName
        && request.resource.data.followerDisplayName is string
        && request.resource.data.followerDisplayName.size() > 0
        && request.resource.data.followerDisplayName.size() <= 80
        && request.resource.data.followedDisplayName is string
        && request.resource.data.followedDisplayName.size() > 0
        && request.resource.data.followedDisplayName.size() <= 80
        && request.resource.data.followerPhotoUrl
          == followerProfile.data.get('photoUrl', null)
        && request.resource.data.followedPhotoUrl
          == targetProfile.data.get('photoUrl', null)
        && isNullableStringWithMax(
          request.resource.data.followerPhotoUrl,
          1000
        )
        && isNullableStringWithMax(
          request.resource.data.followedPhotoUrl,
          1000
        )
        && relationshipId == followRelationshipId(
          request.resource.data.followerUserId,
          request.resource.data.followedUserId
        )
        && profileAllowsAccess(request.resource.data.followedUserId)
        && hasActiveProfileConnection(request.resource.data.followedUserId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            targetProfile.data.isPrivateProfile == true
            && request.resource.data.status == 'requested'
            && request.resource.data.acceptedAt == null
          )
          || (
            targetProfile.data.isPrivateProfile == false
            && request.resource.data.status == 'following'
            && request.resource.data.acceptedAt is timestamp
          )
        );
    }

    function isValidFollowRequestAccept() {
      return isSignedIn()
        && request.auth.uid == resource.data.followedUserId
        && resource.data.status == 'requested'
        && request.resource.data.status == 'following'
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'acceptedAt', 'updatedAt'])
        && hasActiveProfileConnection(resource.data.followerUserId);
    }

    function isValidFollowRelationshipDelete() {
      return isSignedIn()
        && (
          request.auth.uid == resource.data.followerUserId
          || request.auth.uid == resource.data.followedUserId
        );
    }

    function contactRequestDocumentId() {
      return request.auth.uid
        + '_' + request.resource.data.countryCode
        + '_' + request.resource.data.vehicleId;
    }

    function contactRequestOptionalProjectionMatches(value, expected) {
      return value == null || value == expected;
    }

    function contactRequestPlateProjectionMatches(value, plate) {
      return value == null
        || value == plate.get('displayPlate', null)
        || value == plate.get('plateDisplayLabel', null);
    }

    function contactRequestMatchesActivePlate() {
      let plateId = request.resource.data.countryCode
        + '_' + request.resource.data.plateKey;
      let platePath = /databases/$(database)/documents/plates/$(plateId);
      let plate = get(platePath).data;
      return exists(platePath)
        && plate.ownerUserId == request.resource.data.receiverUserId
        && plate.vehicleId == request.resource.data.vehicleId
        && plate.countryCode == request.resource.data.countryCode
        && plate.plateKey == request.resource.data.plateKey
        && plate.isActive == true
        && plate.isDeleted == false
        && plate.isVerified == true
        && plate.allowContactRequests == true
        && contactRequestPlateProjectionMatches(
          request.resource.data.get('displayPlate', null),
          plate
        )
        && contactRequestOptionalProjectionMatches(
          request.resource.data.get('vehicleBrand', null),
          plate.get('vehicleBrand', null)
        )
        && contactRequestOptionalProjectionMatches(
          request.resource.data.get('vehicleModel', null),
          plate.get('vehicleModel', null)
        )
        && contactRequestOptionalProjectionMatches(
          request.resource.data.get('vehicleColor', null),
          plate.get('vehicleColor', null)
        )
        && contactRequestOptionalProjectionMatches(
          request.resource.data.get('vehicleLabel', null),
          plate.get('vehicleLabel', null)
        );
    }

    function contactRequestVisibilityAllowsCreate() {
      let receiverUserId = request.resource.data.receiverUserId;
      return !exists(
          /databases/$(database)/documents/users/$(receiverUserId)/settings/visibility
        )
        || get(
          /databases/$(database)/documents/users/$(receiverUserId)/settings/visibility
        ).data.allowContactRequests != false;
    }

    function requesterIsVerifiedForContactFilter() {
      return exists(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)
        ).data.isVerified == true;
    }

    function requesterHasVerifiedVehicle(vehicleId) {
      return vehicleId is string
        && vehicleId.size() >= 1
        && vehicleId.size() <= 160
        && exists(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)/vehicles/$(vehicleId)
        )
        && get(
          /databases/$(database)/documents/public_profiles/$(request.auth.uid)/vehicles/$(vehicleId)
        ).data.isVerified == true;
    }

    function contactRequestFiltersAllowCreate() {
      let receiverUserId = request.resource.data.receiverUserId;
      return !exists(
          /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
        )
        || (
          (
            get(
              /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
            ).data.contactRequestQuietModeUntil == null
            || get(
              /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
            ).data.contactRequestQuietModeUntil <= request.time
          )
          && (
            get(
              /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
            ).data.get('requesterVerificationLevel',
              get(
                /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
              ).data.requireVerifiedRequester == true
                || get(
                  /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
                ).data.autoRejectUnverified == true
                ? 'identityVerified'
                : 'all') != 'identityVerified'
            || requesterIsVerifiedForContactFilter()
          )
          && (
            !(request.resource.data.requestReason is string)
            || get(
              /databases/$(database)/documents/users/$(receiverUserId)/settings/contact_filters
            ).data.allowedContactReasons.hasAny([
              request.resource.data.requestReason
            ])
          )
        );
    }

    function isValidContactRequestCreate(requestId) {
      return isSignedIn()
        && requestId == contactRequestDocumentId()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.receiverUserId is string
        && request.resource.data.receiverUserId != request.auth.uid
        && request.resource.data.targetUserId == request.resource.data.receiverUserId
        && request.resource.data.countryCode in ['DE', 'AT', 'CH']
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId.size() >= 1
        && request.resource.data.vehicleId.size() <= 160
        && requesterHasVerifiedVehicle(
          request.resource.data.get('senderVehicleId', null)
        )
        && request.resource.data.plateKey is string
        && request.resource.data.plateKey.matches('^[A-ZÄÖÜ0-9]{2,20}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isDeleted == false
        && contactRequestMatchesActivePlate()
        && contactRequestVisibilityAllowsCreate()
        && contactRequestFiltersAllowCreate();
    }

    function isValidContactRequestAccept(requestId) {
      return request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.auth.uid == resource.data.receiverUserId
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && changedOnly(['status', 'updatedAt'])
          ) ||
          (
            request.auth.uid == resource.data.receiverUserId
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && request.resource.data.chatId == 'request_' + requestId
            && changedOnly(['status', 'updatedAt', 'chatId'])
          ) ||
          (
            (
              request.auth.uid == resource.data.receiverUserId ||
              request.auth.uid == resource.data.senderUserId
            )
            && resource.data.status == 'accepted'
            && request.resource.data.chatId == 'request_' + requestId
            && changedOnly(['updatedAt', 'chatId'])
          )
        );
    }

    function isValidContactRequestDecline() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.receiverUserId
        && request.resource.data.status == 'declined'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestWithdraw() {
      return resource.data.status == 'pending'
        && request.auth.uid == resource.data.senderUserId
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.updatedAt is timestamp
        && changedOnly(['status', 'updatedAt']);
    }

    function isValidContactRequestResend(requestId) {
      return resource.data.expiresAt is timestamp
        && resource.data.expiresAt <= request.time
        && request.auth.uid == resource.data.senderUserId
        && request.resource.data.senderUserId == resource.data.senderUserId
        && request.resource.data.receiverUserId == resource.data.receiverUserId
        && request.resource.data.targetUserId == resource.data.targetUserId
        && request.resource.data.countryCode == resource.data.countryCode
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.plateKey == resource.data.plateKey
        && isValidContactRequestCreate(requestId);
    }

    function isValidContactRequestUpdate(requestId) {
      return isSignedIn()
        && (
          isValidContactRequestAccept(requestId) ||
          isValidContactRequestDecline() ||
          isValidContactRequestWithdraw() ||
          isValidContactRequestResend(requestId)
        );
    }

    function isValidChatCreateForRequestData(chatId, requestId, contactRequestData) {
      return isSignedIn()
        && chatId == 'request_' + requestId
        && request.resource.data.requestId == requestId
        && request.resource.data.get('countryCode', null)
          == contactRequestData.get('countryCode', null)
        && request.resource.data.get('vehicleId', null)
          == contactRequestData.get('vehicleId', null)
        && request.resource.data.get('displayPlate', null)
          == contactRequestData.get('displayPlate', null)
        && request.resource.data.get('vehicleBrand', null)
          == contactRequestData.get('vehicleBrand', null)
        && request.resource.data.get('vehicleModel', null)
          == contactRequestData.get('vehicleModel', null)
        && request.resource.data.get('vehicleColor', null)
          == contactRequestData.get('vehicleColor', null)
        && request.resource.data.get('vehicleLabel', null)
          == contactRequestData.get('vehicleLabel', null)
        && contactRequestData.status in ['pending', 'accepted']
        && (
          contactRequestData.status == 'accepted' ||
          contactRequestData.expiresAt > request.time
        )
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          contactRequestData.senderUserId,
          contactRequestData.receiverUserId,
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.isDeleted == false
        && (
          contactRequestData.receiverUserId == request.auth.uid ||
          contactRequestData.senderUserId == request.auth.uid
        );
    }

    function isValidChatCreateForExistingRequest(chatId, requestId) {
      return exists(/databases/$(database)/documents/contact_requests/$(requestId))
        && isValidChatCreateForRequestData(
        chatId,
        requestId,
        get(/databases/$(database)/documents/contact_requests/$(requestId)).data
      );
    }

    function isValidChatCreateForPendingRequestWrite(chatId, requestId) {
      let contactRequest = getAfter(/databases/$(database)/documents/contact_requests/$(requestId));

      return isValidChatCreateForRequestData(
        chatId,
        requestId,
        contactRequest.data
      );
    }

    function isValidChatCreateForRequest(chatId, requestId) {
      return isValidChatCreateForExistingRequest(chatId, requestId)
        || isValidChatCreateForPendingRequestWrite(chatId, requestId);
    }

    function verificationStatus(data, key) {
      return data.get('documentStatuses', {}).get(key, 'missing');
    }

    function isProtectedVerificationStatus(status) {
      return status in ['inReview', 'verified'];
    }

    function hasProtectedVerificationData() {
      return resource.data.get('documentStatuses', {}).values().hasAny([
        'inReview',
        'verified'
      ]);
    }

    function keepsProtectedVerificationData() {
      let statusChanged = request.resource.data.documentStatuses
        .diff(resource.data.get('documentStatuses', {}))
        .affectedKeys();
      let pathChanged = request.resource.data.documentStoragePaths
        .diff(resource.data.get('documentStoragePaths', {}))
        .affectedKeys();
      let identityProtected = isProtectedVerificationStatus(
          verificationStatus(resource.data, 'identityFront')
        ) || isProtectedVerificationStatus(
          verificationStatus(resource.data, 'identityBack')
        );
      let driverProtected = isProtectedVerificationStatus(
          verificationStatus(resource.data, 'driverLicenseFront')
        ) || isProtectedVerificationStatus(
          verificationStatus(resource.data, 'driverLicenseBack')
        );
      let vehicleProtected = isProtectedVerificationStatus(
          verificationStatus(resource.data, 'vehicleFront')
        ) || isProtectedVerificationStatus(
          verificationStatus(resource.data, 'vehicleBack')
        );
      return (!statusChanged.hasAny(['identityFront'])
          || request.resource.data.documentStatuses.identityFront
            in ['missing', 'uploaded'])
        && (!statusChanged.hasAny(['identityBack'])
          || request.resource.data.documentStatuses.identityBack
            in ['missing', 'uploaded'])
        && (!statusChanged.hasAny(['driverLicenseFront'])
          || request.resource.data.documentStatuses.driverLicenseFront
            in ['missing', 'uploaded'])
        && (!statusChanged.hasAny(['driverLicenseBack'])
          || request.resource.data.documentStatuses.driverLicenseBack
            in ['missing', 'uploaded'])
        && (!statusChanged.hasAny(['vehicleFront'])
          || request.resource.data.documentStatuses.vehicleFront
            in ['missing', 'uploaded'])
        && (!statusChanged.hasAny(['vehicleBack'])
          || request.resource.data.documentStatuses.vehicleBack
            in ['missing', 'uploaded'])
        && (!identityProtected
          || (!statusChanged.hasAny(['identityFront', 'identityBack'])
            && !pathChanged.hasAny(['identityFront', 'identityBack'])
            && request.resource.data.identityDocumentType
              == resource.data.get('identityDocumentType', 'identityCard')
            && request.resource.data.documentExpiresAt.get('identity', null)
              == resource.data.get('documentExpiresAt', {}).get('identity', null)))
        && (!driverProtected
          || (!statusChanged.hasAny([
              'driverLicenseFront',
              'driverLicenseBack'
            ])
            && !pathChanged.hasAny([
              'driverLicenseFront',
              'driverLicenseBack'
            ])
            && request.resource.data.documentExpiresAt.get('driverLicense', null)
              == resource.data.get('documentExpiresAt', {}).get('driverLicense', null)))
        && (!vehicleProtected
          || (!statusChanged.hasAny(['vehicleFront', 'vehicleBack'])
            && !pathChanged.hasAny(['vehicleFront', 'vehicleBack'])
            && request.resource.data.vehicleId == resource.data.vehicleId
            && request.resource.data.vehicleRelationship
              == resource.data.vehicleRelationship));
    }

    function isValidVerificationDraftMap(userId, requestId) {
      let paths = request.resource.data.documentStoragePaths;
      let statuses = request.resource.data.documentStatuses;
      let reasons = request.resource.data.documentRejectionReasons;
      let expirations = request.resource.data.documentExpiresAt;
      return isSignedIn()
        && request.auth.uid == userId
        && requestId == userId
        && request.resource.data.requestId == userId
        && request.resource.data.userId == userId
        && request.resource.data.profilePath
          == 'users/' + userId + '/profiles/main'
        && request.resource.data.status == 'draft'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.identityDocumentType in [
          'identityCard',
          'passport',
          'residencePermit'
        ]
        && paths is map
        && paths.keys().hasOnly([
          'identityFront',
          'identityBack',
          'driverLicenseFront',
          'driverLicenseBack',
          'vehicleFront',
          'vehicleBack'
        ])
        && (!('identityFront' in paths) || paths.identityFront in [
          'profile_documents/' + userId + '/identityFront/identityFront.png',
          'profile_documents/' + userId + '/identityFront/identityFront.jpg'
        ])
        && (!('identityBack' in paths) || paths.identityBack in [
          'profile_documents/' + userId + '/identityBack/identityBack.png',
          'profile_documents/' + userId + '/identityBack/identityBack.jpg'
        ])
        && (!('driverLicenseFront' in paths) || paths.driverLicenseFront in [
          'profile_documents/' + userId
            + '/driverLicenseFront/driverLicenseFront.png',
          'profile_documents/' + userId
            + '/driverLicenseFront/driverLicenseFront.jpg'
        ])
        && (!('driverLicenseBack' in paths) || paths.driverLicenseBack in [
          'profile_documents/' + userId
            + '/driverLicenseBack/driverLicenseBack.png',
          'profile_documents/' + userId
            + '/driverLicenseBack/driverLicenseBack.jpg'
        ])
        && (!('vehicleFront' in paths) || paths.vehicleFront in [
          'profile_documents/' + userId + '/vehicleFront/vehicleFront.png',
          'profile_documents/' + userId + '/vehicleFront/vehicleFront.jpg'
        ])
        && (!('vehicleBack' in paths) || paths.vehicleBack in [
          'profile_documents/' + userId + '/vehicleBack/vehicleBack.png',
          'profile_documents/' + userId + '/vehicleBack/vehicleBack.jpg'
        ])
        && statuses is map
        && statuses.keys().hasOnly([
          'identityFront',
          'identityBack',
          'driverLicenseFront',
          'driverLicenseBack',
          'vehicleFront',
          'vehicleBack'
        ])
        && (!('identityFront' in statuses)
          || statuses.identityFront in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && (!('identityBack' in statuses)
          || statuses.identityBack in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && (!('driverLicenseFront' in statuses)
          || statuses.driverLicenseFront in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && (!('driverLicenseBack' in statuses)
          || statuses.driverLicenseBack in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && (!('vehicleFront' in statuses)
          || statuses.vehicleFront in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && (!('vehicleBack' in statuses)
          || statuses.vehicleBack in [
            'missing', 'uploaded', 'inReview', 'verified', 'rejected', 'expired'
          ])
        && reasons is map
        && reasons.keys().hasOnly([
          'identityFront',
          'identityBack',
          'driverLicenseFront',
          'driverLicenseBack',
          'vehicleFront',
          'vehicleBack'
        ])
        && (!('identityFront' in reasons)
          || isNullableStringWithMax(reasons.identityFront, 600))
        && (!('identityBack' in reasons)
          || isNullableStringWithMax(reasons.identityBack, 600))
        && (!('driverLicenseFront' in reasons)
          || isNullableStringWithMax(reasons.driverLicenseFront, 600))
        && (!('driverLicenseBack' in reasons)
          || isNullableStringWithMax(reasons.driverLicenseBack, 600))
        && (!('vehicleFront' in reasons)
          || isNullableStringWithMax(reasons.vehicleFront, 600))
        && (!('vehicleBack' in reasons)
          || isNullableStringWithMax(reasons.vehicleBack, 600))
        && expirations is map
        && expirations.keys().hasOnly(['identity', 'driverLicense'])
        && (!('identity' in expirations)
          || (expirations.identity is timestamp
            && expirations.identity > request.time))
        && (!('driverLicense' in expirations)
          || (expirations.driverLicense is timestamp
            && expirations.driverLicense > request.time))
        && isNullableStringWithMax(request.resource.data.vehicleId, 160)
        && request.resource.data.vehicleRelationship in [
          'owner',
          'leasingCompany',
          'leasingCompanyFamily',
          'authorizedUser',
        ]
        && request.resource.data.authorizationConfirmed is bool
        && request.resource.data.vehicleAssignmentConfirmed is bool
        && request.resource.data.consentVersion == null
        && request.resource.data.consentAcceptedAt == null
        && request.resource.data.submittedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.retentionUntil == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'requestId',
          'userId',
          'profilePath',
          'status',
          'displayName',
          'identityDocumentType',
          'documentStoragePaths',
          'documentStatuses',
          'documentRejectionReasons',
          'documentExpiresAt',
          'vehicleId',
          'vehicleRelationship',
          'vehicleAssignmentConfirmed',
          'authorizationConfirmed',
          'consentVersion',
          'consentAcceptedAt',
          'submittedAt',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason',
          'retentionUntil',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isValidVerificationDraftCreate(requestId) {
      return isSignedIn()
        && isValidVerificationDraftMap(request.auth.uid, requestId)
        && !request.resource.data.documentStoragePaths.keys().hasAny([
          'driverLicenseFront',
          'driverLicenseBack'
        ])
        && !request.resource.data.documentStatuses.keys().hasAny([
          'driverLicenseFront',
          'driverLicenseBack'
        ])
        && !request.resource.data.documentRejectionReasons.keys().hasAny([
          'driverLicenseFront',
          'driverLicenseBack'
        ])
        && !request.resource.data.documentExpiresAt.keys().hasAny([
          'driverLicense'
        ])
        && request.resource.data.documentRejectionReasons.size() == 0
        && request.resource.data.documentStatuses.values().hasOnly([
          'missing',
          'uploaded'
        ]);
    }

    function isValidTargetedVerificationResubmission(requestId) {
      return isSignedIn()
        && request.auth.uid == requestId
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['rejected', 'expired']
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.profilePath == resource.data.profilePath
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.status == 'draft'
        && request.resource.data.identityDocumentType
          == resource.data.get('identityDocumentType', 'identityCard')
        && request.resource.data.documentStoragePaths
          == resource.data.get('documentStoragePaths', {})
        && request.resource.data.documentRejectionReasons
          == resource.data.get('documentRejectionReasons', {})
        && request.resource.data.documentExpiresAt
          == resource.data.get('documentExpiresAt', {})
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.vehicleRelationship
          == resource.data.vehicleRelationship
        && request.resource.data.vehicleAssignmentConfirmed is bool
        && request.resource.data.authorizationConfirmed is bool
        && request.resource.data.consentVersion == null
        && request.resource.data.consentAcceptedAt == null
        && request.resource.data.submittedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.retentionUntil == null
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.documentStatuses is map
        && request.resource.data.documentStatuses.keys().hasOnly([
          'identityFront',
          'identityBack',
          'driverLicenseFront',
          'driverLicenseBack',
          'vehicleFront',
          'vehicleBack'
        ])
        && keepsProtectedVerificationData()
        && request.resource.data.keys().hasOnly([
          'requestId',
          'userId',
          'profilePath',
          'status',
          'displayName',
          'identityDocumentType',
          'documentStoragePaths',
          'documentStatuses',
          'documentRejectionReasons',
          'documentExpiresAt',
          'vehicleId',
          'vehicleRelationship',
          'vehicleAssignmentConfirmed',
          'authorizationConfirmed',
          'consentVersion',
          'consentAcceptedAt',
          'submittedAt',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason',
          'retentionUntil',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isValidVerificationDraftUpdate(requestId) {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['draft', 'rejected', 'expired']
        && isValidVerificationDraftMap(request.auth.uid, requestId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.documentRejectionReasons
          == resource.data.get('documentRejectionReasons', {})
        && request.resource.data.documentStoragePaths
            .get('driverLicenseFront', null)
          == resource.data.get('documentStoragePaths', {})
            .get('driverLicenseFront', null)
        && request.resource.data.documentStoragePaths
            .get('driverLicenseBack', null)
          == resource.data.get('documentStoragePaths', {})
            .get('driverLicenseBack', null)
        && request.resource.data.documentStatuses
            .get('driverLicenseFront', null)
          == resource.data.get('documentStatuses', {})
            .get('driverLicenseFront', null)
        && request.resource.data.documentStatuses
            .get('driverLicenseBack', null)
          == resource.data.get('documentStatuses', {})
            .get('driverLicenseBack', null)
        && request.resource.data.documentExpiresAt.get('driverLicense', null)
          == resource.data.get('documentExpiresAt', {})
            .get('driverLicense', null)
        && (!hasProtectedVerificationData()
          || keepsProtectedVerificationData());
    }

    function hasValidOwnerProfileCreateVerificationFields() {
      return request.resource.data.verificationStatus in ['unverified', 'draft']
        && request.resource.data.verificationSubmittedAt == null
        && request.resource.data.verificationReviewedAt == null
        && request.resource.data.verificationRejectionReason == null;
    }

    function keepsOwnerProfileVerificationFields() {
      let currentStatus = resource.data.get('verificationStatus', null);
      let currentSubmittedAt =
        resource.data.get('verificationSubmittedAt', null);
      let currentReviewedAt =
        resource.data.get('verificationReviewedAt', null);
      let currentRejectionReason =
        resource.data.get('verificationRejectionReason', null);
      let keepsExistingValues =
        request.resource.data.verificationStatus == currentStatus
        && request.resource.data.verificationSubmittedAt
          == currentSubmittedAt
        && request.resource.data.verificationReviewedAt == currentReviewedAt
        && request.resource.data.verificationRejectionReason
          == currentRejectionReason;
      let initializesLegacyProfile = currentStatus == null
        && currentSubmittedAt == null
        && currentReviewedAt == null
        && currentRejectionReason == null
        && request.resource.data.verificationStatus == 'unverified'
        && request.resource.data.verificationSubmittedAt == null
        && request.resource.data.verificationReviewedAt == null
        && request.resource.data.verificationRejectionReason == null;
      return keepsExistingValues || initializesLegacyProfile;
    }

    function isValidOwnerProfileCreate(userId, profileId) {
      return isOwner(userId)
        && profileId == 'main'
        && request.resource.data.uid == userId
        && hasValidPersonalDataState()
        && hasValidOwnerProfileCreateVerificationFields();
    }

    function isValidOwnerProfileUpdate(userId, profileId) {
      return isOwner(userId)
        && profileId == 'main'
        && request.resource.data.uid == userId
        && hasValidPersonalDataState()
        && keepsOwnerProfileVerificationFields();
    }

    function isUndeletedChatParticipant(chatData) {
      return isSignedIn()
        && request.auth.uid in chatData.participants
        && chatData.get('deletedBy', {})[request.auth.uid] != true;
    }

    function isOpenUndeletedChatParticipant(chatData) {
      return isUndeletedChatParticipant(chatData)
        && isOpenChatStatus(chatData.status);
    }

    function isRequestBasedChat(chatData) {
      return chatData.get('requestId', '') is string
        && chatData.get('requestId', '').size() > 0;
    }

    function hasAcceptedContactRequestForChat(chatData) {
      let requestId = chatData.get('requestId', '');

      return isRequestBasedChat(chatData)
        && exists(
          /databases/$(database)/documents/contact_requests/$(requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(requestId)
        ).data.status == 'accepted';
    }

    function canSendRegularChatMessages(chatData) {
      return !isRequestBasedChat(chatData)
        || hasAcceptedContactRequestForChat(chatData);
    }

    function isPendingInitialContactRequestMessage(chatData, messageId) {
      let requestId = chatData.get('requestId', '');

      return isRequestBasedChat(chatData)
        && exists(
          /databases/$(database)/documents/contact_requests/$(requestId)
        )
        && get(
          /databases/$(database)/documents/contact_requests/$(requestId)
        ).data.status == 'pending'
