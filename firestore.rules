          'expiresAt',
          'isDeleted',
        ])
        && report.data.reportId == reportId
        && report.data.type == 'plate_hint'
        && report.data.reporterUserId == request.auth.uid
        && report.data.targetUserId == userId
        && report.data.status == 'submitted'
        && report.data.isDeleted == false
        && request.resource.data.reportId == reportId
        && request.resource.data.type == 'plate_hint'
        && request.resource.data.targetUserId == userId
        && request.resource.data.countryCode == report.data.countryCode
        && request.resource.data.plateKey == report.data.plateKey
        && request.resource.data.plateRegion == report.data.plateRegion
        && request.resource.data.plateLetters == report.data.plateLetters
        && request.resource.data.plateNumbers == report.data.plateNumbers
        && request.resource.data.category == report.data.category
        && request.resource.data.message == report.data.message
        && request.resource.data.locationMode == report.data.locationMode
        && request.resource.data.locationLabel == report.data.locationLabel
        && (
          (
            report.data.locationMode == 'gps'
            && request.resource.data.latitude == report.data.latitude
            && request.resource.data.longitude == report.data.longitude
            && !('manualAddress' in request.resource.data)
          ) ||
          (
            report.data.locationMode == 'manual'
            && request.resource.data.manualAddress == report.data.manualAddress
            && !('latitude' in request.resource.data)
            && !('longitude' in request.resource.data)
          )
        )
        && request.resource.data.status == 'unread'
        && request.resource.data.hasImage == report.data.hasImage
        && (
          (
            report.data.hasImage == false
            && !('imagePath' in request.resource.data)
          ) ||
          (
            report.data.hasImage == true
            && request.resource.data.imagePath == report.data.imagePath
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt == report.data.expiresAt
        && request.resource.data.isDeleted == false;
    }

    function isValidPlateHintSentReportNotificationCreate(userId, reportId) {
      let report = getAfter(/databases/$(database)/documents/reports/$(reportId));

