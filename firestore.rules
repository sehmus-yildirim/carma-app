        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt == report.data.expiresAt
        && request.resource.data.isDeleted == false;
    }

    function isValidReportNotificationReadUpdate(userId) {
      return isOwner(userId)
        && resource.data.targetUserId == userId
        && changedOnly(['status', 'readAt', 'updatedAt'])
        && request.resource.data.status == 'read'
        && request.resource.data.readAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnChatImagePath(chatId, path) {
      return path.matches(
        '^chat_images/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnChatDocumentPath(chatId, path) {
      return path.matches(
        '^chat_documents/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnChatVoiceMemoPath(chatId, path) {
      return path.matches(
        '^chat_voice_memos/' + chatId + '/' + request.auth.uid + '/[^/]+$'
      );
    }

    function isOwnStoryImagePath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.jpg$'
      );
    }

    function isOwnStoryVideoPath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.mp4$'
      );
    }

    function isValidStoryTextFontFamily(value) {
      return value in [
        'standard',
        'rounded',
        'serif',
        'mono',
        'condensed',
        'light',
        'medium',
        'black',
        'casual',
        'cursive',
      ];
    }

    function isValidStoryTextAlign(value) {
      return value in ['left', 'center', 'right'];
    }

    function isValidStoryFilterType(value) {
      return value in ['normal', 'warm', 'cool', 'mono', 'soft'];
    }

    function isValidStoryTextColorValue(value) {
      return value in [
        4294967295,
        4294965429,
        4294956367,
        4294941245,
        4294925404,
        4294922138,
        4293425657,
        4290807036,
        4286331629,
        4282090230,
        4281908728,
        4280472558,
        4281193663,
        4283096704,
        4288931381,
        4293257195,
        4279310375,
        4278190080,
      ];
    }

    function isValidStoryStickerType(value) {
      return value in [
        '',
        'location',
        'vehicle',
        'status',
      ];
    }

    function isValidStoryStickerData(type, label, payload) {
      return (
          type == ''
          && label.size() == 0
          && payload.size() == 0
        )
        || (
          type == 'location'
          && label.size() > 0
          && label.size() <= 80
          && payload.matches(
            '^-?[0-9]+\\.[0-9]{1,6},-?[0-9]+\\.[0-9]{1,6}$'
          )
        )
        || (
          type == 'vehicle'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 24
        )
        || (
          type == 'status'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 80
        );
    }

    function hasOnlyStoryOwnerWriteFields() {
      return request.resource.data.keys().hasOnly([
        'ownerUserId',
        'ownerDisplayName',
        'ownerPhotoUrl',
        'viewerUserIds',
        'viewerNameBy',
        'viewerPhotoUrlBy',
        'viewedAtBy',
        'imageUrl',
        'imagePath',
        'mediaType',
        'videoUrl',
        'videoPath',
        'videoIsMuted',
        'text',
        'textColorValue',
        'textFontFamily',
        'textIsBold',
        'textIsItalic',
        'textIsUnderline',
        'textAlign',
        'textAlignmentX',
        'textAlignmentY',
        'filterType',
        'stickerType',
        'stickerLabel',
        'stickerPayload',
        'stickerAlignmentX',
        'stickerAlignmentY',
        'createdAt',
        'updatedAt',
        'expiresAt',
      ]);
    }

    function isValidStoryOwnerWrite(storyId) {
      return isSignedIn()
        && hasOnlyStoryOwnerWriteFields()
        && storyId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerDisplayName is string
        && request.resource.data.ownerDisplayName.size() > 0
        && request.resource.data.ownerDisplayName.size() <= 80
        && (
          request.resource.data.ownerPhotoUrl == null ||
          (
            request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 500
          )
        )
        && request.resource.data.viewerUserIds is list
        && request.resource.data.viewerUserIds.size() > 0
        && request.resource.data.viewerUserIds.size() <= 200
        && request.auth.uid in request.resource.data.viewerUserIds
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && request.resource.data.viewedAtBy.keys().hasOnly([request.auth.uid])
        && request.resource.data.viewerNameBy.keys().hasOnly([request.auth.uid])
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && request.resource.data.viewerPhotoUrlBy.keys().hasOnly([request.auth.uid])
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.mediaType is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string
        && request.resource.data.videoIsMuted is bool
        && (
          (request.resource.data.mediaType == 'image'
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imagePath.size() > 0
            && isOwnStoryImagePath(request.resource.data.imagePath)
            && request.resource.data.videoUrl.size() == 0
            && request.resource.data.videoPath.size() == 0)
          || (request.resource.data.mediaType == 'video'
            && request.resource.data.videoUrl.size() > 0
            && request.resource.data.videoPath.size() > 0
            && isOwnStoryVideoPath(request.resource.data.videoPath)
            && request.resource.data.imageUrl.size() == 0
            && request.resource.data.imagePath.size() == 0)
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.textColorValue is int
        && isValidStoryTextColorValue(request.resource.data.textColorValue)
        && request.resource.data.textFontFamily is string
        && isValidStoryTextFontFamily(request.resource.data.textFontFamily)
        && request.resource.data.textIsBold is bool
        && request.resource.data.textIsItalic is bool
        && request.resource.data.textIsUnderline is bool
        && request.resource.data.textAlign is string
        && isValidStoryTextAlign(request.resource.data.textAlign)
        && request.resource.data.textAlignmentX is number
        && request.resource.data.textAlignmentX >= 0
        && request.resource.data.textAlignmentX <= 1
        && request.resource.data.textAlignmentY is number
        && request.resource.data.textAlignmentY >= 0
        && request.resource.data.textAlignmentY <= 1
        && request.resource.data.filterType is string
        && isValidStoryFilterType(request.resource.data.filterType)
        && request.resource.data.stickerType is string
        && isValidStoryStickerType(request.resource.data.stickerType)
        && request.resource.data.stickerLabel is string
        && request.resource.data.stickerPayload is string
        && isValidStoryStickerData(
          request.resource.data.stickerType,
          request.resource.data.stickerLabel,
          request.resource.data.stickerPayload
        )
        && request.resource.data.stickerAlignmentX is number
        && request.resource.data.stickerAlignmentX >= 0
        && request.resource.data.stickerAlignmentX <= 1
        && request.resource.data.stickerAlignmentY is number
        && request.resource.data.stickerAlignmentY >= 0
        && request.resource.data.stickerAlignmentY <= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h');
    }

    function isValidStoryViewUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.expiresAt > request.time
        && changedOnly(['viewedAtBy', 'viewerNameBy', 'viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewedAtBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerNameBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    function isValidStoryViewerPhotoUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.expiresAt > request.time
        && resource.data.viewedAtBy[request.auth.uid] is timestamp
        && changedOnly(['viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewerPhotoUrlBy is map
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() > 0
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isValidOwnerProfileWrite(userId, profileId);
        allow update: if isValidOwnerProfileWrite(userId, profileId)
          || isValidAdminProfileReviewUpdate();
        allow delete: if false;
      }

      match /search_credits/{creditId} {
        allow read: if isOwner(userId);
        allow create: if isValidInitialSearchCredit(userId, creditId);
        allow update: if isValidSearchCreditUpdate(userId, creditId);
        allow delete: if false;
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isValidNotificationSettingsWrite(
          userId,
          settingsId,
        );
        allow delete: if false;
      }

      match /legal_consents/{consentId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /moderation_actions/{actionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isValidPlateHintReportNotificationCreate(userId, reportId);
        allow update: if isValidReportNotificationReadUpdate(userId);
        allow delete: if false;
      }

      match /sent_report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isValidPlateHintSentReportNotificationCreate(userId, reportId);
        allow update, delete: if false;
      }
    }

    match /plates/{plateId} {
      allow get: if isSignedIn()
        && (
          resource.data.ownerUserId == request.auth.uid ||
          (
            resource.data.isActive == true &&
            resource.data.isDeleted == false &&
            (
              resource.data.allowContactRequests == true ||
              resource.data.allowAnonymousReports == true
            )
          )
        );

      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.isDeleted == false;

      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid;

      allow delete: if false;
    }

    match /contact_requests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.senderUserId == request.auth.uid ||
          resource.data.receiverUserId == request.auth.uid
        );

      allow create: if isValidContactRequestCreate(requestId);

      allow update: if isValidContactRequestUpdate(requestId);

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && isUndeletedChatParticipant(resource.data);

      allow create: if request.resource.data.requestId is string
        && isValidChatCreateForRequest(chatId, request.resource.data.requestId);

      allow update: if isValidChatLastMessageUpdate()
        || isValidChatReadUpdate()
        || isValidChatTypingUpdate()
        || isValidChatPresenceUpdate()
        || isValidChatFavoriteUpdate()
        || isValidChatPinnedUpdate()
        || isValidChatMutedUpdate()
        || isValidChatArchiveUpdate()
        || isValidChatDeleteUpdate()
        || isValidChatBlockUpdate()
        || isValidChatUnblockUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isUndeletedChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );

        allow create: if isValidTextMessageCreate(chatId)
          || isValidLocationMessageCreate(chatId)
          || isValidContactMessageCreate(chatId)
          || isValidImageMessageCreate(chatId)
          || isValidDocumentMessageCreate(chatId)
          || isValidAudioMessageCreate(chatId);

        allow update: if isValidMessageStarUpdate(chatId)
          || isValidMessageDeleteUpdate(chatId)
          || isValidMessageReactionUpdate(chatId);

        allow delete: if false;
      }
    }

    match /chat_stories/{storyId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && (
          request.auth.uid == resource.data.ownerUserId ||
          resource.data.expiresAt > request.time
        );

      allow create: if isValidStoryOwnerWrite(storyId);

      allow update: if isValidStoryOwnerWrite(storyId)
        || isValidStoryViewUpdate()
        || isValidStoryViewerPhotoUpdate();

      allow delete: if isSignedIn()
        && storyId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if isValidChatReportCreate()
        || isValidPlateHintReportCreate(reportId);
    }

    match /verification_requests/{requestId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isValidVerificationRequestCreate(requestId);

      allow update: if isValidAdminVerificationRequestUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
