    function isValidPlateHintReportCreate(reportId) {
      let plateId = request.resource.data.countryCode + '_' + request.resource.data.plateKey;
      let plate = get(/databases/$(database)/documents/plates/$(plateId));

      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'reportId',
          'type',
          'reporterUserId',
          'targetUserId',
          'countryCode',
          'plateKey',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'category',
          'message',
          'locationMode',
          'latitude',
          'longitude',
          'manualAddress',
          'locationLabel',
          'status',
          'hasImage',
          'imagePath',
          'anonymousToTarget',
          'createdAt',
          'updatedAt',
          'expiresAt',
          'isDeleted',
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.type == 'plate_hint'
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.countryCode in ['DE', 'AT', 'CH']
        && request.resource.data.plateKey is string
        && request.resource.data.plateKey.matches('^[A-Z0-9]{2,20}$')
        && request.resource.data.plateRegion is string
        && request.resource.data.plateRegion.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.plateLetters is string
        && request.resource.data.plateLetters.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.plateNumbers is string
        && request.resource.data.plateNumbers.matches('^[A-Z0-9]{1,6}$')
        && request.resource.data.plateKey
          == request.resource.data.plateRegion
            + request.resource.data.plateLetters
            + request.resource.data.plateNumbers
        && plate.data.ownerUserId == request.resource.data.targetUserId
        && plate.data.isActive == true
        && plate.data.isDeleted == false
        && plate.data.allowAnonymousReports == true
        && request.resource.data.category in [
          'vehicleOpen',
          'lightsOrElectric',
          'vehicleBlocked',
          'visibleDamage',
          'acuteDanger',
          'policeOnSite',
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 160
        && request.resource.data.locationLabel is string
        && request.resource.data.locationLabel.size() > 0
        && request.resource.data.locationLabel.size() <= 160
        && (
          (
            request.resource.data.locationMode == 'gps'
            && request.resource.data.latitude is number
            && request.resource.data.longitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
            && !('manualAddress' in request.resource.data)
          ) ||
          (
            request.resource.data.locationMode == 'manual'
            && request.resource.data.manualAddress is string
            && request.resource.data.manualAddress.size() >= 3
            && request.resource.data.manualAddress.size() <= 160
            && request.resource.data.locationLabel
              == request.resource.data.manualAddress
            && !('latitude' in request.resource.data)
            && !('longitude' in request.resource.data)
          )
        )
        && request.resource.data.status == 'submitted'
        && (
          (
            request.resource.data.hasImage == false
            && !('imagePath' in request.resource.data)
          ) ||
          (
            request.resource.data.hasImage == true
            && request.resource.data.imagePath
              == 'report_images/' + reportId + '/' + request.auth.uid + '/evidence.jpg'
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h')
        && request.resource.data.isDeleted == false;
    }

    function isValidPlateHintReportNotificationCreate(userId, reportId) {
      let report = getAfter(/databases/$(database)/documents/reports/$(reportId));

      return isSignedIn()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reportId',
          'type',
          'targetUserId',
          'countryCode',
          'plateKey',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'category',
