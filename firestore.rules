    function isValidMessageStarUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && isOpenUndeletedChatParticipant(chat.data)
        && resource.data.isDeleted == false
        && changedOnly(['isStarred', 'updatedAt'])
        && request.resource.data.isStarred is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidViewOnceMessageOpenUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && isOpenUndeletedChatParticipant(chat.data)
        && resource.data.isDeleted == false
        && resource.data.isViewOnce == true
        && (resource.data.type == 'image' || resource.data.type == 'video')
        && resource.data.senderUserId != request.auth.uid
        && resource.data.viewOnceOpenedAtBy is map
        && request.resource.data.viewOnceOpenedAtBy is map
        && !resource.data.viewOnceOpenedAtBy.keys().hasAny([request.auth.uid])
        && request.resource.data.viewOnceOpenedAtBy.keys().hasAll([
          request.auth.uid,
        ])
        && request.resource.data.viewOnceOpenedAtBy.size()
          == resource.data.viewOnceOpenedAtBy.size() + 1
        && request.resource.data.viewOnceOpenedAtBy[request.auth.uid]
          is timestamp
        && request.resource.data.viewOnceOpenedAtBy
          .diff(resource.data.viewOnceOpenedAtBy)
          .affectedKeys()
          .hasOnly([request.auth.uid])
        && changedOnly(['viewOnceOpenedAtBy', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMessageDeleteUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && isOpenUndeletedChatParticipant(chat.data)
        && resource.data.senderUserId == request.auth.uid
        && resource.data.isDeleted == false
        && resource.data.createdAt is timestamp
        && request.time <= resource.data.createdAt + duration.value(48, 'h')
        && changedOnly(['isDeleted', 'updatedAt'])
        && request.resource.data.isDeleted == true
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidMessageDeleteForUserUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && isOpenUndeletedChatParticipant(chat.data)
        && resource.data.isDeleted == false
        && changedOnly(['deletedFor', 'updatedAt'])
        && request.resource.data.deletedFor is map
        && request.resource.data.deletedFor.keys().hasOnly(chat.data.participants)
        && request.resource.data.deletedFor[request.auth.uid] == true
        && request.resource.data.updatedAt is timestamp
        && (
          (
            !('deletedFor' in resource.data)
            && request.resource.data.deletedFor.keys().hasOnly([
              request.auth.uid,
            ])
          )
          ||
          (
            resource.data.deletedFor is map
            && request.resource.data.deletedFor
              .diff(resource.data.deletedFor)
              .affectedKeys()
              .hasOnly([request.auth.uid])
          )
        );
    }

    function isAllowedMessageReaction(reaction) {
      return reaction in ['❤️', '👍', '😂', '😮', '😢', '🙏'];
    }

    function isValidMessageReactionUpdate(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));

      return isSignedIn()
        && isOpenUndeletedChatParticipant(chat.data)
        && resource.data.isDeleted == false
        && changedOnly(['reactionBy', 'reactionUpdatedAtBy', 'updatedAt'])
        && request.resource.data.reactionBy is map
        && (
          request.resource.data.reactionBy[request.auth.uid] == null ||
          (
            request.resource.data.reactionBy[request.auth.uid] is string
            && request.resource.data.reactionBy[request.auth.uid].size() > 0
            && isAllowedMessageReaction(
              request.resource.data.reactionBy[request.auth.uid]
            )
          )
        )
        && request.resource.data.reactionUpdatedAtBy is map
        && request.resource.data.reactionUpdatedAtBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('reactionBy', request.auth.uid)
        && changedOnlyNestedMapKey('reactionUpdatedAtBy', request.auth.uid);
    }

    function isValidChatReportCreate(reportId) {
      let chat = get(/databases/$(database)/documents/chats/$(request.resource.data.chatId));

      return isSignedIn()
        && reportId == 'chat_' + request.resource.data.chatId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type',
          'chatId',
          'reporterUserId',
          'reason',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.type == 'chat'
        && request.resource.data.chatId is string
        && request.resource.data.reporterUserId == request.auth.uid
        && isUndeletedChatParticipant(chat.data)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidPlateHintReportCreate(reportId) {
      let plateId = request.resource.data.countryCode + '_' + request.resource.data.plateKey;
      let plate = get(/databases/$(database)/documents/plates/$(plateId));

      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'reportId',
          'type',
          'reporterUserId',
          'targetUserId',
          'countryCode',
          'plateKey',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'category',
          'message',
          'locationMode',
          'latitude',
          'longitude',
          'manualAddress',
          'locationLabel',
          'status',
          'hasImage',
          'imagePath',
          'anonymousToTarget',
          'createdAt',
          'updatedAt',
          'expiresAt',
          'isDeleted',
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.type == 'plate_hint'
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.countryCode in ['DE', 'AT', 'CH']
        && request.resource.data.plateKey is string
        && request.resource.data.plateKey.matches('^[A-Z0-9]{2,20}$')
        && request.resource.data.plateRegion is string
        && request.resource.data.plateRegion.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.plateLetters is string
        && request.resource.data.plateLetters.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.plateNumbers is string
        && request.resource.data.plateNumbers.matches('^[A-Z0-9]{1,6}$')
        && request.resource.data.plateKey
          == request.resource.data.plateRegion
            + request.resource.data.plateLetters
            + request.resource.data.plateNumbers
        && plate.data.ownerUserId == request.resource.data.targetUserId
        && plate.data.isActive == true
        && plate.data.isDeleted == false
        && plate.data.allowAnonymousReports == true
        && request.resource.data.category in [
          'vehicleOpen',
          'lightsOrElectric',
          'vehicleBlocked',
          'visibleDamage',
          'acuteDanger',
          'policeOnSite',
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 160
        && request.resource.data.locationLabel is string
        && request.resource.data.locationLabel.size() > 0
        && request.resource.data.locationLabel.size() <= 160
        && (
          (
            request.resource.data.locationMode == 'gps'
            && request.resource.data.latitude is number
            && request.resource.data.longitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
            && !('manualAddress' in request.resource.data)
          ) ||
          (
            request.resource.data.locationMode == 'manual'
            && request.resource.data.manualAddress is string
            && request.resource.data.manualAddress.size() >= 3
            && request.resource.data.manualAddress.size() <= 160
            && request.resource.data.locationLabel
              == request.resource.data.manualAddress
            && !('latitude' in request.resource.data)
            && !('longitude' in request.resource.data)
          )
        )
        && request.resource.data.status == 'submitted'
        && (
          (
            request.resource.data.hasImage == false
            && !('imagePath' in request.resource.data)
          ) ||
          (
            request.resource.data.hasImage == true
            && request.resource.data.imagePath
              == 'report_images/' + reportId + '/' + request.auth.uid + '/evidence.jpg'
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h')
        && request.resource.data.isDeleted == false;
    }

    function isValidPlateHintReportNotificationCreate(userId, reportId) {
      let report = getAfter(/databases/$(database)/documents/reports/$(reportId));

      return isSignedIn()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reportId',
          'type',
          'targetUserId',
          'countryCode',
          'plateKey',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'category',
          'message',
          'locationMode',
          'latitude',
          'longitude',
          'manualAddress',
          'locationLabel',
          'status',
          'hasImage',
          'imagePath',
          'anonymousToTarget',
          'createdAt',
          'updatedAt',
          'expiresAt',
          'isDeleted',
        ])
        && report.data.reportId == reportId
        && report.data.type == 'plate_hint'
        && report.data.reporterUserId == request.auth.uid
        && report.data.targetUserId == userId
        && report.data.status == 'submitted'
        && report.data.isDeleted == false
        && request.resource.data.reportId == reportId
        && request.resource.data.type == 'plate_hint'
        && request.resource.data.targetUserId == userId
        && request.resource.data.countryCode == report.data.countryCode
        && request.resource.data.plateKey == report.data.plateKey
        && request.resource.data.plateRegion == report.data.plateRegion
        && request.resource.data.plateLetters == report.data.plateLetters
        && request.resource.data.plateNumbers == report.data.plateNumbers
        && request.resource.data.category == report.data.category
        && request.resource.data.message == report.data.message
        && request.resource.data.locationMode == report.data.locationMode
        && request.resource.data.locationLabel == report.data.locationLabel
        && (
          (
            report.data.locationMode == 'gps'
            && request.resource.data.latitude == report.data.latitude
            && request.resource.data.longitude == report.data.longitude
            && !('manualAddress' in request.resource.data)
          ) ||
          (
            report.data.locationMode == 'manual'
            && request.resource.data.manualAddress == report.data.manualAddress
            && !('latitude' in request.resource.data)
            && !('longitude' in request.resource.data)
          )
        )
        && request.resource.data.status == 'unread'
        && request.resource.data.hasImage == report.data.hasImage
        && (
          (
            report.data.hasImage == false
            && !('imagePath' in request.resource.data)
          ) ||
          (
            report.data.hasImage == true
            && request.resource.data.imagePath == report.data.imagePath
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt == report.data.expiresAt
        && request.resource.data.isDeleted == false;
    }

    function isValidPlateHintSentReportNotificationCreate(userId, reportId) {
      let report = getAfter(/databases/$(database)/documents/reports/$(reportId));

      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'reportId',
          'type',
          'countryCode',
          'plateKey',
          'plateRegion',
          'plateLetters',
          'plateNumbers',
          'category',
          'message',
          'locationMode',
          'latitude',
          'longitude',
          'manualAddress',
          'locationLabel',
          'status',
          'hasImage',
          'imagePath',
          'anonymousToTarget',
          'createdAt',
          'updatedAt',
          'expiresAt',
          'isDeleted',
        ])
        && report.data.reportId == reportId
        && report.data.type == 'plate_hint'
        && report.data.reporterUserId == request.auth.uid
        && report.data.status == 'submitted'
        && report.data.isDeleted == false
        && request.resource.data.reportId == reportId
        && request.resource.data.type == 'plate_hint'
        && request.resource.data.countryCode == report.data.countryCode
        && request.resource.data.plateKey == report.data.plateKey
        && request.resource.data.plateRegion == report.data.plateRegion
        && request.resource.data.plateLetters == report.data.plateLetters
        && request.resource.data.plateNumbers == report.data.plateNumbers
        && request.resource.data.category == report.data.category
        && request.resource.data.message == report.data.message
        && request.resource.data.locationMode == report.data.locationMode
        && request.resource.data.locationLabel == report.data.locationLabel
        && (
          (
            report.data.locationMode == 'gps'
            && request.resource.data.latitude == report.data.latitude
            && request.resource.data.longitude == report.data.longitude
            && !('manualAddress' in request.resource.data)
          ) ||
          (
            report.data.locationMode == 'manual'
            && request.resource.data.manualAddress == report.data.manualAddress
            && !('latitude' in request.resource.data)
            && !('longitude' in request.resource.data)
          )
        )
        && request.resource.data.status == 'submitted'
        && request.resource.data.hasImage == report.data.hasImage
        && (
          (
            report.data.hasImage == false
            && !('imagePath' in request.resource.data)
          ) ||
          (
            report.data.hasImage == true
            && request.resource.data.imagePath == report.data.imagePath
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt == report.data.expiresAt
        && request.resource.data.isDeleted == false;
    }

    function isValidReportNotificationReadUpdate(userId) {
      return isOwner(userId)
        && resource.data.targetUserId == userId
        && changedOnly(['status', 'readAt', 'updatedAt'])
        && request.resource.data.status == 'read'
        && request.resource.data.readAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnChatImagePath(chatId, messageId, path) {
      return path == 'chat_images/' + chatId + '/' + request.auth.uid
        + '/' + messageId + '.jpg';
    }

    function isOwnChatDocumentPath(chatId, messageId, path) {
      return path.matches(
        '^chat_documents/' + chatId + '/' + request.auth.uid + '/'
          + messageId + '_[^/]+$'
      );
    }

    function isOwnChatVoiceMemoPath(chatId, messageId, path) {
      return path.matches(
        '^chat_voice_memos/' + chatId + '/' + request.auth.uid + '/'
          + messageId + '_[^/]+\\.m4a$'
      );
    }

    function isOwnChatVideoPath(chatId, messageId, path) {
      return path == 'chat_videos/' + chatId + '/' + request.auth.uid
        + '/' + messageId + '.mp4';
    }

    function isOwnStoryImagePath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.jpg$'
      ) || path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}/media\\.jpg$'
      );
    }

    function isOwnStoryVideoPath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.mp4$'
      ) || path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}/media\\.mp4$'
      );
    }

    function isValidStoryTextFontFamily(value) {
      return value in [
        'standard',
        'rounded',
        'serif',
        'mono',
        'condensed',
        'light',
        'medium',
        'black',
        'casual',
        'cursive',
      ];
    }

    function isValidStoryTextAlign(value) {
      return value in ['left', 'center', 'right'];
    }

    function isValidStoryFilterType(value) {
      return value in ['normal', 'warm', 'cool', 'mono', 'soft'];
    }

    function isValidStoryTextColorValue(value) {
      return value in [
        4294967295,
        4294965429,
        4294956367,
        4294941245,
        4294925404,
        4294922138,
        4293425657,
        4290807036,
        4286331629,
        4282090230,
        4281908728,
        4280472558,
        4281193663,
        4283096704,
        4288931381,
        4293257195,
        4279310375,
        4278190080,
      ];
    }

    function isValidStoryStickerType(value) {
      return value in [
        '',
        'location',
        'vehicle',
        'status',
      ];
    }

    function isValidStoryStickerData(type, label, payload) {
      return (
          type == ''
          && label.size() == 0
          && payload.size() == 0
        )
        || (
          type == 'location'
          && label.size() > 0
          && label.size() <= 80
          && payload.matches(
            '^-?[0-9]+\\.[0-9]{1,6},-?[0-9]+\\.[0-9]{1,6}$'
          )
        )
        || (
          type == 'vehicle'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 24
        )
        || (
          type == 'status'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 80
        );
    }

    function isValidStorySticker(sticker) {
      return sticker is map
        && sticker.keys().hasOnly([
          'type',
          'label',
          'payload',
          'alignmentX',
          'alignmentY',
        ])
        && sticker.type is string
        && sticker.type != ''
        && isValidStoryStickerType(sticker.type)
        && sticker.label is string
        && sticker.payload is string
        && isValidStoryStickerData(
          sticker.type,
          sticker.label,
          sticker.payload
        )
        && sticker.alignmentX is number
        && sticker.alignmentX >= 0
        && sticker.alignmentX <= 1
        && sticker.alignmentY is number
        && sticker.alignmentY >= 0
        && sticker.alignmentY <= 1;
    }

    function isValidStoryStickerList(stickers) {
      return stickers is list
        && stickers.size() <= 8
        && (stickers.size() < 1 || isValidStorySticker(stickers[0]))
        && (stickers.size() < 2 || isValidStorySticker(stickers[1]))
        && (stickers.size() < 3 || isValidStorySticker(stickers[2]))
        && (stickers.size() < 4 || isValidStorySticker(stickers[3]))
        && (stickers.size() < 5 || isValidStorySticker(stickers[4]))
        && (stickers.size() < 6 || isValidStorySticker(stickers[5]))
        && (stickers.size() < 7 || isValidStorySticker(stickers[6]))
        && (stickers.size() < 8 || isValidStorySticker(stickers[7]));
    }

    function hasOnlyStoryOwnerWriteFields() {
      return request.resource.data.keys().hasOnly([
        'ownerUserId',
        'ownerDisplayName',
        'ownerPhotoUrl',
        'viewerUserIds',
        'viewerNameBy',
        'viewerPhotoUrlBy',
        'viewedAtBy',
        'imageUrl',
        'imagePath',
        'mediaType',
        'videoUrl',
        'videoPath',
        'videoIsMuted',
        'text',
        'textColorValue',
        'textFontFamily',
        'textIsBold',
        'textIsItalic',
        'textIsUnderline',
        'textAlign',
        'textAlignmentX',
        'textAlignmentY',
        'filterType',
        'stickerType',
        'stickerLabel',
        'stickerPayload',
        'stickerAlignmentX',
        'stickerAlignmentY',
        'stickers',
        'createdAt',
        'updatedAt',
        'expiresAt',
        'isActive',
      ]);
    }

    function isValidStoryOwnerWrite(storyId) {
      return isSignedIn()
        && hasOnlyStoryOwnerWriteFields()
        && (
          storyId == request.auth.uid
          || storyId.matches('^[0-9]{12,24}$')
        )
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerDisplayName is string
        && request.resource.data.ownerDisplayName.size() > 0
        && request.resource.data.ownerDisplayName.size() <= 80
        && (
          request.resource.data.ownerPhotoUrl == null ||
          (
            request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 500
          )
        )
        && request.resource.data.viewerUserIds is list
        && request.resource.data.viewerUserIds.size() > 0
        && request.resource.data.viewerUserIds.size() <= 200
        && request.auth.uid in request.resource.data.viewerUserIds
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && request.resource.data.viewedAtBy.keys().hasOnly([request.auth.uid])
        && request.resource.data.viewerNameBy.keys().hasOnly([request.auth.uid])
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && request.resource.data.viewerPhotoUrlBy.keys().hasOnly([request.auth.uid])
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.mediaType is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string
        && request.resource.data.videoIsMuted is bool
        && (
          (request.resource.data.mediaType == 'image'
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imagePath.size() > 0
            && isOwnStoryImagePath(request.resource.data.imagePath)
            && request.resource.data.videoUrl.size() == 0
            && request.resource.data.videoPath.size() == 0)
          || (request.resource.data.mediaType == 'video'
            && request.resource.data.videoUrl.size() > 0
            && request.resource.data.videoPath.size() > 0
            && isOwnStoryVideoPath(request.resource.data.videoPath)
            && request.resource.data.imageUrl.size() == 0
            && request.resource.data.imagePath.size() == 0)
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.textColorValue is int
        && isValidStoryTextColorValue(request.resource.data.textColorValue)
        && request.resource.data.textFontFamily is string
        && isValidStoryTextFontFamily(request.resource.data.textFontFamily)
        && request.resource.data.textIsBold is bool
        && request.resource.data.textIsItalic is bool
        && request.resource.data.textIsUnderline is bool
        && request.resource.data.textAlign is string
        && isValidStoryTextAlign(request.resource.data.textAlign)
        && request.resource.data.textAlignmentX is number
        && request.resource.data.textAlignmentX >= 0
        && request.resource.data.textAlignmentX <= 1
        && request.resource.data.textAlignmentY is number
        && request.resource.data.textAlignmentY >= 0
        && request.resource.data.textAlignmentY <= 1
        && request.resource.data.filterType is string
        && isValidStoryFilterType(request.resource.data.filterType)
        && request.resource.data.stickerType is string
        && isValidStoryStickerType(request.resource.data.stickerType)
        && request.resource.data.stickerLabel is string
        && request.resource.data.stickerPayload is string
        && isValidStoryStickerData(
          request.resource.data.stickerType,
          request.resource.data.stickerLabel,
          request.resource.data.stickerPayload
        )
        && request.resource.data.stickerAlignmentX is number
        && request.resource.data.stickerAlignmentX >= 0
        && request.resource.data.stickerAlignmentX <= 1
        && request.resource.data.stickerAlignmentY is number
        && request.resource.data.stickerAlignmentY >= 0
        && request.resource.data.stickerAlignmentY <= 1
        && (
          !request.resource.data.keys().hasAny(['stickers'])
          || isValidStoryStickerList(request.resource.data.stickers)
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isActive is bool
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h');
    }

    function isValidStoryViewUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.expiresAt > request.time
        && changedOnly(['viewedAtBy', 'viewerNameBy', 'viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewedAtBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerNameBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    function isValidStoryViewerPhotoUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.expiresAt > request.time
        && resource.data.viewedAtBy[request.auth.uid] is timestamp
        && changedOnly(['viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewerPhotoUrlBy is map
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() > 0
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    match /public_profiles/{userId} {
      allow read: if isOwner(userId)
        || (
          hasActiveProfileConnection(userId)
          && resource.data.profileAccessEnabled == true
        );
      allow create, update: if isValidPublicProfileWrite(userId);
      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId)
          || (
            hasActiveProfileConnection(userId)
            && profileAllowsAccess(userId)
          );
        allow create: if isOwner(userId)
          && isValidVehicleDocument(userId, vehicleId, false)
          && !('heroImageUrl' in request.resource.data)
          && !('heroImagePath' in request.resource.data)
          && !('heroImageStatus' in request.resource.data)
          && !('heroSourceHash' in request.resource.data)
          && !('heroPromptVersion' in request.resource.data)
          && !('heroProvider' in request.resource.data)
          && !('heroError' in request.resource.data)
          && !('heroRequestedAt' in request.resource.data)
          && !('heroGeneratedAt' in request.resource.data)
          && !('heroRequestWindowStartedAt' in request.resource.data)
          && !('heroRequestCount' in request.resource.data);
        allow update: if isOwner(userId)
          && isValidVehicleDocument(userId, vehicleId, false)
          && vehicleClientFieldsOnly();
        allow delete: if isOwner(userId);

        match /modifications/{modificationId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && exists(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleModification(
              userId,
              vehicleId,
              modificationId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /gallery/{mediaId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && exists(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleGalleryMedia(
              userId,
              vehicleId,
              mediaId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /timeline/{entryId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && existsAfter(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleTimelineEntry(
              userId,
              vehicleId,
              entryId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /encounters/{encounterId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              && hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
            );
          allow create, update: if isSignedIn()
            && existsAfter(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidPublicVehicleEncounter(
              userId,
              vehicleId,
              encounterId
            );
          allow delete: if canDeletePublicVehicleEncounter(encounterId);
        }
      }
    }

    match /profile_connections/{connectionId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isValidProfileConnectionWrite(connectionId);
      allow update: if isValidProfileConnectionWrite(connectionId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /vehicle_encounters/{encounterId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantUserIds;
      allow create: if isValidVehicleEncounterCreate(encounterId);
      allow update: if isValidVehicleEncounterUpdate();
      allow delete: if false;
    }

    match /follow_relationships/{relationshipId} {
      allow read: if canReadFollowRelationship(resource.data);
      allow create: if isValidFollowRelationshipCreate(relationshipId);
      allow update: if isValidFollowRequestAccept();
      allow delete: if isValidFollowRelationshipDelete();
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isValidOwnerProfileWrite(userId, profileId);
        allow update: if isValidOwnerProfileWrite(userId, profileId)
          || isValidAdminProfileReviewUpdate();
        allow delete: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidVehicleDocument(userId, vehicleId, true)
          && !('heroImageUrl' in request.resource.data)
          && !('heroImagePath' in request.resource.data)
          && !('heroImageStatus' in request.resource.data)
          && !('heroSourceHash' in request.resource.data)
          && !('heroPromptVersion' in request.resource.data)
          && !('heroProvider' in request.resource.data)
          && !('heroError' in request.resource.data)
          && !('heroRequestedAt' in request.resource.data)
          && !('heroGeneratedAt' in request.resource.data)
          && !('heroRequestWindowStartedAt' in request.resource.data)
          && !('heroRequestCount' in request.resource.data);
        allow update: if isOwner(userId)
          && isValidVehicleDocument(userId, vehicleId, true)
          && vehicleClientFieldsOnly();
        allow delete: if false;

        match /modifications/{modificationId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleModification(
              userId,
              vehicleId,
              modificationId,
              true
            );
          allow delete: if false;
        }

        match /gallery/{mediaId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleGalleryMedia(
              userId,
              vehicleId,
              mediaId,
              true
            );
          allow delete: if false;
        }

        match /timeline/{entryId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleTimelineEntry(
              userId,
              vehicleId,
              entryId,
              true
            );
          allow delete: if false;
        }
      }

      match /search_credits/{creditId} {
        allow read: if isOwner(userId);
        allow create: if isValidInitialSearchCredit(userId, creditId);
        allow update: if isValidSearchCreditUpdate(userId, creditId);
        allow delete: if false;
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isValidNotificationSettingsWrite(
          userId,
          settingsId,
        );
        allow delete: if false;
      }

      match /legal_consents/{consentId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /social_posts/{postId} {
        allow read: if isOwner(userId)
          || (
            hasActiveProfileConnection(userId)
            && profileAllowsAccess(userId)
            && resource.data.visibility == 'public'
            && resource.data.isDeleted == false
          );
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'postId',
            'ownerUserId',
            'imageUrl',
            'imagePath',
            'caption',
            'vehicleLabel',
            'locationLabel',
            'section',
            'visibility',
            'createdAt',
            'updatedAt',
            'isDeleted'
          ])
          && request.resource.data.postId == postId
          && request.resource.data.ownerUserId == userId
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() > 0
          && request.resource.data.imageUrl.size() <= 1000
          && request.resource.data.imagePath
            == 'profile_posts/' + userId + '/' + postId + '/image.jpg'
          && request.resource.data.section in ['posts', 'vehicle']
          && request.resource.data.visibility == 'public'
          && (
            request.resource.data.caption == null ||
            (
              request.resource.data.caption is string
              && request.resource.data.caption.size() <= 220
            )
          )
          && (
            request.resource.data.vehicleLabel == null ||
            (
              request.resource.data.vehicleLabel is string
              && request.resource.data.vehicleLabel.size() <= 120
            )
          )
          && (
            request.resource.data.locationLabel == null ||
            (
              request.resource.data.locationLabel is string
              && request.resource.data.locationLabel.size() <= 120
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isDeleted == false;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /moderation_actions/{actionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isValidReportNotificationReadUpdate(userId);
        allow delete: if false;
      }

      match /sent_report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /plates/{plateId} {
      allow get: if isSignedIn()
        && (
          resource.data.ownerUserId == request.auth.uid ||
          (
            resource.data.isActive == true &&
            resource.data.isDeleted == false &&
            (
              resource.data.allowContactRequests == true ||
              resource.data.allowAnonymousReports == true
            )
          )
        );

      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.isDeleted == false;

      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid;

      allow delete: if false;
    }

    match /contact_requests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.senderUserId == request.auth.uid ||
          resource.data.receiverUserId == request.auth.uid
        );

      allow create: if isValidContactRequestCreate(requestId);

      allow update: if isValidContactRequestUpdate(requestId);

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if request.resource.data.requestId is string
        && isValidChatCreateForRequest(chatId, request.resource.data.requestId);

      allow update: if isValidChatLastMessageUpdate()
        || isValidChatReadUpdate()
        || isValidChatTypingUpdate()
        || isValidChatPresenceUpdate()
        || isValidChatFavoriteUpdate()
        || isValidChatPinnedUpdate()
        || isValidChatMutedUpdate()
        || isValidChatArchiveUpdate()
        || isValidChatDeleteUpdate()
        || isValidChatBlockUpdate()
        || isValidChatUnblockUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isUndeletedChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );

        allow create: if isValidTextMessageCreate(chatId)
          || isValidLocationMessageCreate(chatId)
          || isValidContactMessageCreate(chatId)
          || isValidImageMessageCreate(chatId, messageId)
          || isValidDocumentMessageCreate(chatId, messageId)
          || isValidAudioMessageCreate(chatId, messageId)
          || isValidVideoMessageCreate(chatId, messageId);

        allow update: if isValidMessageStarUpdate(chatId)
          || isValidMessageDeleteUpdate(chatId)
          || isValidMessageDeleteForUserUpdate(chatId)
          || isValidMessageReactionUpdate(chatId)
          || isValidViewOnceMessageOpenUpdate(chatId);

        allow delete: if false;
      }
    }

    match /chat_stories/{storyId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.ownerUserId ||
          (
            request.auth.uid in resource.data.viewerUserIds
            && resource.data.isActive == true
          )
        );

      allow create: if isValidStoryOwnerWrite(storyId)
        && request.resource.data.isActive == true;

      allow update: if (
          resource.data.ownerUserId == request.auth.uid
          && isValidStoryOwnerWrite(storyId)
          && request.resource.data.isActive == resource.data.isActive
        )
        || isValidStoryViewUpdate()
        || isValidStoryViewerPhotoUpdate();

      allow delete: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn()
        && reportId.matches('^chat_.+_' + request.auth.uid + '$');
      allow list, update, delete: if false;

      allow create: if isValidChatReportCreate(reportId);
    }

    match /report_rate_limits/{userId} {
      allow read, write: if false;
    }

    match /verification_requests/{requestId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isValidVerificationRequestCreate(requestId);

      allow update: if isValidAdminVerificationRequestUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
