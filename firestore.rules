            && !('imagePath' in request.resource.data)
          ) ||
          (
            report.data.hasImage == true
            && request.resource.data.imagePath == report.data.imagePath
          )
        )
        && request.resource.data.anonymousToTarget == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt == report.data.expiresAt
        && request.resource.data.isDeleted == false;
    }

    function isValidReportNotificationReadUpdate(userId) {
      return isOwner(userId)
        && resource.data.targetUserId == userId
        && changedOnly(['status', 'readAt', 'updatedAt'])
        && request.resource.data.status == 'read'
        && request.resource.data.readAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnChatImagePath(chatId, messageId, path) {
      return path == 'chat_images/' + chatId + '/' + request.auth.uid
        + '/' + messageId + '.jpg';
    }

    function isOwnChatDocumentPath(chatId, messageId, path) {
      return path.matches(
        '^chat_documents/' + chatId + '/' + request.auth.uid + '/'
          + messageId + '_[^/]+$'
      );
    }

    function isOwnChatVoiceMemoPath(chatId, messageId, path) {
      return path.matches(
        '^chat_voice_memos/' + chatId + '/' + request.auth.uid + '/'
          + messageId + '_[^/]+\\.m4a$'
      );
    }

    function isOwnChatVideoPath(chatId, messageId, path) {
      return path == 'chat_videos/' + chatId + '/' + request.auth.uid
        + '/' + messageId + '.mp4';
    }

    function isOwnStoryImagePath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.jpg$'
      ) || path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}/media\\.jpg$'
      );
    }

    function isOwnStoryVideoPath(path) {
      return path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}\\.mp4$'
      ) || path.matches(
        '^chat_stories/' + request.auth.uid + '/[0-9]{12,24}/media\\.mp4$'
      );
    }

    function isValidStoryTextFontFamily(value) {
      return value in [
        'standard',
        'rounded',
        'serif',
        'mono',
        'condensed',
        'light',
        'medium',
        'black',
        'casual',
        'cursive',
      ];
    }

    function isValidStoryTextAlign(value) {
      return value in ['left', 'center', 'right'];
    }

    function isValidStoryFilterType(value) {
      return value in ['normal', 'warm', 'cool', 'mono', 'soft'];
    }

    function isValidStoryTextColorValue(value) {
      return value in [
        4294967295,
        4294965429,
        4294956367,
        4294941245,
        4294925404,
        4294922138,
        4293425657,
        4290807036,
        4286331629,
        4282090230,
        4281908728,
        4280472558,
        4281193663,
        4283096704,
        4288931381,
        4293257195,
        4279310375,
        4278190080,
      ];
    }

    function isValidStoryStickerType(value) {
      return value in [
        '',
        'location',
        'vehicle',
        'status',
      ];
    }

    function isValidStoryStickerData(type, label, payload) {
      return (
          type == ''
          && label.size() == 0
          && payload.size() == 0
        )
        || (
          type == 'location'
          && label.size() > 0
          && label.size() <= 80
          && payload.matches(
            '^-?[0-9]+\\.[0-9]{1,6},-?[0-9]+\\.[0-9]{1,6}$'
          )
        )
        || (
          type == 'vehicle'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 24
        )
        || (
          type == 'status'
          && label.size() > 0
          && label.size() <= 80
          && payload.size() > 0
          && payload.size() <= 80
        );
    }

    function isValidStorySticker(sticker) {
      return sticker is map
        && sticker.keys().hasOnly([
          'type',
          'label',
          'payload',
          'alignmentX',
          'alignmentY',
        ])
        && sticker.type is string
        && sticker.type != ''
        && isValidStoryStickerType(sticker.type)
        && sticker.label is string
        && sticker.payload is string
        && isValidStoryStickerData(
          sticker.type,
          sticker.label,
          sticker.payload
        )
        && sticker.alignmentX is number
        && sticker.alignmentX >= 0
        && sticker.alignmentX <= 1
        && sticker.alignmentY is number
        && sticker.alignmentY >= 0
        && sticker.alignmentY <= 1;
    }

    function isValidStoryStickerList(stickers) {
      return stickers is list
        && stickers.size() <= 8
        && (stickers.size() < 1 || isValidStorySticker(stickers[0]))
        && (stickers.size() < 2 || isValidStorySticker(stickers[1]))
        && (stickers.size() < 3 || isValidStorySticker(stickers[2]))
        && (stickers.size() < 4 || isValidStorySticker(stickers[3]))
        && (stickers.size() < 5 || isValidStorySticker(stickers[4]))
        && (stickers.size() < 6 || isValidStorySticker(stickers[5]))
        && (stickers.size() < 7 || isValidStorySticker(stickers[6]))
        && (stickers.size() < 8 || isValidStorySticker(stickers[7]));
    }

    function hasOnlyStoryOwnerWriteFields() {
      return request.resource.data.keys().hasOnly([
        'ownerUserId',
        'ownerDisplayName',
        'ownerPhotoUrl',
        'viewerUserIds',
        'repliesEnabled',
        'viewerNameBy',
        'viewerPhotoUrlBy',
        'viewedAtBy',
        'imageUrl',
        'imagePath',
        'mediaType',
        'videoUrl',
        'videoPath',
        'videoIsMuted',
        'text',
        'textColorValue',
        'textFontFamily',
        'textIsBold',
        'textIsItalic',
        'textIsUnderline',
        'textAlign',
        'textAlignmentX',
        'textAlignmentY',
        'filterType',
        'stickerType',
        'stickerLabel',
        'stickerPayload',
        'stickerAlignmentX',
        'stickerAlignmentY',
        'stickers',
        'createdAt',
        'updatedAt',
        'expiresAt',
        'isActive',
      ]);
    }

    function isValidStoryOwnerWrite(storyId) {
      return isSignedIn()
        && hasOnlyStoryOwnerWriteFields()
        && (
          storyId == request.auth.uid
          || storyId.matches('^[0-9]{12,24}$')
        )
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerDisplayName is string
        && request.resource.data.ownerDisplayName.size() > 0
        && request.resource.data.ownerDisplayName.size() <= 80
        && (
          request.resource.data.ownerPhotoUrl == null ||
          (
            request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 500
          )
        )
        && request.resource.data.viewerUserIds is list
        && request.resource.data.viewerUserIds.size() > 0
        && request.resource.data.viewerUserIds.size() <= 200
        && request.auth.uid in request.resource.data.viewerUserIds
        && storyAudienceMatchesPrivacy(request.auth.uid)
        && request.resource.data.repliesEnabled is bool
        && request.resource.data.repliesEnabled
          == storyRepliesEnabledFor(request.auth.uid)
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && request.resource.data.viewedAtBy.keys().hasOnly([request.auth.uid])
        && request.resource.data.viewerNameBy.keys().hasOnly([request.auth.uid])
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && request.resource.data.viewerPhotoUrlBy.keys().hasOnly([request.auth.uid])
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.mediaType is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string
        && request.resource.data.videoIsMuted is bool
        && (
          (request.resource.data.mediaType == 'image'
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imagePath.size() > 0
            && isOwnStoryImagePath(request.resource.data.imagePath)
            && request.resource.data.videoUrl.size() == 0
            && request.resource.data.videoPath.size() == 0)
          || (request.resource.data.mediaType == 'video'
            && request.resource.data.videoUrl.size() > 0
            && request.resource.data.videoPath.size() > 0
            && isOwnStoryVideoPath(request.resource.data.videoPath)
            && request.resource.data.imageUrl.size() == 0
            && request.resource.data.imagePath.size() == 0)
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.textColorValue is int
        && isValidStoryTextColorValue(request.resource.data.textColorValue)
        && request.resource.data.textFontFamily is string
        && isValidStoryTextFontFamily(request.resource.data.textFontFamily)
        && request.resource.data.textIsBold is bool
        && request.resource.data.textIsItalic is bool
        && request.resource.data.textIsUnderline is bool
        && request.resource.data.textAlign is string
        && isValidStoryTextAlign(request.resource.data.textAlign)
        && request.resource.data.textAlignmentX is number
        && request.resource.data.textAlignmentX >= 0
        && request.resource.data.textAlignmentX <= 1
        && request.resource.data.textAlignmentY is number
        && request.resource.data.textAlignmentY >= 0
        && request.resource.data.textAlignmentY <= 1
        && request.resource.data.filterType is string
        && isValidStoryFilterType(request.resource.data.filterType)
        && request.resource.data.stickerType is string
        && isValidStoryStickerType(request.resource.data.stickerType)
        && request.resource.data.stickerLabel is string
        && request.resource.data.stickerPayload is string
        && isValidStoryStickerData(
          request.resource.data.stickerType,
          request.resource.data.stickerLabel,
          request.resource.data.stickerPayload
        )
        && request.resource.data.stickerAlignmentX is number
        && request.resource.data.stickerAlignmentX >= 0
        && request.resource.data.stickerAlignmentX <= 1
        && request.resource.data.stickerAlignmentY is number
        && request.resource.data.stickerAlignmentY >= 0
        && request.resource.data.stickerAlignmentY <= 1
        && (
          !request.resource.data.keys().hasAny(['stickers'])
          || isValidStoryStickerList(request.resource.data.stickers)
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isActive is bool
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <=
          request.resource.data.createdAt + duration.value(24, 'h');
    }

    function isValidStoryViewUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.isActive == true
        && resource.data.expiresAt > request.time
        && changedOnly(['viewedAtBy', 'viewerNameBy', 'viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewedAtBy is map
        && request.resource.data.viewerNameBy is map
        && (
          !request.resource.data.keys().hasAny(['viewerPhotoUrlBy']) ||
          (
            request.resource.data.viewerPhotoUrlBy is map
            && (
              request.resource.data.viewerPhotoUrlBy[request.auth.uid] == null ||
              (
                request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
                && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
              )
            )
          )
        )
        && request.resource.data.viewedAtBy[request.auth.uid] is timestamp
        && request.resource.data.viewerNameBy[request.auth.uid] is string
        && request.resource.data.viewerNameBy[request.auth.uid].size() > 0
        && request.resource.data.viewerNameBy[request.auth.uid].size() <= 80
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewedAtBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerNameBy', request.auth.uid)
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    function isValidStoryViewerPhotoUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.viewerUserIds
        && resource.data.isActive == true
        && resource.data.expiresAt > request.time
        && resource.data.viewedAtBy[request.auth.uid] is timestamp
        && changedOnly(['viewerPhotoUrlBy', 'updatedAt'])
        && request.resource.data.viewerPhotoUrlBy is map
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid] is string
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() > 0
        && request.resource.data.viewerPhotoUrlBy[request.auth.uid].size() <= 500
        && request.resource.data.updatedAt is timestamp
        && changedOnlyNestedMapKey('viewerPhotoUrlBy', request.auth.uid);
    }

    match /public_profiles/{userId} {
      allow read: if isOwner(userId)
        || (
          hasActiveProfileConnection(userId)
          && resource.data.profileAccessEnabled == true
        );
      allow create, update: if isValidPublicProfileWrite(userId);
      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId)
          || (
            hasActiveProfileConnection(userId)
            && profileAllowsVehicleAccess(userId)
          );
        // Stammdaten, öffentliche Projektion, Hauptfahrzeug und Kennzeichen
        // werden ausschließlich atomar durch die Fahrzeug-Functions geschrieben.
        allow create, update, delete: if false;

        match /modifications/{modificationId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsVehicleAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && exists(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleModification(
              userId,
              vehicleId,
              modificationId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /gallery/{mediaId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsVehicleAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && exists(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleGalleryMedia(
              userId,
              vehicleId,
              mediaId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /timeline/{entryId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              &&
              hasActiveProfileConnection(userId)
              && profileAllowsVehicleAccess(userId)
            );
          allow create, update: if isOwner(userId)
            && existsAfter(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidVehicleTimelineEntry(
              userId,
              vehicleId,
              entryId,
              false
            );
          allow delete: if isOwner(userId);
        }

        match /encounters/{encounterId} {
          allow read: if isOwner(userId)
            || (
              exists(
                /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
              )
              && hasActiveProfileConnection(userId)
              && profileAllowsVehicleAccess(userId)
            );
          allow create, update: if isSignedIn()
            && existsAfter(
              /databases/$(database)/documents/public_profiles/$(userId)/vehicles/$(vehicleId)
            )
            && isValidPublicVehicleEncounter(
              userId,
              vehicleId,
              encounterId
            );
          allow delete: if canDeletePublicVehicleEncounter(encounterId);
        }
      }
    }

    match /profile_connections/{connectionId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isValidProfileConnectionWrite(connectionId);
      allow update: if isValidProfileConnectionWrite(connectionId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /vehicle_encounters/{encounterId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantUserIds;
      allow create: if isValidVehicleEncounterCreate(encounterId);
      allow update: if isValidVehicleEncounterUpdate();
      allow delete: if false;
    }

    match /follow_relationships/{relationshipId} {
      allow read: if canReadFollowRelationship(resource.data);
      allow create: if isValidFollowRelationshipCreate(relationshipId);
      allow update: if isValidFollowRequestAccept();
      allow delete: if isValidFollowRelationshipDelete();
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isValidOwnerProfileCreate(userId, profileId);
        allow update: if isValidOwnerProfileUpdate(userId, profileId)
          && keepsLockedPersonalData();
        allow delete: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;

        match /modifications/{modificationId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleModification(
              userId,
              vehicleId,
              modificationId,
              true
            );
          allow delete: if false;
        }

        match /gallery/{mediaId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleGalleryMedia(
              userId,
              vehicleId,
              mediaId,
              true
            );
          allow delete: if false;
        }

        match /timeline/{entryId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && isValidVehicleTimelineEntry(
              userId,
              vehicleId,
              entryId,
              true
            );
          allow delete: if false;
        }
      }

      match /search_credits/{creditId} {
        allow read: if isOwner(userId);
        allow create: if isValidInitialSearchCredit(userId, creditId);
        allow update: if isValidSearchCreditUpdate(userId, creditId);
        allow delete: if false;
      }

      match /verification_notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId)
          && changedOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isValidUserSettingsWrite(
          userId,
          settingsId,
        );
        allow delete: if false;
      }

      match /push_tokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isValidPushTokenWrite(userId, tokenId);
        allow delete: if isOwner(userId);
      }

      match /support_requests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.requestId == requestId
          && request.resource.data.type in [
            'problem',
            'verification',
            'safety',
            'feedback'
          ]
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 80
          && (
            request.resource.data.affectedArea == null
            || (
              request.resource.data.affectedArea is string
              && request.resource.data.affectedArea.size() <= 80
            )
          )
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 20
          && request.resource.data.description.size() <= 2000
          && (
            request.resource.data.reproductionSteps == null
            || (
              request.resource.data.reproductionSteps is string
              && request.resource.data.reproductionSteps.size() <= 2000
            )
          )
          && (
            request.resource.data.get('technicalReferenceId', null) == null
            || (
              request.resource.data.type == 'verification'
              && request.resource.data.get('technicalReferenceId', null) == userId
            )
          )
          && (
            request.resource.data.get('technicalReferenceGroup', null) == null
            || (
              request.resource.data.type == 'verification'
              && request.resource.data.get('technicalReferenceGroup', null) in [
                'identity',
                'driverLicense',
                'vehicle'
              ]
            )
          )
          && (
            (request.resource.data.get('technicalReferenceId', null) == null
              && request.resource.data.get('technicalReferenceGroup', null) == null)
            || (request.resource.data.get('technicalReferenceId', null) != null
              && request.resource.data.get('technicalReferenceGroup', null) != null)
          )
          && request.resource.data.allowContact is bool
          && (
            request.resource.data.accountEmail == null
            || (
              request.resource.data.accountEmail is string
              && request.resource.data.accountEmail.size() <= 254
            )
          )
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 40
          && request.resource.data.status == 'received'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'requestId',
            'userId',
            'type',
            'category',
            'affectedArea',
            'description',
            'reproductionSteps',
            'technicalReferenceId',
            'technicalReferenceGroup',
            'allowContact',
            'accountEmail',
            'appVersion',
            'status',
            'createdAt',
            'updatedAt'
          ]);
        allow update, delete: if false;
      }

      match /data_rights_requests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.requestId == requestId
          && request.resource.data.type == 'export'
          && request.resource.data.status == 'requested'
          && (
            request.resource.data.accountEmail == null
            || (
              request.resource.data.accountEmail is string
              && request.resource.data.accountEmail.size() <= 254
            )
          )
          && (
            request.resource.data.note == null
            || (
              request.resource.data.note is string
              && request.resource.data.note.size() <= 500
            )
          )
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 40
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'requestId',
            'userId',
            'type',
            'status',
            'accountEmail',
            'note',
            'appVersion',
            'createdAt',
            'updatedAt'
          ]);
        allow update, delete: if false;
      }

      match /legal_consents/{consentId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /social_posts/{postId} {
        allow read: if isOwner(userId)
          || (
            hasActiveProfileConnection(userId)
            && profileAllowsAccess(userId)
            && resource.data.visibility in ['public', 'contacts']
            && resource.data.isDeleted == false
            && resource.data.get('isArchived', false) == false
          );
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'postId',
            'ownerUserId',
            'imageUrl',
            'imagePath',
            'mediaUrls',
            'mediaPaths',
            'mediaTypes',
            'caption',
            'vehicleLabel',
            'vehicleId',
            'locationLabel',
            'section',
            'visibility',
            'createdAt',
            'updatedAt',
            'isDeleted',
            'isArchived',
            'pinnedAt'
          ])
          && request.resource.data.postId == postId
          && request.resource.data.ownerUserId == userId
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() > 0
          && request.resource.data.imageUrl.size() <= 1000
          && request.resource.data.mediaUrls is list
          && request.resource.data.mediaPaths is list
          && request.resource.data.mediaTypes is list
          && request.resource.data.mediaUrls.size() > 0
          && request.resource.data.mediaUrls.size() <= 10
          && request.resource.data.mediaPaths.size()
            == request.resource.data.mediaUrls.size()
          && request.resource.data.mediaTypes.size()
            == request.resource.data.mediaUrls.size()
          && request.resource.data.mediaTypes.hasOnly(['image', 'video'])
          && request.resource.data.imagePath
            == request.resource.data.mediaPaths[0]
          && request.resource.data.imageUrl
            == request.resource.data.mediaUrls[0]
          && request.resource.data.section in ['posts', 'vehicle']
          && request.resource.data.visibility in ['public', 'contacts', 'onlyMe']
          && (
            request.resource.data.caption == null ||
            (
              request.resource.data.caption is string
              && request.resource.data.caption.size() <= 220
            )
          )
          && (
            request.resource.data.vehicleLabel == null ||
            (
              request.resource.data.vehicleLabel is string
              && request.resource.data.vehicleLabel.size() <= 120
            )
          )
          && (
            request.resource.data.vehicleId == null ||
            (
              request.resource.data.vehicleId is string
              && request.resource.data.vehicleId.size() > 0
              && request.resource.data.vehicleId.size() <= 128
            )
          )
          && (
            request.resource.data.locationLabel == null ||
            (
              request.resource.data.locationLabel is string
              && request.resource.data.locationLabel.size() <= 120
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isDeleted == false
          && request.resource.data.isArchived == false
          && request.resource.data.pinnedAt == null;
        allow update: if isOwner(userId)
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.ownerUserId == resource.data.ownerUserId
          && request.resource.data.imageUrl == resource.data.imageUrl
          && request.resource.data.imagePath == resource.data.imagePath
          && request.resource.data.get('mediaUrls', [])
            == resource.data.get('mediaUrls', [])
          && request.resource.data.get('mediaPaths', [])
            == resource.data.get('mediaPaths', [])
          && request.resource.data.get('mediaTypes', [])
            == resource.data.get('mediaTypes', [])
          && request.resource.data.section == resource.data.section
          && request.resource.data.get('vehicleId', null)
            == resource.data.get('vehicleId', null)
          && request.resource.data.isDeleted == resource.data.isDeleted
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.visibility in ['public', 'contacts', 'onlyMe']
          && request.resource.data.isArchived is bool
          && (
            request.resource.data.pinnedAt == null
            || request.resource.data.pinnedAt is timestamp
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caption',
            'locationLabel',
            'visibility',
            'isArchived',
            'pinnedAt',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId);

        match /likes/{likerUserId} {
          allow read: if isOwner(userId)
            || (
              hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.visibility in ['public', 'contacts']
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.isDeleted == false
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.get('isArchived', false) == false
            );
          allow create: if isSignedIn()
            && request.auth.uid == likerUserId
            && (
              isOwner(userId)
              || (
                hasActiveProfileConnection(userId)
                && profileAllowsAccess(userId)
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.visibility in ['public', 'contacts']
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.isDeleted == false
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.get('isArchived', false) == false
              )
            )
            && request.resource.data.userId == likerUserId
            && request.resource.data.postOwnerUserId == userId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 100
            && request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 1000
            && request.resource.data.createdAt is timestamp
            && request.resource.data.keys().hasOnly([
              'userId',
              'postOwnerUserId',
              'displayName',
              'photoUrl',
              'createdAt'
            ]);
          allow update: if false;
          allow delete: if isSignedIn() && request.auth.uid == likerUserId;
        }

        match /comments/{commentId} {
          allow read: if isOwner(userId)
            || (
              hasActiveProfileConnection(userId)
              && profileAllowsAccess(userId)
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.visibility in ['public', 'contacts']
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.isDeleted == false
              && get(
                /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
              ).data.get('isArchived', false) == false
            );
          allow create: if isSignedIn()
            && (
              isOwner(userId)
              || (
                hasActiveProfileConnection(userId)
                && profileAllowsAccess(userId)
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.visibility in ['public', 'contacts']
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.isDeleted == false
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.get('isArchived', false) == false
              )
            )
            && request.resource.data.commentId == commentId
            && request.resource.data.postId == postId
            && request.resource.data.postOwnerUserId == userId
            && request.resource.data.authorUserId == request.auth.uid
            && request.resource.data.authorDisplayName is string
            && request.resource.data.authorDisplayName.size() <= 100
            && request.resource.data.authorPhotoUrl is string
            && request.resource.data.authorPhotoUrl.size() <= 1000
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.isDeleted == false
            && request.resource.data.keys().hasOnly([
              'commentId',
              'postId',
              'postOwnerUserId',
              'authorUserId',
              'authorDisplayName',
              'authorPhotoUrl',
              'text',
              'createdAt',
              'updatedAt',
              'isDeleted'
            ]);
          allow update: if isSignedIn()
            && (
              request.auth.uid == resource.data.authorUserId
              || request.auth.uid == userId
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isDeleted',
              'updatedAt'
            ])
            && request.resource.data.isDeleted == true
            && request.resource.data.updatedAt is timestamp;
          allow delete: if false;

          match /replies/{replyId} {
            allow read: if isOwner(userId)
              || (
                hasActiveProfileConnection(userId)
                && profileAllowsAccess(userId)
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.visibility in ['public', 'contacts']
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.isDeleted == false
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.get('isArchived', false) == false
              );
            allow create: if isSignedIn()
              && (
                isOwner(userId)
                || (
                  hasActiveProfileConnection(userId)
                  && profileAllowsAccess(userId)
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.visibility in ['public', 'contacts']
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.isDeleted == false
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.get('isArchived', false) == false
                )
              )
              && request.resource.data.replyId == replyId
              && request.resource.data.commentId == commentId
              && request.resource.data.postId == postId
              && request.resource.data.postOwnerUserId == userId
              && request.resource.data.authorUserId == request.auth.uid
              && request.resource.data.authorDisplayName is string
              && request.resource.data.authorDisplayName.size() <= 100
              && request.resource.data.authorPhotoUrl is string
              && request.resource.data.authorPhotoUrl.size() <= 1000
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 500
              && request.resource.data.createdAt is timestamp
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.isDeleted == false
              && request.resource.data.keys().hasOnly([
                'replyId',
                'commentId',
                'postId',
                'postOwnerUserId',
                'authorUserId',
                'authorDisplayName',
                'authorPhotoUrl',
                'text',
                'createdAt',
                'updatedAt',
                'isDeleted'
              ]);
            allow update: if isSignedIn()
              && (
                request.auth.uid == resource.data.authorUserId
                || request.auth.uid == userId
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'isDeleted',
                'updatedAt'
              ])
              && request.resource.data.isDeleted == true
              && request.resource.data.updatedAt is timestamp;
            allow delete: if false;

            match /reports/{reporterUserId} {
              allow read: if false;
              allow create: if isSignedIn()
                && request.auth.uid == reporterUserId
                && (
                  isOwner(userId)
                  || (
                    hasActiveProfileConnection(userId)
                    && profileAllowsAccess(userId)
                    && get(
                      /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                    ).data.visibility in ['public', 'contacts']
                    && get(
                      /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                    ).data.isDeleted == false
                    && get(
                      /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                    ).data.get('isArchived', false) == false
                  )
                )
                && request.resource.data.reporterUserId == reporterUserId
                && request.resource.data.createdAt is timestamp
                && request.resource.data.keys().hasOnly([
                  'reporterUserId',
                  'createdAt'
                ]);
              allow update, delete: if false;
            }
          }

          match /reports/{reporterUserId} {
            allow read: if false;
            allow create: if isSignedIn()
              && request.auth.uid == reporterUserId
              && (
                isOwner(userId)
                || (
                  hasActiveProfileConnection(userId)
                  && profileAllowsAccess(userId)
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.visibility in ['public', 'contacts']
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.isDeleted == false
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.get('isArchived', false) == false
                )
              )
              && request.resource.data.reporterUserId == reporterUserId
              && request.resource.data.createdAt is timestamp
              && request.resource.data.keys().hasOnly([
                'reporterUserId',
                'createdAt'
              ]);
            allow update, delete: if false;
          }

          match /reactions/{reactingUserId} {
            allow read: if isOwner(userId)
              || (
                hasActiveProfileConnection(userId)
                && profileAllowsAccess(userId)
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.visibility in ['public', 'contacts']
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.isDeleted == false
                && get(
                  /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                ).data.get('isArchived', false) == false
              );
            allow create, update: if isSignedIn()
              && request.auth.uid == reactingUserId
              && (
                isOwner(userId)
                || (
                  hasActiveProfileConnection(userId)
                  && profileAllowsAccess(userId)
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.visibility in ['public', 'contacts']
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.isDeleted == false
                  && get(
                    /databases/$(database)/documents/users/$(userId)/social_posts/$(postId)
                  ).data.get('isArchived', false) == false
                )
              )
              && request.resource.data.userId == reactingUserId
              && request.resource.data.type in ['like', 'dislike', 'heart']
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.keys().hasOnly([
                'userId',
                'type',
                'updatedAt'
              ]);
            allow delete: if isSignedIn()
              && request.auth.uid == reactingUserId;
          }
        }
      }

      match /moderation_actions/{actionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isValidReportNotificationReadUpdate(userId);
        allow delete: if false;
      }

      match /sent_report_notifications/{reportId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update, delete: if false;
      }

      match /security_activities/{activityId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    match /account_deletions/{userId} {
      allow read, write: if false;
    }

    match /mfa_recovery_requests/{userId} {
      // Users receive their reduced status through getMfaRecoveryStatus.
      // Direct reads include internal approval metadata and stay admin-only.
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /audit/{auditId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /admin_claim_audit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /plates/{plateId} {
      // Public lookup goes through the server-side search/report functions so
      // exact location and internal plate metadata never reach other clients.
      allow get: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;

      allow list: if false;

      allow create, update, delete: if false;
    }

    match /contact_requests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.senderUserId == request.auth.uid ||
          resource.data.receiverUserId == request.auth.uid
        );

      allow create: if isValidContactRequestCreate(requestId);

      allow update: if isValidContactRequestUpdate(requestId);

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if request.resource.data.requestId is string
        && isValidChatCreateForRequest(chatId, request.resource.data.requestId);

      allow update: if isValidChatLastMessageUpdate()
        || isValidChatReadUpdate()
        || isValidChatTypingUpdate()
        || isValidChatPresenceUpdate()
        || isValidChatFavoriteUpdate()
        || isValidChatPinnedUpdate()
        || isValidChatMutedUpdate()
        || isValidChatArchiveUpdate()
        || isValidChatDeleteUpdate()
        || isValidChatBlockUpdate()
        || isValidChatUnblockUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isUndeletedChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );

        allow create: if isValidTextMessageCreate(chatId, messageId)
          || isValidLocationMessageCreate(chatId)
          || isValidContactMessageCreate(chatId)
          || isValidImageMessageCreate(chatId, messageId)
          || isValidDocumentMessageCreate(chatId, messageId)
          || isValidAudioMessageCreate(chatId, messageId)
          || isValidVideoMessageCreate(chatId, messageId);

        allow update: if isValidMessageStarUpdate(chatId)
          || isValidMessageDeleteUpdate(chatId)
          || isValidMessageDeleteForUserUpdate(chatId)
          || isValidMessageReactionUpdate(chatId)
          || isValidViewOnceMessageOpenUpdate(chatId);

        allow delete: if false;
      }
    }

    match /chat_stories/{storyId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.ownerUserId ||
          (
            request.auth.uid in resource.data.viewerUserIds
            && resource.data.isActive == true
            && resource.data.expiresAt > request.time
          )
        );

      allow create: if isValidStoryOwnerWrite(storyId)
        && request.resource.data.isActive == true;

      allow update: if (
          resource.data.ownerUserId == request.auth.uid
          && isValidStoryOwnerWrite(storyId)
          && request.resource.data.isActive == resource.data.isActive
        )
        || isValidStoryViewUpdate()
        || isValidStoryViewerPhotoUpdate();

      allow delete: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn()
        && reportId.matches('^chat_.+_' + request.auth.uid + '$');
      allow list, update, delete: if false;

      allow create: if isValidChatReportCreate(reportId);
    }

    match /report_rate_limits/{userId} {
      allow read, write: if false;
    }

    match /verification_requests/{requestId} {
      allow read: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == requestId
          );

      allow create: if isValidVerificationDraftCreate(requestId);
      allow update: if isValidTargetedVerificationResubmission(requestId)
        || isValidVerificationDraftUpdate(requestId);
      allow delete: if false;

      match /history/{historyId} {
        allow read: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == requestId
          );
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
